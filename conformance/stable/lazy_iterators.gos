use std::{iter, option}

fn main() {
    let empty_count = (0..0) |> iter::count
    println!("{empty_count}")

    let bounded = (7..) |> iter::take(3, $) |> iter::sum
    println!("{bounded}")

    let pulled = (1..100)
        |> iter::map(|x| {
            if x > 3 { panic("map pulled past take") }
            x
        }, $)
        |> iter::take(3, $)
        |> iter::collect
    println!("{}", pulled.sum())

    let skipped = (1..8) |> iter::skip(3, $) |> iter::take(2, $) |> iter::sum
    println!("{skipped}")

    let chained = iter::chain(1..3, 5..7) |> iter::sum
    println!("{chained}")

    let zipped = iter::zip(1..4, 10..20) |> iter::collect
    println!("{}", zipped.len())

    let any_hit = (1..100)
        |> iter::any(|x| {
            if x > 4 { panic("any was eager") }
            x == 3
        }, $)
    println!("{any_hit}")

    let all_hit = (1..100)
        |> iter::all(|x| {
            if x > 4 { panic("all was eager") }
            x < 3
        }, $)
    println!("{all_hit}")

    let found = (1..100)
        |> iter::find(|x| {
            if x > 5 { panic("find was eager") }
            x == 4
        }, $)
        |> option::unwrap_or(-1, $)
    println!("{found}")

    let borrowed = #[1, 2, 3, 4]
    let borrowed_total = borrowed
        |> iter::map(|x| x * 2, $)
        |> iter::filter(|x| x > 4, $)
        |> iter::take(2, $)
        |> iter::sum
    println!("{borrowed_total}")
}
