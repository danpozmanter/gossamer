// Aggregate iterator elements. Struct, tuple, String, and nested-sequence
// elements are wider than the one-word slot a scalar sequence uses, so every
// combinator has to keep them addressable rather than truncating them to a
// word.

struct Item {
    name: String,
    qty: i64,
}

fn main() {
    let items = #[
        Item { name: "bolt", qty: 4 },
        Item { name: "nut", qty: 9 },
        Item { name: "washer", qty: 2 },
    ]

    println!("total={}", items.map(|i| i.qty).sum())
    println!("names={}", items.map(|i| i.name).join(","))
    println!("first={}", items.map(|i| i.name)[0])

    match items.max_by_key(|i| i.qty) {
        Some(top) => println!("top={} {}", top.name, top.qty),
        None => println!("top=none"),
    }
    match items.min_by_key(|i| i.qty) {
        Some(low) => println!("low={} {}", low.name, low.qty),
        None => println!("low=none"),
    }

    let mut inventory = 0
    for item in items {
        inventory += item.qty * item.name.len()
    }
    println!("inventory={inventory}")

    let pairs = #[(1, "one"), (2, "two"), (3, "three")]
    for (n, word) in pairs {
        println!("{n}:{word}")
    }
    let mut keys = 0
    for p in pairs {
        keys += p.0
    }
    println!("keys={keys}")
    println!("words={}", pairs.map(|p| p.1).join("|"))

    let nested = #[#[1, 2], #[3], #[4, 5, 6]]
    let mut flat = 0
    for row in nested {
        flat += row.len()
    }
    println!("flat={flat}")

    let words = #["delta", "alpha", "charlie"]
    println!("long={}", words.filter(|w| w.len() > 5).count())
    println!("joined={}", words.map(|w| w.to_uppercase()).join("-"))
}
