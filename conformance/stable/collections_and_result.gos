fn first_even(values: Vec<i64>) -> Result<i64, String> {
    for value in values {
        if value % 2 == 0 {
            return Ok(value)
        }
    }
    Err("missing".to_string())
}

fn main() {
    let values: Vec<i64> = Vec::from([3, 5, 8, 13])
    match first_even(values) {
        Ok(value) => println!("even={}", value),
        Err(err) => println!("error={}", err),
    }
}
