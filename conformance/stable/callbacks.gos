use std::{math, strings}

fn increment(value: i64) -> i64 { value + 1 }

fn apply(f: Fn(i64) -> i64, value: i64) -> i64 {
    f(value)
}

fn main() {
    println!("callback={}", apply(increment, 41))
    println!("std_fn={:?}", #[1.0, -2.0].map(math::abs))
    println!("trimmed={:?}", #["  a  ", " b "].map(strings::trim))
    println!("method={:?}", #[1.0, -2.0].map($.abs))
    println!("upper={:?}", #["hi", "yo"].map($.to_uppercase))
    println!("len={:?}", #["ab", "cde"].map($.len()))
    println!("tuple={:?}", #[(1, 2), (3, 4)].map($.0))
    println!("piped={:?}", #[4.0, 9.0] |> $.map($.sqrt))
}
