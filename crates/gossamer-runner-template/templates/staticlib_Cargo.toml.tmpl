# generated by gos build -- fingerprint {{ fingerprint_hex }}
# DO NOT EDIT. Regenerated when `[rust-bindings]` changes.
[package]
name = "gos-static-{{ fingerprint_hex }}"
version = "0.0.0"
edition = "2024"
publish = false

# Stand alone as a workspace root. The staticlib build dir is generated
# inside the gossamer cache, which can itself sit under an unrelated
# Cargo workspace; an empty table keeps that ancestor from absorbing
# this crate (cargo would otherwise reject it as a non-member) and
# anchors the `[patch]` block below.
[workspace]

[lib]
name = "gos_static_bindings"
crate-type = ["staticlib"]
path = "lib.rs"

[profile.release]
opt-level = 3
lto = "thin"
panic = "abort"

[profile.dev]
opt-level = 0
debug = true
panic = "abort"

[dependencies]
gossamer-binding = { path = '{{ gossamer_root }}/crates/gossamer-binding' }
# time 0.3.48 breaks cookie 0.18.1 (E0119: conflicting From impls with
# cookie's blanket Expiration conversion). Pin until cookie ships a fix;
# fresh-resolving generated workspaces hit it without this.
time = "=0.3.47"
{{#each bindings}}
{{ this.cargo_dep_line }}
{{/each}}
{{ gossamer_patch }}
