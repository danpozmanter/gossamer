use std::encoding::json

fn main() {
    let v = json::parse(&"{\"a\":1,\"b\":2}".to_string()).unwrap()
    let keys = json::keys(&v).unwrap()
    let n = keys.len() as i64
    println!("keys.len = {}", n)
    let mut i: i64 = 0
    while i < n {
        println!("k[{}] = {}", i, keys[i])
        i += 1
    }
    let vals = json::values(&v).unwrap()
    let m = vals.len() as i64
    println!("vals.len = {}", m)
    let mut j: i64 = 0
    while j < m {
        let item = vals[j]
        println!("v[{}] = {}", j, json::as_i64(&item).unwrap_or(-1))
        j += 1
    }
    // Non-object → None
    let s = json::parse(&"\"hi\"".to_string()).unwrap()
    match json::keys(&s) {
        Some(_) => println!("BAD"),
        None => println!("string has no keys: ok"),
    }
}
