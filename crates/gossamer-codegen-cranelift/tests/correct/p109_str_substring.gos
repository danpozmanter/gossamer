fn main() {
    let s = "hello world".to_string()
    let a = s.substring(0, 5)
    let b = s.substring(6, 11)
    let c = s.substring(2, 8)
    let d = s.substring(-3, 4)  // negative start clamps to 0
    let e = s.substring(0, 999) // overrun clamps to len
    let f = s.substring(5, 5)   // empty
    println!("a={} b={} c={} d={} e={} f=[{}]", a, b, c, d, e, f)
}
