use std::encoding::json

// Regression: chaining .as_str()/.as_i64() directly on json::get() used to
// segfault in compiled mode because json_borrow received *mut GosResult
// (disc+payload) instead of *const GosJson and read disc=0 as a null Arc.
fn main() {
    let v = json::parse("{\"name\":\"alice\",\"age\":30}").unwrap()
    let name = match json::get(v, "name") {
        Some(n) => json::as_str(n).unwrap_or("?")
        None => "?"
    }
    let age = match json::get(v, "age") {
        Some(a) => json::as_i64(a).unwrap_or(-1)
        None => -1
    }
    println("name={} age={}", name, age)
    let missing = match json::get(v, "missing") {
        Some(m) => json::as_str(m).unwrap_or("?")
        None => "none"
    }
    println("missing={}", missing)
}
