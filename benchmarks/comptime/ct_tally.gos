// Collection churn inside a fold: 500k `Map::inc` calls plus a walk
// over the resulting keys.
comptime fn tally(n: i64) -> i64 {
    let mut m = {}
    let mut i = 0
    while i < n { m.inc(i % 1000); i += 1 }
    let mut total = 0
    for k in m.keys() { total += m.get_or(k, 0) }
    total
}

const TALLY: i64 = tally(500000)

fn main() { println("{}", TALLY) }
