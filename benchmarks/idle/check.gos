// Asserts the runtime stays mostly asleep when user code does nothing.
//
// Usage: gos run benchmarks/idle/check.gos
//
// Boots `gos run empty.gos`, which calls `time::sleep(2000)`. The
// acceptance threshold is the total user+system CPU consumed during
// those two wall-clock seconds, read from `/usr/bin/time`, which
// observes the child from outside it.
//
// Threshold rationale: 200 ms locally - single-digit ms is what the
// runtime actually spends. CI's hosted runners jitter, so the gate is
// 400 ms to absorb that without losing the regression signal (a return
// to busy-poll would burn 1500 ms+).
//
// `/usr/bin/time` reports hundredths of a second, so a reading is
// quantised to 10 ms. That is two orders of magnitude finer than the
// gate needs, and it comes from outside the process being measured,
// which is what a CPU number about the runtime has to be.
//
// The toolchain under test is `GOS` (or the release build). The
// interpreter running this harness is chosen by whoever invokes it -
// CI uses `GOS_HARNESS_BIN`.

use std::{env, fs, path, process}

/// Where the CPU accounting comes from: the child is measured from
/// outside, so the harness's own cost is never in the number.
const TIME_BINARY: String = "/usr/bin/time"

/// The checkout this harness lives in.
fn repo_root() -> String {
    let mut directory = env::current_dir().unwrap_or(".")
    loop {
        if fs::is_file(&path::join(&directory, &"benchmarks/idle/empty.gos")) {
            return directory
        }
        match path::parent(&directory) {
            Some(parent) => directory = parent
            None => return "."
        }
    }
}

/// Milliseconds named by a `<seconds>.<hundredths>` reading.
fn millis_of(seconds: &String) -> Option<i64> {
    let (whole, fraction) = seconds.split_once(".").unwrap_or((*seconds, "0"))
    let whole_ms = whole.to_i64()? * 1000
    let mut scaled = fraction
    while scaled.len() < 3 {
        scaled = format!("{}0", scaled)
    }
    Some(whole_ms + scaled.substring(0, 3).to_i64().unwrap_or(0))
}

fn main() {
    let root = repo_root()
    let gos = env::var(&"GOS").unwrap_or(path::join(&root, &"target/release/gos"))
    let threshold_ms = env::var(&"IDLE_CPU_THRESHOLD_MS").unwrap_or("400").to_i64().unwrap_or(400)
    if !fs::is_file(&gos) {
        eprintln!("error: gos binary not found at {} - set GOS or build first", gos)
        process::exit(2)
    }
    if !fs::is_file(&TIME_BINARY) {
        eprintln!("error: {} is required to measure the child's CPU", TIME_BINARY)
        process::exit(2)
    }

    let program = path::join(&root, &"benchmarks/idle/empty.gos")
    let arguments = #["-f", "%U %S", gos, "run", program]
    let measured = match process::run(&TIME_BINARY, &arguments) {
        Ok(measured) => measured
        Err(e) => {
            eprintln!("error: idle benchmark command failed: {}", e)
            process::exit(2)
        }
    }
    if measured.code != 0 {
        eprintln!(
            "error: idle benchmark command failed with status {}:\n{}"
            measured.code
            measured.stderr
        )
        process::exit(measured.code)
    }

    // `/usr/bin/time` writes the format string as its own last line,
    // after whatever the child put on standard error.
    let reading = measured.stderr.trim().lines().last().unwrap_or("")
    let fields = reading.split_whitespace()
    if fields.len() != 2 {
        eprintln!("error: could not parse the CPU reading:\n{}", measured.stderr)
        process::exit(2)
    }
    let user = fields[0]
    let system = fields[1]
    let (Some(user_ms), Some(system_ms)) = (millis_of(&user), millis_of(&system)) else {
        eprintln!("error: could not parse the CPU reading:\n{}", measured.stderr)
        process::exit(2)
    }
    let total_ms = user_ms + system_ms

    println!(
        "idle empty.gos: user={}s sys={}s total={}ms (threshold={}ms)"
        user
        system
        total_ms
        threshold_ms
    )
    if total_ms > threshold_ms {
        eprintln!("FAIL: idle CPU above threshold - runtime is busy-polling somewhere")
        process::exit(1)
    }
    println!("ok")
}
