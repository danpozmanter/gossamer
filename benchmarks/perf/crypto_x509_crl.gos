fn bench_crls_pem() -> String {
    "-----BEGIN X509 CRL-----\nMIHUMHsCAQEwCgYIKoZIzj0EAwIwGzEZMBcGA1UEAwwQY3J5cHRvIHRlc3Qgcm9v\ndBcNMjUwMTAxMDAwMDAwWhcNMzAwMTAxMDAwMDAwWqAvMC0wHwYDVR0jBBgwFoAU\nyRSF1RpMVp22067e/2xul98c86gwCgYDVR0UBAMCAQEwCgYIKoZIzj0EAwIDSQAw\nRgIhAOLO2y5+baw5caN2x7stfgxGGqVv34W6GzxL/d1V5ZtNAiEAzwXCKP6w6mXK\noejU788iF1je6sQPY6uhIwgP/59imhg=\n-----END X509 CRL-----\n-----BEGIN X509 CRL-----\nMIIBADCBqAIBATAKBggqhkjOPQQDAjAjMSEwHwYDVQQDDBhjcnlwdG8gdGVzdCBp\nbnRlcm1lZGlhdGUXDTI1MDEwMTAwMDAwMFoXDTMwMDEwMTAxMDAwMFowIzAhAgIA\nyBcNMjUwMTAxMDAwMDAwWjAMMAoGA1UdFQQDCgEBoC8wLTAfBgNVHSMEGDAWgBT5\nHMoqd+NMR6hHynaThUW13l9nlDAKBgNVHRQEAwIBAjAKBggqhkjOPQQDAgNHADBE\nAiBcDH4UnAQNiGL0hST+wpqP3pY3Afwk1AMUIsV5qZ2XUQIgPfrXrDLzKCF2xeC2\noGiTR8PZzpp14em1fTVIrQgjVvE=\n-----END X509 CRL-----\n"
}

#[bench]
fn bench_crypto_x509_crl_verify_observed() -> i64 {
    match crypto::x509::verify_server_certificate_with_crls(
        bench_chain_pem()
        bench_roots_pem()
        "localhost"
        bench_crls_pem()
    ) {
        Ok(_) => 1
        Err(_) => 0
    }
}

fn main() { }
