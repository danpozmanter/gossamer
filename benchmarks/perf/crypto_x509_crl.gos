    "-----BEGIN CERTIFICATE-----\nMIIBnDCCAUKgAwIBAgIUUjes3rQ0tQrt7xhFw+rkmqLGurUwCgYIKoZIzj0EAwIw\nGzEZMBcGA1UEAwwQY3J5cHRvIHRlc3Qgcm9vdDAgFw03NTAxMDEwMDAwMDBaGA80\nMDk2MDEwMTAwMDAwMFowGzEZMBcGA1UEAwwQY3J5cHRvIHRlc3Qgcm9vdDBZMBMG\nByqGSM49AgEGCCqGSM49AwEHA0IABFAzP4WCcjI/hDIrccuUMD2ueuQCenQozwcl\nfFhYX7+o3Z+uunykzlZYmL96LeuRqYuxQL8snf27+deMNu+aIGKjYjBgMB4GA1Ud\nEQQXMBWCE2NyeXB0by1yb290LmludmFsaWQwDgYDVR0PAQH/BAQDAgEGMB0GA1Ud\nDgQWBBTJFIXVGkxWnbbTrt7/bG6X3xzzqDAPBgNVHRMBAf8EBTADAQH/MAoGCCqG\nSM49BAMCA0gAMEUCIQClkuDJfuh812DNQ5cIYE16A0MjrmYeBd5g+LgtXusG6QIg\nUbIXdeJy4R9fWCIZ5KGNqO8d6KqlNNQmOEYQWcCm8gE=\n-----END CERTIFICATE-----\n"
