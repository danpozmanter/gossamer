use std::iter

fn main() {
    let lazy = iter::range(0, 100000)
        |> iter::map(|x| x + 1)
        |> iter::filter(|x| x % 2 == 0)
        |> iter::take(1000)
        |> iter::sum

    let eager = iter::range(0, 100000)
        |> iter::collect
        |> $.map(|x| x + 1)
        |> $.filter(|x| x % 2 == 0)
        |> $.take(1000)
        |> $.sum

    println!("{lazy} {eager}")
}
