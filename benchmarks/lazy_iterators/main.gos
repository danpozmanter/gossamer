use std::iter

fn main() {
    let lazy = (0..100000)
        |> |v| iter::map(v, |x| x + 1)
        |> |v| iter::filter(v, |x| x % 2 == 0)
        |> |v| iter::take(v, 1000)
        |> iter::sum

    let eager = (0..100000)
        .collect()
        .map(|x| x + 1)
        .filter(|x| x % 2 == 0)
        .take(1000)
        .sum()

    println("{lazy} {eager}")
}
