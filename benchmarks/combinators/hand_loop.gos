// The same fold written as a loop: no boundary, no callback, and the
// floor the combinator forms are read against.
use std::env

fn main() {
    let n = env::args().first().unwrap_or("20000000").to_i64().unwrap_or(20000000)
    let mut xs = #[]
    let mut i = 0
    while i < n { xs.push(i % 7); i += 1 }
    let mut total = 0
    for v in xs { total += v }
    println("{}", total)
}
