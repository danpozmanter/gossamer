// Bundled load harness for the joint Track A + B validation.
//
// Spawns N goroutines, each cycling GET /notes + POST /notes
// against the local web_service_full endpoint for `duration`
// seconds. Reports total requests, error count, and the
// scheduler's snapshot at exit.
//
// Drives load through the same goroutine-aware HTTP client the
// service composes against, so the netpoller is exercised on
// both sides of the wire.

use std::env
use std::flag
use std::http
use std::runtime
use std::sync
use std::time

fn worker(
    target: String
    stop_at: i64
    total: sync::AtomicU64
    errors: sync::AtomicU64
    wg: sync::WaitGroup
) {
    let body = "{\"body\":\"hello\"}"
    while time::now_ms() < stop_at {
        match http::get(target, #[]) {
            Ok(_) => total.fetch_add(1)
            Err(_) => errors.fetch_add(1)
        }
        match http::post(target, body, "application/json") {
            Ok(_) => total.fetch_add(1)
            Err(_) => errors.fetch_add(1)
        }
    }
    wg.done()
}

fn main() {
    let mut fs = flag::Set::new("harness")
    let port = fs.int("port", 8443, "service port")
    let connections = fs.int("connections", 1000, "concurrent goroutines")
    let duration = fs.int("duration", 60, "seconds to run")
    let _ = fs.parse(env::args())

    let target = format("http://127.0.0.1:{}/notes", port)

    let wg = sync::WaitGroup::new()
    let total = sync::AtomicU64::new(0)
    let errors = sync::AtomicU64::new(0)

    let stop_at = time::now_ms() + time::Duration::from_secs(duration).as_millis()

    for _ in 0..connections {
        wg.add(1)
        spawn(|| worker(target, stop_at, total, errors, wg))
    }

    wg.wait()

    println(
        "[harness] total_requests={} errors={}"
        total.load()
        errors.load()
    )
    println("[harness] scheduler={}", runtime::scheduler_stats_json())
}
