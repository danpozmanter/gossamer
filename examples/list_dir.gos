/*
 * Directory listing - reads entries and prints an aligned table.
 *
 * Column alignment uses format-spec width + fill (`{:<4}` left,
 * `{:>14}` right) rather than hand-rolled padding helpers.
 *
 * Run:
 *     gos run examples/list_dir.gos -- examples
 */

use std::env
use std::errors
use std::fs
use std::time

fn kind_tag(entry: &fs::DirInfo) -> String {
    if entry.is_symlink {
        "l"
    } else if entry.is_dir {
        "d"
    } else if entry.is_file {
        "f"
    } else {
        "?"
    }
}

// Renders a non-negative integer with thousands separators.
fn comma_size(n: i64) -> String {
    if n == 0 {
        return "0"
    }
    let mut out = ""
    let mut value = n
    let mut digits_since_comma = 0
    while value > 0 {
        if digits_since_comma == 3 {
            out = "," + &out
            digits_since_comma = 0
        }
        out = format!("{}", value % 10) + &out
        value /= 10
        digits_since_comma += 1
    }
    out
}

fn render_modified(unix_ms: i64) -> String {
    if unix_ms <= 0 {
        return ""
    }
    match time::format_rfc3339(unix_ms) {
        Ok(s) => s,
        Err(_) => "",
    }
}

fn main() -> Result<(), errors::Error> {
    let args = env::args()
    let target = if args.is_empty() { "." } else { args[0].clone() }

    let entries = fs::list_dir(&target)
        .map_err(|e| errors::newf("list_dir {}: {}", target, e))?

    println!("listing of {}", target)
    println!("{:<4} {:>14} {:<22} name", "kind", "size", "modified")

    let mut files = 0
    let mut dirs = 0
    let mut total_bytes = 0
    for i in 0..entries.len() {
        let entry = &entries[i]
        println!("{:<4} {:>14} {:<22} {}",
            kind_tag(entry), comma_size(entry.size), render_modified(entry.modified_ms), entry.name)
        if entry.is_dir {
            dirs += 1
        } else if entry.is_file {
            files += 1
            total_bytes += entry.size
        }
    }

    println!("---")
    println!("{} file(s), {} dir(s), {} bytes total in regular files",
        files, dirs, comma_size(total_bytes))
    Ok(())
}
