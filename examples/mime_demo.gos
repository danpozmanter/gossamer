/*
 * Media type parsing and extension lookup with `std::mime`.
 *
 * RFC 2045 type/subtype + parameters (charset, boundary, etc.) plus
 * filename-extension <-> media-type tables backed by IANA registries.
 */

use std::mime

let html = "text/html; charset=utf-8"
println!("parsed: {}", mime::parse(&html))
println!("top: {}", mime::top(&html))
println!("sub: {}", mime::sub(&html))
println!("charset: {}", mime::charset(&html))

let multi = "multipart/form-data; boundary=----abc123"
println!("multi boundary: {}", mime::boundary(&multi))

println!("ext for text/html: {}", mime::extension_by_type("text/html"))
println!("type for .png: {}", mime::type_by_extension(".png"))
println!("type for json: {}", mime::type_by_extension("json"))

println!("valid: {}", mime::is_valid("application/json"))
println!("invalid: {}", mime::is_valid("nope"))
