/*
 * Sequence containers - queue (FIFO), stack (LIFO), deque (both-ends).
 *
 * Operations re-bind the underlying Vec<i64>. Use reassignment
 * (`q = queue::push(q, v)`) rather than `let q = ...` shadowing
 * so the binding stays alive across the call.
 */

use std::collections::queue
use std::collections::stack
use std::collections::deque

fn main() {
    let mut q: [i64] = []
    q = queue::push(q, 1)
    q = queue::push(q, 2)
    q = queue::push(q, 3)
    println!("queue front: {}", queue::peek(&q))
    q = queue::pop(q)
    println!("after pop, front: {}", queue::peek(&q))
    println!("queue len: {}", queue::len(&q))

    let mut s: [i64] = []
    s = stack::push(s, 10)
    s = stack::push(s, 20)
    s = stack::push(s, 30)
    println!("stack top: {}", stack::peek(&s))
    s = stack::pop(s)
    println!("after pop, top: {}", stack::peek(&s))

    let mut d: [i64] = []
    d = deque::push_back(d, 2)
    d = deque::push_front(d, 1)
    d = deque::push_back(d, 3)
    println!("deque front: {}", deque::peek_front(&d))
    println!("deque back: {}", deque::peek_back(&d))
    d = deque::pop_front(d)
    println!("after pop_front, front: {}", deque::peek_front(&d))
}
