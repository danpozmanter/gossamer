/*
 * Forward-pipe operator `|>` and the F#-style combinator surface.
 *
 * `x |> f` desugars to `f(x)`; `x |> f(a, b)` desugars to
 * `f(a, b, x)` (the piped value lands in the *last* positional
 * slot). `x |> recv.m(a)` pipes into an external receiver's last
 * argument: `recv.m(a, x)`. The `_` placeholder instead makes the
 * piped value the *receiver*: `x |> _.m(a)` is `x.m(a)`, and bare
 * `x |> _.trim` is `x.trim()`. `|>` is left-associative with very
 * low precedence, so `a |> f |> g` reads as `g(f(a))` without
 * parentheses.
 *
 * Combinator surfaces in `std::iter` / `std::option` / `std::result`
 * (SPEC §10.4-§10.4b) keep transformation pipelines at the
 * expression level instead of dropping to procedural `for` loops.
 * Argument order across the surface is data-last, so every helper
 * threads through `|>` without an explicit placeholder.
 */

use std::iter
use std::option

fn double(x: i64) -> i64 { x * 2 }

fn add(a: i64, b: i64) -> i64 { a + b }

fn clamp(lo: i64, hi: i64, x: i64) -> i64 {
    if x < lo { lo } else if x > hi { hi } else { x }
}

fn split_words(s: String) -> [String] {
    s.trim().to_lower().split(" ")
}

fn main() {
    // Arithmetic chain: 3 -> double -> add 10 -> clamp to [0, 100].
    let n = 3 |> double |> add(10) |> clamp(0, 100)
    println!("arithmetic: {n}")

    // Equivalent nested form (what `|>` desugars to):
    let same = clamp(0, 100, add(10, double(3)))
    println!("nested: {same}")

    // `_.method` pipes the value through its own methods - `_` is the
    // receiver of the step, so `_.trim` is `x.trim()`.
    let shout = "  hello  " |> _.trim |> _.to_upper
    println!("shout: {shout}")

    // Word count, top-down: split on whitespace, drop empties, count.
    let words = "  Hello  World  "
        |> split_words
        |> iter::filter(|w: String| w.len() > 0)
        |> iter::count
    println!("words: {words}")

    // Sum of squares of evens in 1..=10 - one expression, no `let mut`.
    let total = iter::range_inclusive(1, 10)
        |> iter::filter(|n: i64| n % 2 == 0)
        |> iter::sum_by(|n: i64| n * n)
    println!("sum of even squares: {total}")

    // Pipeline through Option: first match, fall back to a default.
    let xs = [1, 3, 5, 9, 14, 21]
    let first_big = xs
        |> iter::find(|n: i64| n > 10)
        |> option::default(-1)
    println!("first > 10 (or -1): {first_big}")

    // Filter twice - `iter::count` reports each subset's size.
    let evens = xs |> iter::filter(|n: i64| n % 2 == 0)
    let odds = xs |> iter::filter(|n: i64| n % 2 != 0)
    println!("evens: {}, odds: {}", evens |> iter::count, odds |> iter::count)
}
