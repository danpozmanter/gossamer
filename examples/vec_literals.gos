// Bracket literals build Vec values by default. Use `#[...]` when an
// explicit fixed array is required, or let a `[T; N]` expected type shape
// a plain bracket literal.

struct Basket { fruits: Vec<String> }

// A literal in return position becomes the declared `Vec<T>`.
fn greetings() -> Vec<String> {
    ["hello", "hi", "hey"]
}

// Branches of differing length join to a `Vec<T>`.
fn scores(high: bool) -> Vec<i64> {
    if high { [90, 95, 100] } else { [60] }
}

// A `Vec<T>` parameter accepts a bare literal at the call site.
fn total(values: Vec<i64>) -> i64 {
    values.sum()
}

// A `&[T]` slice parameter accepts one too.
fn count(items: &[String]) -> i64 {
    items.len()
}

fn main() {
    // List form and the `[value; count]` repeat form.
    let names = ["ada", "grace", "edsger"]
    let zeros = [0; 5]

    println!("first name: {}", names[0])
    println!("zeros: {} entries, last = {}", zeros.len(), zeros[4])

    // Return position.
    let hellos = greetings()
    println!("greetings: {}", hellos.len())
    println!("scores(true) has {} entries", scores(true).len())

    // Struct field.
    let basket = Basket { fruits: ["apple", "pear"] }
    println!("basket holds {} and {}", basket.fruits[0], basket.fruits[1])

    // Arguments.
    println!("total = {}", total([3, 4, 5]))
    println!("count = {}", count(&["x", "y", "z"]))

    // Nested literals build a Vec of Vecs.
    let grid = [
        [1, 2, 3],
        [4, 5],
        [6]
    ]
    println!("grid rows = {}, grid[0][2] = {}", grid.len(), grid[0][2])

    // Fixed arrays are still available.
    let fixed = #[1, 2, 3]
    let shaped: [i64; 2] = [4, 5]
    println!("fixed = {}, shaped = {}", fixed.len(), shaped.len())
}
