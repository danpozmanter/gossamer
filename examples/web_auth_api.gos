// Canonical authenticated JSON API: the three pieces a real service
// wires together - a path-parameter router, a bearer-token auth
// check, and signed session cookies.
//
//   POST /login        issues a signed session cookie (session::sign)
//   GET  /orders/{id}  bearer-protected; reads a *typed* path param
//                      (r.path_int) and returns the order as JSON
//
// Self-terminating: a server goroutine plus a client in `main` that
// exits explicitly, so the whole run is a plain stdout comparison.
// Signing is deterministic (no nonce), the router matches Rust-side,
// and the 401/200 shaping is plain Gossamer - so the output is
// bit-identical under `gos` (bytecode VM) and `gos build` (LLVM
// AOT). Binds a fixed loopback port (serialized in CI).

use std::http
use std::http::middleware
use std::http::router
use std::process
use std::time

// POST /login - frame the posted user as a signed session cookie.
fn login(r: http::Request) -> http::Response {
    let payload = format!("{{\"user\":\"{}\"}}", r.body)
    http::Response::text(200, http::session::sign(payload, Vec::from([9, 8, 7, 6, 5, 4, 3, 2])))
}

// GET /orders/{id} - bearer-gated, with a typed path parameter.
fn get_order(r: http::Request) -> http::Response {
    if !middleware::bearer_ok(&r, |tok| tok == "s3cret-token") {
        return http::Response::text(401, "unauthorized")
    }
    match r.path_int("id") {
        Some(id) => http::Response::json(200, format!("{{\"order\":{}}}", id))
        None => http::Response::text(400, "bad order id")
    }
}

fn serve() {
    let r = router::Router::new()
        |> _.post("/login", login)
        |> _.get("/orders/{id}", get_order)
    if let Err(e) = http::serve("127.0.0.1:23892", r) {
        eprintln!("serve failed: {e}")
    }
}

// Binding is asynchronous; readiness is observable only by connecting.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go serve()
    await_ready(&"http://127.0.0.1:23892/orders/0")

    // 1) Log in, then verify the returned cookie round-trips locally.
    match http::request("POST", "http://127.0.0.1:23892/login", "ada", Vec::from([])) {
        Ok(r) => match http::session::verify(r.body, Vec::from([9, 8, 7, 6, 5, 4, 3, 2])) {
            Ok(data) => println!("login session={}", data)
            Err(_) => println!("login verify failed")
        },
        Err(e) => println!("login error: {}", e)
    }

    // 2) Authorized request with a typed path parameter.
    let auth: Vec<(String, String)> = Vec::from([("Authorization", "Bearer s3cret-token")])
    match http::request("GET", "http://127.0.0.1:23892/orders/42", "", auth) {
        Ok(r) => println!("order status={} body={}", r.status, r.body)
        Err(e) => println!("order error: {}", e)
    }

    // 3) Missing token → 401.
    match http::get("http://127.0.0.1:23892/orders/42", Vec::from([])) {
        Ok(r) => println!("noauth status={}", r.status)
        Err(e) => println!("noauth error: {}", e)
    }

    process::exit(0)
}
