/*
 * Min-heap (priority queue) with `std::collections::heap`.
 *
 * Operations re-bind: `let h = heap::push(h, v)`. To drain in
 * sorted order, peek the root, do the work, then pop.
 */

use std::collections::heap

fn main() {
    let h: Vec<i64> = #[]
    let h = heap::push(h, 5)
    let h = heap::push(h, 1)
    let h = heap::push(h, 3)
    let h = heap::push(h, 2)
    let h = heap::push(h, 4)

    println!("len: {}", heap::len(&h))
    println!("min: {}", heap::peek(&h))

    let mut cur = h
    while heap::len(&cur) > 0 {
        let v = heap::peek(&cur)
        println!("pop: {}", v)
        cur = heap::pop(cur)
    }

    println!("drained: {}", heap::len(&cur))
}
