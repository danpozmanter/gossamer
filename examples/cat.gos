/*
 * cat - concatenate files to stdout.
 *
 * Demonstrates grouped `use`, `Result` + `|>` pipeline style,
 * `result::map` for the ok-path, `result::unwrap_or_else` to
 * handle errors in the pipe, and `{name}` named-capture.
 *
 * Run:
 *     gos run examples/cat.gos examples/cat.gos
 */

use std::{env, errors, fs, iter, result}

fn cat(f: &String) -> Result<(), errors::Error> {
    fs::read_to_string(f) |> |v| result::map(|s| print!("{}", s), v)
}

env::args() |> |v| iter::for_each(|f| cat(&f) |> |v| result::unwrap_or_else(|e| eprintln!("{f}: {e}"), v), v)
