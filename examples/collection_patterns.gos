use std::collections::{Deque, Queue, Stack}
fn main() {
    // FIFO queue: push at the back, pop from the front.
    let mut queue: Queue<i64> = Queue::from([10])
    queue.push(20)
    println(queue.len())
    println(queue.peek())
    println(queue.pop())

    // Deque: both ends are active.
    let mut deque: Deque<i64> = Deque::from([2])
    deque.push_front(1)
    println(deque.peek_front())
    println(deque.pop_back())

    // LIFO stack: push and pop at the top.
    let mut stack: Stack<i64> = Stack::from([7])
    stack.push(7)
    stack.push(8)
    println(stack.len())
    println(stack.peek())
    println(stack.pop())

    // Min heap: smallest value first.
    let mut min_heap = MinHeap::from([5, 1, 3])
    min_heap.push(0)
    println(min_heap.pop())

    // Max heap: largest value first.
    let mut max_heap = MaxHeap::from([5, 1, 3])
    max_heap.push(8)
    println(max_heap.pop())
}
