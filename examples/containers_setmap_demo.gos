/*
 * Sorted set + map containers backed by Vec<i64>.
 *
 * Re-bind shape: `let s = ordered_set::insert(s, v)`.
 */

use std::collections::ordered_set
use std::collections::ordered_map

fn main() {
    let s: Vec<i64> = #[]
    let s = ordered_set::insert(s, 3)
    let s = ordered_set::insert(s, 1)
    let s = ordered_set::insert(s, 2)
    let s = ordered_set::insert(s, 1)
    println!("oset len: {}", ordered_set::len(&s))
    println!("oset contains 2: {}", ordered_set::contains(&s, 2))
    println!("oset contains 99: {}", ordered_set::contains(&s, 99))
    let s = ordered_set::remove(s, 2)
    println!("after remove 2, len: {}", ordered_set::len(&s))

    let m: Vec<i64> = #[]
    let m = ordered_map::insert(m, 10, 100)
    let m = ordered_map::insert(m, 5, 50)
    let m = ordered_map::insert(m, 7, 70)
    let _ = ordered_map::len(&m)
    println!("omap get 7: {:?}", ordered_map::get(&m, 7))
    println!("omap contains 5: {}", ordered_map::contains_key(&m, 5))
    let m = ordered_map::insert(m, 7, 700)
    println!("after reset 7, get: {:?}", ordered_map::get(&m, 7))
    let m = ordered_map::remove(m, 5)
    let _ = ordered_map::len(&m)
    println!("after remove 5: checked")
}
