/*
 * Sorted-on-insert container — `ordered_vec`. The earlier
 * `list` / `ordered_list` variants were removed because they
 * duplicated Vec / ordered_vec behaviour without adding anything.
 */

use std::collections::ordered_vec

fn main() {
    let mut v: [i64] = []
    let v = ordered_vec::insert(v, 3)
    let v = ordered_vec::insert(v, 1)
    let v = ordered_vec::insert(v, 4)
    let v = ordered_vec::insert(v, 1)
    let v = ordered_vec::insert(v, 5)
    println!("ovec min: {}", ordered_vec::peek_min(&v))
    println!("ovec max: {}", ordered_vec::peek_max(&v))
    println!("ovec len: {}", ordered_vec::len(&v))
    println!("contains 4: {}", ordered_vec::contains(&v, 4))
    println!("contains 99: {}", ordered_vec::contains(&v, 99))
}
