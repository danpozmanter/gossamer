struct Config { port: i64, host: String, active: bool }

fn main() {
    let c = Config(8080, "localhost", true)
    let s = to_json::<Config>(c)?
    println!("encoded: {}", s)

    let c2 = from_json::<Config>(&s)?
    println!("port: {}", c2.port)
    println!("host: {}", c2.host)
    println!("active: {}", c2.active)
}
