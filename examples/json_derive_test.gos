struct Config { port: i64, host: String, active: bool }

fn main() {
    let c = Config { port: 8080, host: "localhost", active: true }
    let s = c.to_json()?
    println!("encoded: {}", s)

    let c2 = Config::from_json(&s)?
    println!("port: {}", c2.port)
    println!("host: {}", c2.host)
    println!("active: {}", c2.active)
}
