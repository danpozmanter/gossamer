/*
 * TOML 1.0 with `std::encoding::toml`.
 *
 * The cross-tier surface is text-shaped: TOML <-> JSON conversion
 * plus `is_valid` and `pretty`. Round-trip into a typed value via
 * the JSON auto-derive (`from_json::<Type>(json_text)`).
 */

use std::encoding::toml

fn main() {
    let config = "port = 8080\nhost = \"localhost\"\nverbose = true\n"

    println!("valid: {}", toml::is_valid(&config))
    println!("invalid: {}", toml::is_valid("port == 8080"))

    let json = toml::to_json(&config)?
    println!("as json contains port: {}", json.contains("\"port\":8080"))
    println!("as json contains host: {}", json.contains("\"host\":\"localhost\""))

    let roundtrip = toml::from_json(&json)?
    println!("rt contains port = 8080: {}", roundtrip.contains("port = 8080"))

    let pp = toml::pretty(&config)?
    println!("pretty contains host: {}", pp.contains("host"))
}
