/*
 * Positional construction can copy selected fields from an existing struct
 * while changing another field. The base stays usable afterward because its
 * heap fields are shared and retained, not moved.
 */

struct Config {
    host: String,
    port: i64,
    verbose: bool,
}

fn main() {
    let base = Config("localhost", 8080, false)

    // Override one scalar field; host is copied from base.
    let prod = Config(base.host, 443, base.verbose)

    let remote = Config("example.com", base.port, base.verbose)

    println!("base:   {} {} {}", base.host, base.port, base.verbose)
    println!("prod:   {} {} {}", prod.host, prod.port, prod.verbose)
    println!("remote: {} {} {}", remote.host, remote.port, remote.verbose)
}
