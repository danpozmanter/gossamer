// Cross-tier fixture for `std::net` Unix-domain sockets: a self-
// terminating echo over an AF_UNIX stream socket. Mirrors
// `net_tcp_echo.gos` - the server lives in `main` (its handles stay in
// one frame); the client runs on a goroutine that connects, sends 4
// bytes, reads the echo, verifies the round-trip, and reports a single
// status code over a channel.
//
// Bytes (not a String) are written on both sides so the single
// `gos_rt_unix_stream_write([u8])` ABI applies uniformly. Unix-domain
// sockets are POSIX-only; on a non-unix target every entry point returns
// an `Err`, so this would report a bind failure rather than crash.

use std::net
use std::fs
use std::sync::channel

const OK: i64 = 1
const MISMATCH: i64 = 0
const CONNECT_FAILED: i64 = -1
const READ_FAILED: i64 = -2

fn client(path: String, tx: Sender<i64>) {
    let stream = match net::UnixStream::connect(&path) {
        Ok(s) => s
        Err(_) => { tx.send(CONNECT_FAILED)
            return }
    }
    let _ = stream.write(#[80, 73, 78, 71])
    let echo = match stream.read(64) {
        Ok(b) => b
        Err(_) => { tx.send(READ_FAILED)
            return }
    }
    let _ = stream.close()
    let ok = echo.len() == 4 && echo[0] == 80 && echo[1] == 73 && echo[2] == 78 && echo[3] == 71
    tx.send(if ok { OK } else { MISMATCH })
}

fn main() {
    let path = "/tmp/gos_unix_echo_fixture.sock"
    let _ = fs::remove_file(&path)
    let listener = match net::UnixListener::bind(&path) {
        Ok(l) => l
        Err(e) => { println!("bind failed: {}", e)
            return }
    }
    let (tx, rx) = channel()
    go client(path, tx)
    let (stream, _peer) = match listener.accept() {
        Ok(p) => p
        Err(e) => { println!("accept failed: {}", e)
            return }
    }
    let req = match stream.read(64) {
        Ok(b) => b
        Err(e) => { println!("server read failed: {}", e)
            return }
    }
    let _ = stream.write(&req)
    let _ = stream.close()
    let _ = listener.close()
    let code = match rx.recv() {
        Some(c) => c
        None => { println!("no client result")
            return }
    }
    let _ = fs::remove_file(&path)
    if code == OK {
        println!("unix echo ok")
    } else if code == MISMATCH {
        println!("unix echo MISMATCH")
    } else if code == CONNECT_FAILED {
        println!("client connect failed")
    } else if code == READ_FAILED {
        println!("client read failed")
    } else {
        println!("unix echo error {}", code)
    }
}
