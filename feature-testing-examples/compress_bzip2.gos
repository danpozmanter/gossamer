// Cross-tier regression for std::compress::bzip2 (worked under
// `gos` but BUILD-FAILED under `gos build` - manifest-advertised
// and interp-bound, but unwired on the compiled tiers). compress /
// decompress must round-trip identically on `gos` and `gos build`.
// A String argument is byte-coerced before the shim (the same
// whitelist that gzip/zstd use), so this also guards the
// String->bytes path.

use std::compress

fn main() {
    let plain = "hello bzip2 world, hello bzip2 world, hello bzip2 world"
    match compress::bzip2::compress(plain.as_bytes(), 6) {
        Ok(c) => match compress::bzip2::decompress(c) {
            Ok(b) => println("rt ok in={} c={} back={}", plain.len(), c.len(), b.len())
            Err(e) => println("decompress err {}", e)
        }
        Err(e) => println("compress err {}", e)
    }
    match compress::bzip2::compress(plain.as_bytes(), 1) {
        Ok(c) => println("lvl1 c={}", c.len())
        Err(e) => println("lvl err {}", e)
    }
}
