// `for (k, v)` over a `Vec<(String, Enum)>` bound from an enum-variant
// pattern - the tuple-destructure for-vec path that once had no slot
// address to read fields from. The element tuple carries an enum
// payload reached through the outer enum, so the loop must materialize
// each 16-byte `(String, Doc)` slot before projecting `k` / `v`.
// Bit-identical across the VM, Cranelift JIT, and LLVM AOT.

enum Doc {
    Leaf(i64),
    Obj([(String, Doc)]),
}

fn total(d: Doc) -> i64 {
    match d {
        Doc::Leaf(n) => n,
        Doc::Obj(pairs) => {
            let mut sum = 0
            for (k, v) in pairs {
                sum += k.len()
                sum += total(v)
            }
            sum
        }
    }
}

fn render(d: &Doc, out: &mut String) {
    match d {
        Doc::Leaf(n) => *out += format!("{}", n),
        Doc::Obj(pairs) => {
            *out += "{"
            let mut first = true
            for (k, v) in pairs {
                if !first { *out += "," }
                *out += k
                *out += ":"
                render(v, out)
                first = false
            }
            *out += "}"
        }
    }
}

fn main() {
    let inner = [(String::from("x"), Doc::Leaf(10)), (String::from("y"), Doc::Leaf(20))]
    let doc = Doc::Obj([
        (String::from("id"), Doc::Leaf(7)),
        (String::from("body"), Doc::Obj(inner)),
    ])
    let mut out = String::new()
    render(&doc, &mut out)
    println!("{}", out)
    println!("{}", total(doc))
}
