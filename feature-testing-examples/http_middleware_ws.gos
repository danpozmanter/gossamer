// Cross-tier regression for the canonical middleware / websocket
// classifier free functions `http::middleware::decode_basic_auth` and
// `http::websocket::is_websocket_upgrade`. Both were interp-only; each
// now lowers to a `gos_rt_*` shim so the bytecode VM (`gos run`) and
// LLVM AOT (`gos build`) classify bit-identically.
//
// `decode_basic_auth(header) -> Option<(String, String)>` decodes a
// Basic-auth header value into (user, password); `is_websocket_upgrade
// (request) -> bool` reports whether the request carries a WebSocket
// upgrade handshake (`Upgrade: websocket` + `Connection: upgrade`).
//
// Self-terminating: the client runs in main and exits explicitly, so
// the run is a plain stdout-parity comparison. Binds a fixed loopback
// port, serialized under SERVER_PORT_LOCK by
// `http_middleware_ws_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::http::middleware
use std::http::websocket
use std::process
use std::time

fn header_of(headers: &[(String, String)], want: String) -> String {
    let mut found = ""
    for (name, value) in headers {
        if name == want {
            found = value
        }
    }
    found
}

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> http::Response {
        let auth = header_of(&r.headers, "authorization")
        let cred = match middleware::decode_basic_auth(auth) {
            Some((u, p)) => "cred=" + &u + ":" + &p,
            None => "cred=none",
        }
        let up = if websocket::is_websocket_upgrade(r) {
            "up=yes"
        } else {
            "up=no"
        }
        http::Response::text(200, cred + " " + &up)
    }
}

fn serve_app() {
    if let Err(e) = http::serve("127.0.0.1:23911", App()) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, []) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go serve_app()
    let base = "http://127.0.0.1:23911/x"
    await_ready(&base)

    // Basic auth + websocket upgrade headers present.
    // "admin:s3cret" base64-encoded is "YWRtaW46czNjcmV0".
    let up_hdr: [(String, String)] = [
        ("Authorization", "Basic YWRtaW46czNjcmV0"),
        ("Upgrade", "websocket"),
        ("Connection", "Upgrade"),
    ]
    match http::request("GET", &base, "", up_hdr) {
        Ok(r) => println!("A status={} body={}", r.status, r.body),
        Err(e) => println!("A error: {}", e),
    }

    // Neither header present: decode degrades to None, upgrade to no.
    match http::get(&base, []) {
        Ok(r) => println!("B status={} body={}", r.status, r.body),
        Err(e) => println!("B error: {}", e),
    }

    process::exit(0)
}
