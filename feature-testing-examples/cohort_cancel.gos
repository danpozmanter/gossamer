// Cancellation and cleanup inside a cohort.
//
// A cancelled child observes cancellation as an operation's ordinary
// "nothing more is coming" answer - a receive reports `None`, the same
// answer a closed channel gives - so it leaves through its own normal
// exit path and its `defer` frames run in order. Nothing is killed.
//
// Every line is printed after the cohort it describes has finished, so
// the transcript is determined even though the work is concurrent.

use std::{errors, runtime, time}

fn fail_now() -> Result<i64, errors::Error> {
    Err(errors::new("first child failed"))
}

fn drain(rx: Receiver<i64>) -> Result<i64, errors::Error> {
    // Nothing is ever sent. Only cancellation ends this loop, and it
    // ends it the way a closed channel would.
    let mut seen = 0
    while let Some(_v) = rx.recv() {
        seen += 1
    }
    Ok(seen)
}

fn nap() -> Result<i64, errors::Error> {
    // A long sleep the cohort has to cut short.
    time::sleep(30_000)
    Ok(1)
}

fn cleanup_child() -> Result<i64, errors::Error> {
    defer println!("child cleanup ran")
    time::sleep(30_000)
    Ok(1)
}

fn polls() -> Result<i64, errors::Error> {
    // Pure computation is not a cancellation point, so a CPU-bound child
    // cooperates where it chooses to.
    let mut i = 0
    while i < 1000 {
        if runtime::cohort_cancelled() {
            return Ok(i)
        }
        time::sleep(5)
        i += 1
    }
    Ok(i)
}

fn main() {
    let (_tx, rx) = channel(1)

    // A blocked receiver is wound down when its sibling fails.
    let blocked = cohort {
        let _f = spawn(|| fail_now())
        let _d = spawn(|| drain(rx))
    }
    println!("blocked: {:?}", blocked)

    // So is a sleeping one.
    let sleeping = cohort {
        let _f = spawn(|| fail_now())
        let _s = spawn(|| nap())
    }
    println!("sleeping: {:?}", sleeping)

    // A cancelled child's `defer` still runs, in order, on its own exit
    // path: the line below is printed by the child before the cohort
    // returns.
    let cleaned = cohort {
        let _f = spawn(|| fail_now())
        let _c = spawn(|| cleanup_child())
    }
    println!("cleaned: {:?}", cleaned)

    // A child can ask whether its cohort is cancelled.
    let polled = cohort {
        let _f = spawn(|| fail_now())
        let _p = spawn(|| polls())
    }
    println!("polled: {:?}", polled)

    // A timeout bounds the whole block.
    let bounded = cohort(timeout: 100) {
        let _s = spawn(|| nap())
    }
    println!("bounded: {}", bounded.is_err())

    // Collect-all runs every child and reports each failure.
    let collected = cohort(policy: Policy::CollectAll) {
        let _a = spawn(|| fail_now())
        let _b = spawn(|| fail_now())
    }
    println!("collected: {:?}", collected)

    // Cancelling a cohort reaches a grandchild: the inner cohort's own
    // child is wound down when the outer cohort fails.
    let nested = cohort {
        let _f = spawn(|| fail_now())
        let _inner = spawn(|| -> Result<i64, errors::Error> {
            cohort {
                let _deep = spawn(|| nap())
            }?
            Ok(0)
        })
    }
    println!("nested: {:?}", nested)

    // Race stops at the first success; the loser is cancelled, and work
    // it already committed is not undone.
    let raced = cohort(policy: Policy::Race) {
        let _w = spawn(|| -> Result<i64, errors::Error> { Ok(1) })
        let _l = spawn(|| nap())
    }
    println!("raced: {:?}", raced)
}
