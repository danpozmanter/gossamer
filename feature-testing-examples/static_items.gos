// Static Items
// Exercises immutable `static` items used inside functions and
// across multiple call sites so all three tiers see the same values.

static MAX_RETRIES: i64 = 5
static THRESHOLD: f64 = 0.75
static GREETING: &str = "hello"

fn should_retry(attempt: i64) -> bool {
    attempt < MAX_RETRIES
}

fn above_threshold(v: f64) -> bool {
    v > THRESHOLD
}

fn greet(name: str) -> String {
    format("{}, {}!", GREETING, name)
}

fn retry_count() -> i64 {
    let mut n = 0
    while should_retry(n) {
        n += 1
    }
    n
}

fn main() {
    println("MAX_RETRIES = {}", MAX_RETRIES)
    println("THRESHOLD = {}", THRESHOLD)
    println("GREETING = {}", GREETING)

    println("retry_count = {}", retry_count())
    println("above_threshold(0.8) = {}", above_threshold(0.8))
    println("above_threshold(0.5) = {}", above_threshold(0.5))
    println("{}", greet("world"))
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn static_i64_value() {
        let _ = testing::check_eq(super::MAX_RETRIES, 5, "MAX_RETRIES == 5")
    }

    #[test]
    fn should_retry_uses_static() {
        let _ = testing::check(super::should_retry(0), "attempt 0 retries")
        let _ = testing::check(super::should_retry(4), "attempt 4 retries")
        let _ = testing::check(!super::should_retry(5), "attempt 5 does not retry")
    }

    #[test]
    fn above_threshold_uses_static() {
        let _ = testing::check(super::above_threshold(0.9), "0.9 above threshold")
        let _ = testing::check(!super::above_threshold(0.5), "0.5 not above threshold")
    }

    #[test]
    fn greet_uses_static_str() {
        let g = super::greet("alice")
        let _ = testing::check(g.contains("hello"), "greeting uses GREETING")
        let _ = testing::check(g.contains("alice"), "greeting contains name")
    }

    #[test]
    fn retry_count_matches_static() {
        let _ = testing::check_eq(super::retry_count(), super::MAX_RETRIES, "retry_count == MAX_RETRIES")
    }
}
