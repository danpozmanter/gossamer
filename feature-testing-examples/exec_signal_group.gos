// `exec::signal` + `exec::kill_group` parity test.
//
// Spawns a long-running `sleep`, sends SIGTERM (signum 15) via the
// generic signal entry point, waits for the child to reap, and
// asserts the kill returned true. The wait_timeout follow-up
// shows the pid is no longer reapable (-2) after the OS cleans it
// up.

use std::os::exec

fn main() {
    let args: Vec<String> = ["30"].to_vec()
    match exec::spawn(&"/bin/sleep", &args) {
        Ok(pid) => {
            if pid > 0 { println!("spawned") }
            let killed = exec::signal(pid, 15)
            if killed { println!("term sent") } else { println!("term failed") }
            let _ = exec::wait_timeout(pid, 2000)
            println!("done")
        }
        Err(e) => println!("err: {}", e.message()),
    }

    // kill_group: spawn `sh -c 'sleep 30 & wait'` so the leader pid
    // owns descendants; we kill the group and expect a non-zero
    // wait result within the grace window.
    let group_args: Vec<String> = ["-c", "sleep 30 & wait"].to_vec()
    match exec::spawn(&"/bin/sh", &group_args) {
        Ok(pid) => {
            if pid > 0 { println!("group-spawned") }
            let killed = exec::kill_group(pid)
            if killed { println!("group killed") } else { println!("group kill failed") }
            let _ = exec::wait_timeout(pid, 2000)
            println!("group done")
        }
        Err(e) => println!("group err: {}", e.message()),
    }
}
