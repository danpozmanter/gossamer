// Generic Function Monomorphization
// Simulate generic algorithms by parameterising on Fn closures.
// The same map/reduce/zip logic runs over i64 and f64 collections,
// demonstrating that higher-order functions substitute for
// monomorphized generics in Gossamer today.

fn map_i64(xs: Vec<i64>, f: Fn(i64) -> i64) -> Vec<i64> {
    let mut out: Vec<i64> = Vec::from([])
    for x in xs {
        out.push(f(x))
    }
    out
}

fn reduce_i64(xs: Vec<i64>, init: i64, f: Fn(i64, i64) -> i64) -> i64 {
    let mut acc = init
    for x in xs {
        acc = f(acc, x)
    }
    acc
}

fn map_f64(xs: Vec<f64>, f: Fn(f64) -> f64) -> Vec<f64> {
    let mut out: Vec<f64> = Vec::from([])
    for x in xs {
        out.push(f(x))
    }
    out
}

fn reduce_f64(xs: Vec<f64>, init: f64, f: Fn(f64, f64) -> f64) -> f64 {
    let mut acc = init
    for x in xs {
        acc = f(acc, x)
    }
    acc
}

fn clamp_i64(lo: i64, hi: i64, x: i64) -> i64 {
    if x < lo { lo } else if x > hi { hi } else { x }
}

fn main() {
    // Integer domain
    let nums = Vec::from([1, 2, 3, 4, 5])
    let doubled = map_i64(nums, |x| x * 2)
    println!("doubled[4] = {}", doubled[4])

    let sum = reduce_i64(nums, 0, |acc, x| acc + x)
    println!("sum = {}", sum)

    let product = reduce_i64(nums, 1, |acc, x| acc * x)
    println!("product = {}", product)

    // Float domain - same algorithm, different type
    let fs: Vec<f64> = Vec::from([1.0, 2.0, 3.0, 4.0])
    let halved = map_f64(fs, |x| x * 0.5)
    println!("halved[0] = {}", halved[0])

    let fsum = reduce_f64(fs, 0.0, |acc, x| acc + x)
    println!("fsum = {}", fsum)

    // Partial application via closure capture
    let add_ten = |x| x + 10
    let shifted = map_i64(nums, add_ten)
    println!("shifted[0] = {}", shifted[0])

    // clamp via partial application
    let clamp5 = |x| clamp_i64(1, 5, x)
    let raw = Vec::from([0, 3, 7, -1, 5])
    let clamped = map_i64(raw, clamp5)
    println!("clamped[0] = {}", clamped[0])
    println!("clamped[2] = {}", clamped[2])
    println!("clamped[3] = {}", clamped[3])
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn map_i64_squares() {
        let xs = #[1, 2, 3, 4]
        let r = super::map_i64(xs, |x| x * x)
        let _ = testing::check_eq(&r[0], &1, "1^2")
        let _ = testing::check_eq(&r[3], &16, "4^2")
    }

    #[test]
    fn reduce_i64_sum() {
        let s = super::reduce_i64(#[1, 2, 3, 4, 5], 0, |acc, x| acc + x)
        let _ = testing::check_eq(&s, &15, "sum 1..5")
    }

    #[test]
    fn reduce_f64_product() {
        let p = super::reduce_f64(#[1.0, 2.0, 3.0], 1.0, |acc, x| acc * x)
        let _ = testing::check(p > 5.9 && p < 6.1, "1.0*2.0*3.0≈6.0")
    }

    #[test]
    fn clamp_bounds() {
        let _ = testing::check_eq(&super::clamp_i64(0, 10, -5), &0, "below lo")
        let _ = testing::check_eq(&super::clamp_i64(0, 10, 15), &10, "above hi")
        let _ = testing::check_eq(&super::clamp_i64(0, 10, 7), &7, "within")
    }
}
