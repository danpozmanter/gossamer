// Slice patterns over fixed-size array literals (`[T; N]`) bind prefix and
// suffix elements and materialize the `..rest` sub-slice with the correct
// element size, for both `[i64]` and `[String]` element types. The same
// lowering runs on the bytecode VM, the Cranelift JIT, and the LLVM AOT
// tiers.

fn head_rest(xs: [i64; 4]) -> String {
    match xs {
        [first, ..rest] => format!("first={} rest_len={}", first, rest.len()),
        [] => "empty".to_string(),
    }
}

fn last_only(xs: [i64; 4]) -> i64 {
    match xs {
        [.., last] => last,
        [] => -1,
    }
}

fn exact_four(xs: [i64; 4]) -> i64 {
    match xs {
        [a, b, c, d] => a + b + c + d,
        _ => 0,
    }
}

fn str_head_rest(xs: [String; 3]) -> String {
    match xs {
        [h, ..t] => format!("h={} t_len={}", h, t.len()),
        [] => "empty".to_string(),
    }
}

fn main() {
    let xs = #[10, 20, 30, 40]
    println!("{}", head_rest(xs))
    println!("last={}", last_only(#[1, 2, 3, 4]))
    println!("sum={}", exact_four(#[5, 6, 7, 8]))

    let ss = #["a".to_string(), "b".to_string(), "c".to_string()]
    println!("{}", str_head_rest(ss))

    // Inline match over a fresh array literal.
    match #[100, 200, 300, 400] {
        [first, ..rest] => println!("inline first={} rest_len={}", first, rest.len()),
        [] => println!("inline empty"),
    }
}
