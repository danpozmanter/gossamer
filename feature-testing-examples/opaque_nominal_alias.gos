// Opaque nominal aliases: `newtype Name = Repr` declares a distinct type
// over an unchanged runtime representation.

use std::collections::{Map, Set}

newtype UserId = i64
newtype Score = i64
newtype Label = String
type Transparent = i64

impl UserId {
    fn next(&self) -> UserId {
        (self.value() + 1).into()
    }

    fn value(&self) -> i64 {
        self.into()
    }
}

// Two aliases over one representation stay distinct, so crossing between
// them is a conversion the program has to write.
impl From<UserId> for Score {
    fn from(u: UserId) -> Score {
        (u.value() * 10).into()
    }
}

// Integer-only and hot, in its own function, so the JIT admits a body here
// and the compiled tiers are genuinely compared rather than the VM against
// itself.
fn accumulate(seed: UserId, rounds: i64) -> i64 {
    let mut total = 0
    let mut cur = seed.value()
    for _ in 0..rounds {
        total += cur
        cur += 1
    }
    total
}

fn describe(id: UserId) -> String {
    format("user:{}", id)
}

// A field typed by an alias serializes as its representation and decodes
// back across the boundary.
struct Record { id: UserId, plain: Transparent, n: i64 }

fn main() {
    // Distinct types over one representation; `.into()` crosses in both
    // directions and carries no work.
    let id: UserId = 41.into()
    let raw: i64 = id.into()
    println("id {} raw {}", id, raw)

    // An alias carries its own impl, and a method may return the alias.
    println("next {}", id.next())
    println("value {}", id.value())

    // Two aliases over the same representation stay distinct from each
    // other, not just from the representation.
    let s: Score = 10.into()
    println("score {}", s)

    // Crossing between two aliases runs the impl that was written for it.
    let converted: Score = id.into()
    println("converted {}", converted)

    // A transparent alias keeps its substitute-everywhere meaning.
    let t: Transparent = 5
    println("transparent {}", t + 1)

    // The representation's own behaviour shows through: ordering and
    // equality compare the underlying values.
    let a: UserId = 1.into()
    let b: UserId = 2.into()
    println("cmp {} {} {}", a == b, a < b, a == 1.into())

    // Hashable wherever the representation is, and the key round-trips.
    let mut seats: Map<UserId, String> = Map::new()
    seats.insert(a, "front")
    seats.insert(b, "back")
    match seats.get(a) {
        Some(seat) => println("seat {}", seat)
        None => println("seat missing")
    }
    println("seats {}", seats.len())

    let mut seen: Set<UserId> = Set::new()
    seen.insert(a)
    seen.insert(a)
    println("set {}", seen.len())

    // A non-integer representation works the same way.
    let tag: Label = "beta".into()
    let tag_raw: String = tag.into()
    println("tag {} {}", tag, tag_raw.len())

    // Nested in a container, the alias is still the element type.
    let ids: Vec<UserId> = #[a, b]
    println("ids {} {}", ids.len(), ids[1])

    println("acc {}", accumulate(id, 6))
    println("{}", describe(id))

    let rec = Record { id: a, plain: 3, n: 9 }
    match to_json::<Record>(rec) {
        Ok(text) => {
            println("json {}", text)
            match from_json::<Record>(text) {
                Ok(back) => println("back {} {} {}", back.id, back.plain, back.n)
                Err(e) => println("decode failed {}", e)
            }
        }
        Err(e) => println("encode failed {}", e)
    }
}
