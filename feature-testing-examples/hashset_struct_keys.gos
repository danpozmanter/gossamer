// Struct Set values use value equality, not their allocation address.
// Mirrors the Point intersections used by AoC 2019 day 3.
use std::collections::Set
use std::collections::Map

struct Point { x: i32, y: i32 }

fn main() {
    let mut left: Set<Point> = Set::new()
    left.insert(Point { x: 1, y: 2 })
    left.insert(Point { x: 3, y: 4 })
    let mut right: Set<Point> = Set::new()
    right.insert(Point { x: 3, y: 4 })
    right.insert(Point { x: 5, y: 6 })
    let shared = left.intersection(right)
    let point = shared.to_vec()[0]
    println("len={} x={} y={}", shared.len(), point.x, point.y)

    let mut steps: Map<Point, i64> = Map::new()
    steps.insert(Point { x: 3, y: 4 }, 7)
    println("steps={}", steps.get(Point { x: 3, y: 4 }).unwrap())

    // A walk over a struct-keyed set rebuilds each element from its slot
    // descriptor, so the body reads fields rather than the one word a
    // scalar-element snapshot would hand it. Traversal goes through `iter()`:
    // the set itself answers membership and set algebra.
    for p in left { println("for {} {}", p.x, p.y) }
    for p in left.iter() { println("iter {} {}", p.x, p.y) }
    println("count {}", left.iter().count(|p| p.x > 1))
    println("sum {}", left.iter().map(|p| p.x + p.y).collect().len())

    // The element type is the one the first `insert` stores, so a set built
    // empty walks the same way an annotated one does.
    let mut inferred = Set::new()
    inferred.insert(Point { x: 7, y: 8 })
    for p in inferred { println("inferred {} {}", p.x, p.y) }
}
