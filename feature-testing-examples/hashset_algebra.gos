// Set algebra: union / intersection / difference / symmetric_difference
// (returning a fresh set) and the is_subset / is_superset / is_disjoint
// predicates. Sets flow across function boundaries (built in a helper,
// consumed in `main`), so this also exercises type-based receiver dispatch
// for the opaque `Set` handle. Bit-identical on the VM, Cranelift, and
// LLVM tiers (results inspected via `len()` / `contains()` for stable,
// order-independent output).

use std::collections::Set

fn set_of(a: String, b: String, c: String) -> Set<String> {
    let mut s = Set::new()
    s.insert(a)
    s.insert(b)
    s.insert(c)
    s
}

fn main() {
    let a = set_of("x", "y", "z")
    let b = set_of("y", "z", "w")

    let u = a.union(b)
    println("union len={} has_w={} has_x={}", u.len(), u.contains("w"), u.contains("x"))

    let i = a.intersection(b)
    println("inter len={} has_y={} has_x={}", i.len(), i.contains("y"), i.contains("x"))

    let d = a.difference(b)
    println("diff len={} has_x={} has_y={}", d.len(), d.contains("x"), d.contains("y"))

    let sd = a.symmetric_difference(b)
    println("symdiff len={} has_x={} has_w={} has_y={}"
        sd.len(), sd.contains("x"), sd.contains("w"), sd.contains("y"))

    println("subset={} superset={} disjoint={}"
        set_of("x", "y", "x").is_subset(a)
        a.is_superset(set_of("x", "x", "x"))
        a.is_disjoint(set_of("q", "r", "s")))
}

#[cfg(test)]
mod tests {
    use std::testing
    use std::collections::Set

    fn pair() -> (Set<String>, Set<String>) {
        let mut a = Set::new()
        a.insert("a")
        a.insert("b")
        a.insert("c")
        let mut b = Set::new()
        b.insert("b")
        b.insert("c")
        b.insert("d")
        (a, b)
    }

    #[test]
    fn union_and_intersection() {
        let a, b = pair()
        let u = a.union(b)
        let _ = testing::check(u.len() == 4, "union has 4 elements")
        let _ = testing::check(u.contains("a") && u.contains("d"), "union holds both extremes")
        let a2, b2 = pair()
        let i = a2.intersection(b2)
        let _ = testing::check(i.len() == 2 && i.contains("b") && !i.contains("a"), "intersection is {b,c}")
    }

    #[test]
    fn difference_and_predicates() {
        let a, b = pair()
        let d = a.difference(b)
        let _ = testing::check(d.len() == 1 && d.contains("a"), "difference is {a}")
        let a2, b2 = pair()
        let _ = testing::check(!a2.is_disjoint(b2), "sharing b,c is not disjoint")
        let mut sub = Set::new()
        sub.insert("b")
        let _ = testing::check(sub.is_subset(a2) && a2.is_superset(sub), "{b} subset of a")
    }
}
