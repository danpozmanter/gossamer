// An ordering a module declares is the ordering its callers get.
//
// `a < b` reaches the receiver type's own `cmp`, and an `impl` written in a
// module names its type through that module - so the operator's dispatch key
// and the registered name have to agree, or the ordering a library ships is
// reached in compiled code and unbound in the bytecode VM.
//
// The `cmp` here is deliberately reversed, so an answer that matches the
// field order would mean the impl was not the one consulted.

mod stamp {
    #[derive(Debug, PartialEq, Eq)]
    pub struct Stamp {
        pub tag: i64
    }

    impl PartialOrd for Stamp {
        fn cmp(&self, other: &Stamp) -> i64 {
            if self.tag > other.tag {
                -1
            } else if self.tag < other.tag {
                1
            } else {
                0
            }
        }
    }

    #[derive(Debug, Default, PartialEq, Eq)]
    pub struct Counter {
        pub hits: i64
        pub label: String
    }
}

fn main() {
    let low = stamp::Stamp { tag: 1 }
    let high = stamp::Stamp { tag: 3 }
    println!("1 < 3 under a reversed cmp: {}", low < high)
    println!("3 < 1 under a reversed cmp: {}", high < low)
    println!("equal: {}", stamp::Stamp { tag: 2 } == stamp::Stamp { tag: 2 })

    // A derived `default` a module declares is reached the same way.
    let zero = stamp::Counter::default()
    println!("default from a module: {:?}", zero)
}
