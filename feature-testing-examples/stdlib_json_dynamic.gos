// Regression lock for the dynamic json::Value accessor surface:
// parse / get / at / as_i64 / as_f64 / as_str / as_bool / keys /
// len / is_null. The static-typed `from_json::<T>` path is covered
// elsewhere; this pins the unknown-shape document API.

use std::encoding::json

fn run() -> Result<(), String> {
    let v = json::parse("{\"n\": 42, \"f\": 3.5, \"s\": \"hi\", \"b\": true, \"z\": null, \"xs\": [10, 20, 30]}")?
    println("len={}", json::len(v))

    match json::as_i64(json::get(v, "n").unwrap()) {
        Some(n) => println("n={}", n)
        None => println("n=none")
    }
    match json::as_f64(json::get(v, "f").unwrap()) {
        Some(f) => println("f={:.2}", f)
        None => println("f=none")
    }
    match json::as_str(json::get(v, "s").unwrap()) {
        Some(s) => println("s={}", s)
        None => println("s=none")
    }
    match json::as_bool(json::get(v, "b").unwrap()) {
        Some(b) => println("b={}", b)
        None => println("b=none")
    }
    println("z_null={}", json::is_null(json::get(v, "z").unwrap()))

    let xs = json::get(v, "xs").unwrap()
    println("xs_len={}", json::len(xs))
    let mut total = 0
    for i in 0..3 {
        match json::as_i64(json::at(xs, i)) {
            Some(n) => { total += n }
            None => {}
        }
    }
    println("xs_sum={}", total)
    Ok(())
}

fn main() {
    match run() {
        Ok(_) => println("done")
        Err(e) => println("error: {}", e)
    }
}
