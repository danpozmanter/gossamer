// Auto-derived `to_json`/`from_json` over the extended field kinds:
// Option<T> (Some + None), tuples, Vec, nested struct, and a
// HashMap<String, i64> (object with keys sorted for determinism).
// Round-trips to a deterministic string, bit-identical on every tier.
use std::encoding::json
use std::collections::HashMap

struct Inner { n: i64 }
struct Rec {
    id: i64,
    nick: Option<String>,
    absent: Option<i64>,
    pair: (i64, String),
    tags: [String],
    inner: Inner,
    caps: HashMap<String, i64>,
}

fn main() {
    let mut caps: HashMap<String, i64> = HashMap::new()
    caps.insert(&"a", 1)
    caps.insert(&"b", 2)
    let r = Rec { id: 7, nick: Some("neo"), absent: None, pair: (3, "x"), tags: ["a", "b"], inner: Inner { n: 5 }, caps: caps }
    let js = to_json::<Rec>(&r) |> _.unwrap_or(&"ERR")
    println!("{}", js)
    match from_json::<Rec>(&js) {
        Ok(r2) => println!("id={} nick={} absent={} p0={} p1={} tag0={} n={} capa={} capb={}",
            r2.id, r2.nick.unwrap_or(&"?"), r2.absent.unwrap_or(-1),
            r2.pair.0, r2.pair.1, r2.tags.first().unwrap_or(&"?"), r2.inner.n,
            r2.caps.get(&"a").unwrap_or(-1), r2.caps.get(&"b").unwrap_or(-1)),
        Err(e) => println!("ERR {}", e),
    }
}
