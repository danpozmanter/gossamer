// A `for` loop over `Map::iter()` whose tuple-destructure uses a `_`
// wildcard in one or both slots. The key is always read (the value lookup
// needs it), so a `_` key only suppresses its user binding; a struct value
// must still bind as a box-pointer reference so `v.field` derefs the box
// rather than reading the pointer bits inline. Each path must match the VM
// bit-for-bit on every tier.

use std::collections::Map

struct Rec { label: String, weight: i64 }

fn main() {
    let mut m: Map<i64, Rec> = Map::new()
    m.insert(1, Rec { label: format("a"), weight: 10 })
    m.insert(2, Rec { label: format("b"), weight: 20 })
    m.insert(3, Rec { label: format("c"), weight: 30 })

    // `(_, v)` over struct values: value binds as a box ref, `v.weight` derefs.
    let mut value_sum = 0
    for (_, v) in m.iter() {
        value_sum += v.weight
    }

    // `(k, _)` over struct values: value computed-but-unused, no use-after-free.
    let mut key_sum = 0
    for (k, _) in m.iter() {
        key_sum += k
    }

    // `(_, _)` both wildcards: pure count.
    let mut count = 0
    for (_, _) in m.iter() {
        count += 1
    }

    // String-keyed map, `(_, v)`.
    let mut sm: Map<String, i64> = Map::new()
    sm.insert(format("x"), 5)
    sm.insert(format("y"), 7)
    let mut str_value_sum = 0
    for (_, v) in sm.iter() {
        str_value_sum += v
    }

    println(
        "value_sum={} key_sum={} count={} str_value_sum={}"
        value_sum, key_sum, count, str_value_sum
    )
}
