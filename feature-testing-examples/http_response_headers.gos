// Cross-tier regression for handler-set response headers.
// `Response::with_header` is chainable replace-then-push: a second
// `with_header` with the same case-insensitive name keeps only the
// last value, and explicit headers must reach the wire on every
// tier. The content-type precedence is: explicit header >
// constructor content_type field > text/plain default - here the
// constructor default must survive alongside the custom headers.
//
// Self-terminating: the client runs in main and exits explicitly.
// Binds a fixed loopback port - serialized under SERVER_PORT_LOCK
// by `http_response_headers_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::process
use std::time

struct App { }

impl http::Handler for App {
    fn serve(&self, _r: http::Request) -> Result<http::Response, http::Error> {
        Ok(http::Response::text(201, "created")
            .with_header("x-a", "1")
            .with_header("X-A", "2")
            .with_header("x-b", "3"))
    }
}

fn serve_app() {
    if let Err(e) = http::serve("127.0.0.1:23874", App { }) {
        eprintln!("serve failed: {e}")
    }
}

fn header_of(headers: &Vec<(String, String)>, want: String) -> String {
    let mut found = ""
    for (name, value) in headers {
        if name.to_lowercase() == want {
            found = *value
        }
    }
    found
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go serve_app()
    await_ready(&"http://127.0.0.1:23874/x")
    match http::get("http://127.0.0.1:23874/x", Vec::from([])) {
        Ok(r) => {
            println!("status={} body={}", r.status, r.body)
            let headers = r.headers
            println!("x-a={}", header_of(&headers, "x-a"))
            println!("x-b={}", header_of(&headers, "x-b"))
            println!("content-type={}", header_of(&headers, "content-type"))
        }
        Err(e) => println!("error: {}", e),
    }
    process::exit(0)
}
