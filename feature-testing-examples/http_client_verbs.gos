// Cross-tier regression for the one-shot client verbs
// `http::head` / `http::options` / `http::post` / `http::put` /
// `http::delete`. Only `http::get` / `http::request` /
// `http::request_bytes` / `http::stream` had compiled-tier arms; the
// per-verb wrappers were interp-only (BUILD-FAIL on `gos build`). Each
// now lowers to its own `gos_rt_http_<verb>` shim so the method string
// is fixed at the runtime boundary, bit-identically on the bytecode VM
// (`gos`) and LLVM AOT (`gos build`).
//
// The handler echoes the request method, body, and the inbound
// Content-Type header. `post` / `put` carry the content type their
// shim sets; bodyless verbs leave it empty. The `head` response body
// is empty per RFC 9110, so its line reports only the status.
//
// Self-terminating: the client runs in main and exits explicitly, so
// the run is a plain stdout-parity comparison. Binds a fixed loopback
// port, serialized under SERVER_PORT_LOCK by
// `http_client_verbs_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::process
use std::time

fn header_of(headers: &[(String, String)], want: String) -> String {
    let mut found = ""
    for (name, value) in headers {
        if name == want {
            found = *value
        }
    }
    found
}

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> http::Response {
        let ct = header_of(&r.headers, "content-type")
        http::Response::text(200, "m=" + &r.method + " b=" + &r.body + " ct=" + &ct)
    }
}

fn serve_app() {
    if let Err(e) = http::serve("127.0.0.1:23910", App { }) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, []) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go serve_app()
    let base = "http://127.0.0.1:23910/x"
    await_ready(&base)

    match http::get(&base, []) {
        Ok(r) => println!("get status={} body={}", r.status, r.body),
        Err(e) => println!("get error: {}", e),
    }
    match http::options(&base, []) {
        Ok(r) => println!("options status={} body={}", r.status, r.body),
        Err(e) => println!("options error: {}", e),
    }
    match http::post(&base, "hello-post", "application/json") {
        Ok(r) => println!("post status={} body={}", r.status, r.body),
        Err(e) => println!("post error: {}", e),
    }
    match http::put(&base, "hello-put", "text/plain") {
        Ok(r) => println!("put status={} body={}", r.status, r.body),
        Err(e) => println!("put error: {}", e),
    }
    match http::delete(&base, "hello-delete", []) {
        Ok(r) => println!("delete status={} body={}", r.status, r.body),
        Err(e) => println!("delete error: {}", e),
    }
    match http::head(&base, []) {
        Ok(r) => println!("head status={}", r.status),
        Err(e) => println!("head error: {}", e),
    }

    process::exit(0)
}
