// Keyword arguments and constant parameter defaults.
//
// Both are caller-side spellings: the compiler rewrites every call into
// its callee's declared order before type checking, so all three tiers
// compile the same positional call and the calling convention is
// unchanged.

struct Rect { w: i64, h: i64 }

impl Rect {
    fn scaled(&self, factor: i64 = 2) -> i64 { self.w * self.h * factor }
    fn make(w: i64, h: i64 = 5) -> Rect { Rect { w: w, h: h } }
}

struct Other { v: i64 }

impl Other {
    // Same method name and the same default as `Rect::scaled`, so both
    // declarations rewrite a call identically and a labelled or defaulted
    // call is unambiguous even though the receiver's type is not known
    // until type checking.
    fn scaled(&self, factor: i64 = 2) -> i64 { self.v * factor }
}

struct Cell { v: i64 }
struct Pair { v: i64 }

impl Cell {
    // Same method name as `Pair::get` but a different arity, and neither
    // declares a default. A fully positional call needs no rewrite, so it
    // must not be reported as ambiguous just because the name collides -
    // `get`, `len`, `new`, and `push` collide across unrelated types
    // constantly.
    fn get(&self, k: i64) -> i64 { self.v + k }
}

impl Pair {
    fn get(&self, k: i64, j: i64) -> i64 { self.v + k + j }
}

fn volume(width: i64, height: i64 = 2, depth: i64 = 3) -> i64 {
    width * height * depth
}

fn label(text: String, prefix: String = "item", times: i64 = 1) -> String {
    let mut out = ""
    for _ in 0..times { out += prefix; out += ":"; out += text }
    out
}

fn flags(on: bool = true, scale: f64 = 1.5, sign: i64 = -2) -> String {
    format!("{} {} {}", on, scale, sign)
}

fn hot(n: i64, step: i64 = 2, bias: i64 = -1) -> i64 {
    n * step + bias
}

/// A hot integer-only body, so the JIT compiles calls that were rewritten
/// from named and defaulted forms rather than leaving this fixture to the
/// bytecode VM alone.
fn hot_total() -> i64 {
    let mut total = 0
    for i in 0..2000 {
        total += volume(i)
        total += volume(i, height = 3)
        total += volume(depth = 2, width = i)
        total += hot(i)
    }
    total
}

fn main() {
    // Defaults fill the parameters a positional call leaves off.
    println!("{}", volume(2))
    println!("{}", volume(2, 3))
    println!("{}", volume(2, 3, 4))

    // A name selects a parameter, so the written order is free.
    println!("{}", volume(width = 2, height = 3, depth = 4))
    println!("{}", volume(depth = 4, width = 2, height = 3))
    println!("{}", volume(height = 3, depth = 4, width = 2))

    // Positional arguments first, then names for the rest.
    println!("{}", volume(2, depth = 10))
    println!("{}", volume(2, 3, depth = 10))

    // Associated functions and methods take both forms.
    let r = Rect::make(w = 3)
    println!("{} {}", r.w, r.h)
    println!("{}", Rect::make(w = 3, h = 7).h)
    println!("{}", r.scaled())
    println!("{}", r.scaled(factor = 10))
    let o = Other { v: 4 }
    println!("{}", o.scaled())
    println!("{}", o.scaled(factor = 5))
    println!("{}", Other { v: 6 }.scaled())

    // Defaults of every constant shape, including a negated literal.
    println!("{}", label("a"))
    println!("{}", label("a", prefix = "x"))
    println!("{}", label("a", times = 2))
    println!("{}", label(text = "a", times = 2, prefix = "y"))
    println!("{}", flags())
    println!("{}", flags(on = false))
    println!("{}", flags(sign = 7))

    // A default is spliced per call site, so one call cannot disturb another.
    println!("{} {} {}", volume(1), volume(1, 9), volume(1))

    // Colliding method names of different arity, all positional.
    println!("{} {}", Cell { v: 1 }.get(2), Pair { v: 1 }.get(2, 3))

    println!("hot {}", hot_total())
}
