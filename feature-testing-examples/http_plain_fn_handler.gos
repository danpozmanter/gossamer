// Cross-tier regression for `http::serve(addr, handler)` where the
// handler is a plain `fn`. A plain function carries no environment,
// so it reaches the runtime's two-argument handler ABI through a
// synthesized env-ignoring thunk; without it the native server served
// a canned `ok` body and the bytecode VM answered 500. Also covers a
// plain fn wrapped in middleware, which took the same path.
//
// Self-terminating: the client runs in main and exits explicitly, so
// the fixture compares as a plain stdout-parity run. Binds fixed
// loopback ports - serialized under SERVER_PORT_LOCK by
// `http_plain_fn_handler_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::errors
use std::http
use std::http::middleware
use std::process
use std::time

fn direct(_r: http::Request) -> Result<http::Response, errors::Error> {
    Ok(http::Response::text(200, "plain fn ok"))
}

fn wrapped(_r: http::Request) -> Result<http::Response, errors::Error> {
    Ok(http::Response::text(200, "wrapped fn ok"))
}

fn serve_direct() {
    if let Err(e) = http::serve("127.0.0.1:23890", direct) {
        eprintln("serve failed: {e}")
    }
}

fn serve_wrapped() {
    let app = middleware::request_id(wrapped)
    if let Err(e) = http::serve("127.0.0.1:23891", app) {
        eprintln("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    spawn(|| serve_direct())
    spawn(|| serve_wrapped())
    await_ready("http://127.0.0.1:23890/x")
    await_ready("http://127.0.0.1:23891/x")
    match http::get("http://127.0.0.1:23890/x", Vec::from([])) {
        Ok(r) => println("direct status={} body={}", r.status, r.body)
        Err(e) => println("direct error: {}", e)
    }
    match http::get("http://127.0.0.1:23891/x", Vec::from([])) {
        Ok(r) => println("wrapped status={} body={}", r.status, r.body)
        Err(e) => println("wrapped error: {}", e)
    }
    process::exit(0)
}
