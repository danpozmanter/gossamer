// Vec<Vec<i64>> JIT marshalling: a function taking `&[Vec<i64>]` is called in a
// hot loop so it JIT-promotes; the marshalled native nested graph is built
// once and reused via the Arc-identity cache across every call. Exercises
// `g[i]` (inner-vec load) and `for nb in g[i]` (inner-vec iteration), the
// same shapes graph-bfs drives. Bit-identical across VM / Cranelift / LLVM.

fn sum_graph(g: &[Vec<i64>], n: i64) -> i64 {
    let mut total: i64 = 0
    let mut i: i64 = 0
    while i < n {
        for nb in g[i] {
            total += nb
        }
        i += 1
    }
    total
}

fn main() {
    let mut g: Vec<Vec<i64>> = Vec::from(#[])
    let mut i: i64 = 0
    while i < 100 {
        let mut row: Vec<i64> = Vec::from(#[])
        let mut j: i64 = 0
        while j < 5 {
            row.push(i * 10 + j)
            j += 1
        }
        g.push(row)
        i += 1
    }
    let n = g.len()
    let mut acc: i64 = 0
    let mut k: i64 = 0
    while k < 1000 {
        acc += sum_graph(&g, n)
        k += 1
    }
    println!("{}", acc)
}
