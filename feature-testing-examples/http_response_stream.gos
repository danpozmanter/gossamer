// Cross-tier regression for a response body written through
// `http::ResponseStream` rather than built as one buffer: the handler opens a
// stream, a goroutine writes each event into it and closes it, and the server
// frames every write to the client. This is the shape server-sent events, a
// large download, and a progressive render are built on.
//
// The writer runs inside the handler's own `cohort { }`, which owns it: a
// handler is an ordinary function, so a child it starts cannot be left
// running past the answer it returns. The stream's writes are still separate
// frames on the wire; what the block fixes is who joins the writer.
//
// Binds port 0, so it needs no port lock. Self-terminating: the client
// runs in main and the program returns normally.

use std::{errors, http, time}

fn events(_r: http::Request) -> Result<http::Response, errors::Error> {
    let body = http::ResponseStream::new()
    cohort {
        spawn(|| feed(body))
    }?
    Ok(http::Response::stream(200, "text/event-stream", body))
}

fn feed(body: http::ResponseStream) {
    let mut i = 0
    while i < 3 {
        let _ = body.write(format("data: tick {}\n\n", i))
        time::sleep(50)
        i += 1
    }
    body.close()
}

fn main() -> Result<(), errors::Error> {
    let s = http::Server::new()
    s.listen("127.0.0.1:0")?
    let addr = s.addr()
    spawn(|| run(s))
    time::sleep(300)
    match http::get(format("http://{}/events", addr), Vec::from([])) {
        Ok(r) => println("status={} bytes={}", r.status, r.body.byte_len())
        Err(e) => println("error: {}", e)
    }
    let _ = s.shutdown(1000)
    Ok(())
}

fn run(s: http::Server) { let _ = s.serve(events) }
