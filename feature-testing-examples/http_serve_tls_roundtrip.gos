// Cross-tier round-trip for `http::serve_tls` (server-side HTTPS) and
// the `TcpStream::start_tls*` client verification modes. A server leaf
// certificate (CN/SAN localhost) signed by a private CA is served by
// `serve_tls` on a goroutine; three clients then exercise each
// verification mode against it:
//
//   - `start_tls_insecure` accepts the untrusted cert and completes the
//     request (PostgreSQL `sslmode=require`).
//   - `start_tls` (verify against the public roots) rejects the
//     privately-signed cert at the handshake.
//   - `start_tls_ca` accepts the cert when handed the private CA bundle
//     (PostgreSQL `sslmode=verify-full` against a private CA).
//
// The server runs on a goroutine; `process::exit` ends the run once the
// three checks print, so the never-returning accept loop does not block
// exit. Binds a fixed loopback port, serialized under SERVER_PORT_LOCK
// by `http_serve_tls_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::net
use std::process
use std::time

const ADDR: String = "127.0.0.1:23951"

const SRV_CERT: String = "-----BEGIN CERTIFICATE-----\nMIIBwDCCAWagAwIBAgIUWn2eIEwDXkT4a1fwNgH/66ixuFEwCgYIKoZIzj0EAwIw\nGzEZMBcGA1UEAwwQR29zc2FtZXIgVGVzdCBDQTAgFw0yNjA2MTgwNTAwMDhaGA8y\nMTI2MDUyNTA1MDAwOFowFDESMBAGA1UEAwwJbG9jYWxob3N0MFkwEwYHKoZIzj0C\nAQYIKoZIzj0DAQcDQgAEIqbiF08H+XBmDeRKRU2n56xDwxX8r1pGdGDAhw4Ph5hs\nYO5BkLrbpegZ7bb5XryPTf60NAsXXobciFqNapObaqOBjDCBiTAUBgNVHREEDTAL\ngglsb2NhbGhvc3QwDAYDVR0TAQH/BAIwADATBgNVHSUEDDAKBggrBgEFBQcDATAO\nBgNVHQ8BAf8EBAMCB4AwHQYDVR0OBBYEFOWJJyEj8LfXr3xrxqFQ9HTSemK0MB8G\nA1UdIwQYMBaAFA029GI1BnVCQvR71KqUX2j3Jk7aMAoGCCqGSM49BAMCA0gAMEUC\nIQC6XN/UHJWKx8nW/uwzxpi/5YTypQROFzSIWE/uZjT+dwIgJqfB3Td3vc4i8LuX\n7e+0mbV03t7+A0vTWqUt28ARzig=\n-----END CERTIFICATE-----\n"

const SRV_KEY: String = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgFf9CnS3cqX06dFC1\nJ+YkD2NGYqJ8zO44XBSrjpm379ChRANCAAQipuIXTwf5cGYN5EpFTafnrEPDFfyv\nWkZ0YMCHDg+HmGxg7kGQutul6BnttvlevI9N/rQ0CxdehtyIWo1qk5tq\n-----END PRIVATE KEY-----\n"

const CA_CERT: String = "-----BEGIN CERTIFICATE-----\nMIIBnTCCAUOgAwIBAgIUZh9SaPyoGLl4RRZwaYvgdAktFa4wCgYIKoZIzj0EAwIw\nGzEZMBcGA1UEAwwQR29zc2FtZXIgVGVzdCBDQTAgFw0yNjA2MTgwNTAwMDhaGA8y\nMTI2MDUyNTA1MDAwOFowGzEZMBcGA1UEAwwQR29zc2FtZXIgVGVzdCBDQTBZMBMG\nByqGSM49AgEGCCqGSM49AwEHA0IABDVoT6q4aRatnSfiwCA01HKV+BvBE3+lM3nP\nMCLZqlwLO6xoP+vQGrci4IsMNP5whH9QAkc/Wlla0greWJWsmGajYzBhMB0GA1Ud\nDgQWBBQNNvRiNQZ1QkL0e9SqlF9o9yZO2jAfBgNVHSMEGDAWgBQNNvRiNQZ1QkL0\ne9SqlF9o9yZO2jAPBgNVHRMBAf8EBTADAQH/MA4GA1UdDwEB/wQEAwIBBjAKBggq\nhkjOPQQDAgNIADBFAiEA/rnXKQb63VAepo6/48PcZLlP6D1MBcPPNBwyrDYJgxQC\nIBCo0xs68Gng4hE02lkAGjebZMxPsf/pNiuioiEBrnuy\n-----END CERTIFICATE-----\n"

const REQUEST: String = "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"

struct App { }

impl http::Handler for App {
    fn serve(&self, _r: http::Request) -> http::Response {
        http::Response::text(200, "tls ok")
    }
}

fn serve() {
    if let Err(e) = http::serve_tls(&ADDR, &SRV_CERT, &SRV_KEY, App { }) {
        eprintln!("serve_tls failed: {e}")
    }
}

// Polls until the listener accepts connections; binding is async, so
// readiness is observable only by connecting (matches the plaintext
// server fixtures).
fn await_ready() {
    let mut tries = 0
    while tries < 400 {
        if let Ok(s) = net::TcpStream::connect(&ADDR) {
            let _ = s.close()
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn insecure_ok() -> bool {
    let stream = match net::TcpStream::connect(&ADDR) {
        Ok(s) => s
        Err(_) => return false
    }
    let tls = match stream.start_tls_insecure("localhost") {
        Ok(t) => t
        Err(_) => return false
    }
    let _ = tls.write(REQUEST.as_bytes())
    match tls.read(1024) {
        Ok(b) => b.len() > 0
        Err(_) => false
    }
}

fn default_rejected() -> bool {
    let stream = match net::TcpStream::connect(&ADDR) {
        Ok(s) => s
        Err(_) => return false
    }
    // `start_tls` defers the handshake to the first I/O; verification
    // against the public roots fails there, so no reply is read.
    let tls = match stream.start_tls("localhost") {
        Ok(t) => t
        Err(_) => return true
    }
    let _ = tls.write(REQUEST.as_bytes())
    match tls.read(1024) {
        Ok(b) => b.len() == 0
        Err(_) => true
    }
}

fn ca_ok() -> bool {
    let stream = match net::TcpStream::connect(&ADDR) {
        Ok(s) => s
        Err(_) => return false
    }
    let tls = match stream.start_tls_ca("localhost", &CA_CERT) {
        Ok(t) => t
        Err(_) => return false
    }
    let _ = tls.write(REQUEST.as_bytes())
    match tls.read(1024) {
        Ok(b) => b.len() > 0
        Err(_) => false
    }
}

fn main() {
    go serve()
    await_ready()
    println!("insecure: {}", if insecure_ok() { "ok" } else { "FAIL" })
    println!("default-verify: {}", if default_rejected() { "rejected" } else { "FAIL" })
    println!("custom-ca: {}", if ca_ok() { "ok" } else { "FAIL" })
    process::exit(0)
}
