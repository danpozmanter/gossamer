// The `std::iter` free functions state what they take and what they hand
// back. `unzip` splits pairs into two sequences, `empty` is a sequence of the
// element type its use expects, `flatten` needs elements that are themselves
// sequences, and `fold` / `scan` take the accumulator first with the data
// last, which is the order every call site writes.

use std::iter

fn folded(n: i64) -> i64 {
    let values = iter::collect(iter::range(1, n))
    iter::fold(0, |acc: i64, x: i64| acc + x, values)
}

fn scanned(n: i64) -> String {
    let values = iter::collect(iter::range(1, n))
    let running = iter::scan(0, |acc: i64, x: i64| acc + x, values)
    running.join(",")
}

fn split_pairs() -> String {
    let pairs = #[(1, "one"), (2, "two"), (3, "three")]
    let (numbers, names) = iter::unzip(pairs)
    format!("{} {} {}", numbers.len(), names.join("-"), numbers[2])
}

fn flattened() -> i64 {
    let nested = #[#[1, 2], #[3], #[4, 5, 6]]
    let flat = iter::flatten(nested)
    flat.len()
}

fn empty_is_the_expected_element() -> i64 {
    let none: Vec<i64> = iter::empty()
    none.len()
}

fn main() {
    let mut total = 0
    for _ in 0..200 { total = folded(10) }
    println!("fold {}", total)

    let mut text = ""
    for _ in 0..200 { text = scanned(6) }
    println!("scan {}", text)

    println!("unzip {}", split_pairs())
    println!("flatten {}", flattened())
    println!("empty {}", empty_is_the_expected_element())
}
