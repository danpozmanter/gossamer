// Comptime evaluation: `comptime { ... }` blocks and `comptime fn`
// calls are evaluated on the bytecode VM during compilation and spliced
// into the source as literals, so the bytecode VM, Cranelift JIT, and
// LLVM AOT backend all compile the identical constant.

const FOUR: i64 = 4

comptime fn cube(n: i64) -> i64 {
    n * n * n
}

comptime fn fib(n: i64) -> i64 {
    if n < 2 {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

// A const initialized from a comptime block: the recursion runs at
// compile time and the binary embeds the result, not the call.
const TABLE: i64 = comptime { fib(20) }

fn main() {
    // A comptime block folding a loop to a scalar.
    let triangular = comptime {
        let mut acc = 0
        for i in 1..=100 {
            acc += i
        }
        acc
    }
    println!("{}", triangular)

    // A bare call to a comptime fn folds at the call site.
    println!("{}", cube(5))

    // A comptime block may reference a top-level const.
    println!("{}", comptime { cube(FOUR) })

    // Const folded from a comptime block.
    println!("{}", TABLE)

    // String, float, bool, and char results all fold to literals.
    println!("{}", comptime { "compile" + &"-time" })
    println!("{:.3}", comptime { 1.0 / 8.0 })
    println!("{}", comptime { fib(10) > 50 })
    println!("{}", comptime {
        let c = 65
        c as char
    })

    // Nested comptime: the outer block subsumes the inner.
    println!("{}", comptime { comptime { cube(2) } + fib(7) })
}
