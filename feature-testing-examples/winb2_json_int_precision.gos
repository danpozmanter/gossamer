use std::encoding::json

fn main() {
    let big = json::parse("{\"b\":9007199254740993}").unwrap()
    println("{}", json::render(big))

    let mixed = json::parse("{\"a\":100,\"b\":1.5,\"c\":2.0,\"d\":-7}").unwrap()
    println("{}", json::render(mixed))

    let arr = json::parse("[1,2.0,3.5,9007199254740993]").unwrap()
    println("{}", json::render(arr))
}
