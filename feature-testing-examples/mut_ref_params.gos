// Cross-tier write-through matrix for `&mut Vec<T>` / `&mut [T]`
// parameters - the compiled tiers must mutate the caller's storage
// through the reference, not a copy: direct element write, nested
// call forwarding, early-return paths, growth via push (realloc
// must be visible to the caller), slice swap, a struct-field place
// as the argument, and a closure taking the `&mut` param.
//
// The trailing cast matrix locks the `as` conversions that share
// the same lowering surface: f32/f64 truncation toward zero, bool
// and char sources, narrow-int masking (`300 as u8`), NaN -> 0,
// and unsigned display provenance (`(0 - 1) as u64`).

fn set_first(v: &mut Vec<i64>) {
    v[0] = 99
}

fn nested(v: &mut Vec<i64>) {
    set_first(v)
    v[1] = 7
}

fn early(v: &mut Vec<i64>, stop: bool) {
    v[2] = 42
    if stop {
        return
    }
    v[2] = 43
}

fn push_one(v: &mut Vec<i64>) {
    v.push(5)
}

fn swap_ends(v: &mut [i64]) {
    let n = v.len()
    v.swap(0, n - 1)
}

struct Holder {
    data: Vec<i64>,
}

fn main() {
    let mut a: Vec<i64> = [1, 2, 3]
    set_first(&mut a)
    println!("direct: {} {} {}", a[0], a[1], a[2])

    let mut b: Vec<i64> = [0, 0, 0]
    nested(&mut b)
    println!("nested: {} {} {}", b[0], b[1], b[2])

    let mut c: Vec<i64> = [0, 0, 0]
    early(&mut c, true)
    println!("early_stop: {}", c[2])
    early(&mut c, false)
    println!("early_through: {}", c[2])

    let mut d: Vec<i64> = [1]
    push_one(&mut d)
    println!("push: len={} last={}", d.len(), d[1])

    let mut e: Vec<i64> = [10, 20, 30]
    swap_ends(&mut e)
    println!("swap: {} {} {}", e[0], e[1], e[2])

    let mut h = Holder { data: [0, 0] }
    set_first(&mut h.data)
    println!("field: {}", h.data[0])

    let mut f: Vec<i64> = [1, 2, 3]
    let bump = |v: &mut Vec<i64>| { v[0] = 77 }
    bump(&mut f)
    println!("closure: {}", f[0])

    let single: f32 = 3.9
    println!("cast_f32: {}", single as i64)
    println!("cast_bool: {}", true as i64)
    println!("cast_char: {}", 'A' as u8)
    println!("cast_mask: {}", 300 as u8)
    let nan = 0.0 / 0.0
    println!("cast_nan: {}", nan as i64)
    println!("cast_u64: {}", (0 - 1) as u64)
}
