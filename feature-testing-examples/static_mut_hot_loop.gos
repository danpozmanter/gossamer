// `static mut` scalar load/store lowered natively by the Cranelift JIT/AOT
// backend. Previously any `static mut` access declined the body to the VM,
// which poisoned whole-module JIT: a hot loop sharing a module with a
// static-mut'd LCG ran entirely interpreted. Here `next` reads and writes the
// seed through the shared backing cell while `main`'s loop is JIT-promoted, so
// the compiled cell and the VM cell must agree bit-for-bit across VM /
// Cranelift / LLVM.

static mut SEED: i64 = 123456789

fn next() -> i64 {
    // Keep the arithmetic in range so this JIT fixture is independent of the
    // debug-checked versus release-wrapping profile contract.
    SEED = (SEED * 48271 + 1) % 2147483647
    SEED
}

fn main() {
    let mut acc: i64 = 0
    for _ in 0..2000000 {
        acc = (acc + next() % 1000) % 1000000007
    }
    println!("{}", acc)
}
