// Cross-tier regression for the test surface: a handler called in memory,
// and a wall clock a test controls.
//
// `httptest::record` runs a handler without a socket, a port, or an accept
// loop - a handler is a function from a request to a response, and a test
// that only wants to know what it answers should not have to run a server
// to find out. `time::freeze` / `advance` / `unfreeze` pin what the program
// is told the time is, so anything time-dependent - a token's expiry, a
// rate-limit window, a cache's TTL - is decided rather than waited for.

use std::errors
use std::http
use std::httptest
use std::time

fn greet(r: http::Request) -> Result<http::Response, errors::Error> {
    Ok(http::Response::text(200, format!("{} {} body={}", r.method, r.path, r.body)))
}

fn expiring(r: http::Request) -> Result<http::Response, errors::Error> {
    // Reads the clock the test controls, so "expired" is a decision rather
    // than a wait.
    if time::now_ms() >= 2_000_000 {
        Ok(http::Response::text(401, "expired"))
    } else {
        Ok(http::Response::text(200, format!("valid for {}", r.path)))
    }
}

fn main() {
    match httptest::record(greet, "POST", "/hello", "hi") {
        Ok(r) => println!("recorded status={} body={}", r.status, r.body)
        Err(e) => println!("recorded error: {}", e)
    }

    time::freeze(1_000_000)
    println!("frozen={} now={}", time::is_frozen(), time::now_ms())
    match httptest::record(expiring, "GET", "/token", "") {
        Ok(r) => println!("before status={} body={}", r.status, r.body)
        Err(e) => println!("before error: {}", e)
    }

    println!("advanced={}", time::advance(1_500_000))
    match httptest::record(expiring, "GET", "/token", "") {
        Ok(r) => println!("after status={} body={}", r.status, r.body)
        Err(e) => println!("after error: {}", e)
    }

    time::unfreeze()
    println!("frozen={}", time::is_frozen())
}
