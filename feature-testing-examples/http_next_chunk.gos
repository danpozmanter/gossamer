// Cross-tier coverage for `ResponseStream::next_chunk(max)`: the
// streaming HTTP client's byte-chunk reader returns
// `Option<[u8]>` whose Some payload is a PACKED `elem_bytes=1`
// GosVec (the `raw_bytes` representation contract), so every
// consumer surface must be stride-aware. The fixture drains a
// 10-byte body in 4-byte chunks through the canonical
// `while let Some(chunk)` shape and exercises len, indexing,
// for-loop byte sum, and a real std byte consumer (hex::encode).
//
// Body "Aÿ™zABC" = 41 C3 BF E2 84 A2 7A 41 42 43 (10 bytes;
// values above 0x7F catch sign-extension and word-stride bugs).
// Chunks: 41c3bfe2 / 84a27a41 / 4243 - byte sum 1291.
//
// Self-terminating: the client runs in main and exits explicitly.
// Binds a fixed loopback port - serialized under SERVER_PORT_LOCK
// by `http_next_chunk_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::encoding
use std::http
use std::process
use std::time

struct App { }

impl http::Handler for App {
    fn serve(&self, _r: http::Request) -> Result<http::Response, http::Error> {
        Ok(http::Response::text(200, "Aÿ™zABC"))
    }
}

fn run_server() {
    if let Err(e) = http::serve("127.0.0.1:23876", App { }) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go run_server()
    await_ready(&"http://127.0.0.1:23876/chunks")
    match http::stream("GET", "http://127.0.0.1:23876/chunks", "", Vec::from([])) {
        Ok(s) => {
            let mut total = 0
            let mut sum = 0
            while let Some(chunk) = s.next_chunk(4) {
                println!(
                    "len={} b0={} hex={}"
                    chunk.len()
                    chunk[0]
                    encoding::hex::encode(chunk)
                )
                total += chunk.len()
                for b in chunk { sum += b as i64 }
            }
            println!("total={} sum={}", total, sum)
        }
        Err(e) => println!("error: {}", e)
    }
    process::exit(0)
}
