// `html::template::render_json(source, json_data)` renders a
// context-aware HTML template against a JSON data context, escaping
// each substitution by where it lands: HTML text, a quoted attribute,
// a URL attribute, or a `<script>` body. The renderer lives in the
// leaf `gossamer-template` crate so the compiled tier calls it
// directly; output is bit-identical across VM / Cranelift / LLVM.

use std::html

fn main() {
    let tpl = "<p>{{ .name }}</p> <a href=\"{{ .link }}\">x</a> <input value=\"{{ .attr }}\"> <script>var m={{ .msg }}</script>"
    let data = "{\"name\":\"<b>\",\"link\":\"javascript:x\",\"attr\":\"a&b\",\"msg\":\"</script>\"}"
    match html::template::render_json(tpl, data) {
        Ok(out) => {
            println!("{}", out)
            // Text context: angle brackets HTML-escaped.
            assert(out.contains("&lt;b&gt;"), "text context escaped")
            // URL context: the javascript: scheme is neutralised to '#'.
            assert(out.contains("href=\"#\""), "url scheme blocked")
            assert(!out.contains("javascript:"), "no javascript scheme survives")
            // Quoted-attribute context: ampersand entity-escaped.
            assert(out.contains("value=\"a&amp;b\""), "attr context escaped")
            // JS context: the </script> breakout is unicode-escaped
            // (the `<` form contains the marker "u003c").
            assert(out.contains("u003c"), "js context unicode-escaped")
            assert(!out.contains("var m=</script>"), "no raw script breakout")
        }
        Err(e) => panic!("render_json failed: {}", e),
    }
    println!("ok")
}
