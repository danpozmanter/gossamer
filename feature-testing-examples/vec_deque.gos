use std::collections::Deque

fn main() {
    let mut q = Deque::new()
    q.push_back(1)
    q.push_back(2)
    q.push_back(3)

    println("len: {}", q.len())
    println("empty: {}", q.is_empty())

    while let Some(v) = q.pop_front() {
        println("got {}", v)
    }

    println("empty after drain: {}", q.is_empty())
}
