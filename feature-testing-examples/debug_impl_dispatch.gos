// `Display` and `Debug` are distinct contracts: `{}` answers through a type's
// `impl Display` and `{:?}` through its `impl Debug`, each declaring `fn fmt`.
// A type implementing one keeps the synthesized rendering on the other
// channel, at the top level and inside a container, tuple, `Option`, or
// struct field.

struct Shown {
    id: i64
}

impl Display for Shown {
    fn fmt(&self) -> String {
        format("S<{}>", self.id)
    }
}

struct Dumped {
    id: i64
}

impl Debug for Dumped {
    fn fmt(&self) -> String {
        format("D<{}>", self.id)
    }
}

struct Both {
    id: i64
}

impl Display for Both {
    fn fmt(&self) -> String {
        format("B-show-{}", self.id)
    }
}

impl Debug for Both {
    fn fmt(&self) -> String {
        format("B-dump-{}", self.id)
    }
}

enum Marked {
    Numbered(i64)
    Blank
}

impl Display for Marked {
    fn fmt(&self) -> String {
        match self {
            Marked::Numbered(n) => format("m{}", n)
            Marked::Blank => "m-"
        }
    }
}

fn main() {
    let shown = Shown { id: 1 }
    println("{}", shown)
    println("{:?}", shown)

    let dumped = Dumped { id: 2 }
    println("{}", dumped)
    println("{:?}", dumped)

    let both = Both { id: 3 }
    println("{}", both)
    println("{:?}", both)

    println("{}", shown.to_string())
    println("{}", format("{}", both))
    println("{}", format("{:?}", both))

    let shows: Vec<Shown> = #[Shown { id: 4 }, Shown { id: 5 }]
    println("{}", shows)
    println("{:?}", shows)

    let boths: Vec<Both> = #[Both { id: 6 }]
    println("{}", boths)
    println("{:?}", boths)

    println("{}", Some(Both { id: 7 }))
    println("{:?}", Some(Both { id: 7 }))
    println("{}", (Both { id: 8 }, 9))
    println("{:?}", (Both { id: 8 }, 9))

    println("{}", Marked::Numbered(10))
    println("{:?}", Marked::Numbered(10))
    println("{}", Marked::Blank)
    println("{:?}", Marked::Blank)
}
