// Cross-tier parity for std::http::session - the SignedCookieStore
// SignedOnly wire format. sign frames a JSON payload as
// base64url(payload).base64url(hmac(key, base64url(payload))); the
// signature is computed over the base64url payload string, exactly as
// the store does. Unlike CSRF, signing is deterministic (no nonce),
// so the exact cookie string is asserted and is bit-identical across
// the bytecode VM, Cranelift, and LLVM. verify validates the HMAC and
// returns the decoded JSON; a wrong key is rejected.

use std::http

fn main() {
    let key: Vec<u8> = Vec::from([1, 2, 3, 4, 5, 6, 7, 8])
    let payload = "{\"user\":\"ada\",\"id\":7}"

    let cookie = http::session::sign(payload, key)
    println!("cookie: {}", cookie)

    match http::session::verify(cookie, key) {
        Ok(data) => println!("verify: {}", data)
        Err(_) => println!("verify: err")
    }

    let wrong: Vec<u8> = Vec::from([9, 9, 9, 9, 9, 9, 9, 9])
    match http::session::verify(cookie, wrong) {
        Ok(_) => println!("wrongkey: ok")
        Err(_) => println!("wrongkey: err")
    }
}
