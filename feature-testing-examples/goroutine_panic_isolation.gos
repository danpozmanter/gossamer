// Goroutine Result Aggregation
// Each goroutine computes an independent result and sends it
// back via a channel - demonstrating the pattern where goroutine
// failures (Result::Err) do not crash the coordinator.

use std::sync::channel
use std::time

fn safe_divide(a: i64, b: i64, tx: channel::Sender<i64>) {
    if b == 0 {
        tx.send(-1)
    } else {
        tx.send(a / b)
    }
}

fn compute_squares(start: i64, end: i64, tx: channel::Sender<i64>) {
    let mut sum = 0
    for i in start..end {
        sum += i * i
    }
    tx.send(sum)
}

fn main() {
    // Fan-out: safe_divide results
    let tx, rx = channel()
    spawn(|| safe_divide(100, 4, tx))
    spawn(|| safe_divide(50, 0, tx))
    spawn(|| safe_divide(81, 9, tx))
    time::sleep(30)

    let mut results: Vec<i64> = Vec::from([])
    for _ in 0..3 {
        if let Some(v) = rx.recv() {
            results.push(v)
        }
    }
    println("result count = {}", results.len())

    // Fan-out: parallel range sums of squares
    let tx2, rx2 = channel()
    spawn(|| compute_squares(0, 5, tx2))
    spawn(|| compute_squares(5, 10, tx2))
    spawn(|| compute_squares(10, 15, tx2))
    time::sleep(30)

    let mut total = 0
    for _ in 0..3 {
        if let Some(v) = rx2.recv() {
            total += v
        }
    }
    // sum of 0^2..14^2 = 0+1+4+9+...+196 = 1015
    println("total squares 0..15 = {}", total)

    // Pipeline: producer → transformer → sink
    let raw_tx, raw_rx = channel()
    let proc_tx, proc_rx = channel()

    spawn(|| safe_divide(200, 4, raw_tx))
    spawn(|| safe_divide(300, 6, raw_tx))
    time::sleep(20)

    // Transformer reads from raw_rx, sends to proc_tx
    let mut transformed: Vec<i64> = Vec::from([])
    for _ in 0..2 {
        if let Some(v) = raw_rx.recv() {
            transformed.push(v * 2)
        }
    }
    println("transformed count = {}", transformed.len())
}

#[cfg(test)]
mod tests {
    use std::sync::channel
    use std::testing

    #[test]
    fn goroutine_sends_result() {
        let tx, rx = channel()
        // The channel is unbuffered, so the child's send completes only once
        // the read below takes the value: both belong to the block, which is
        // not left until the child has finished.
        let _ = cohort {
            spawn(|| super::safe_divide(42, 6, tx))
            match rx.recv() {
                Some(v) => { let _ = testing::check_eq(v, 7, "42/6=7")
                }
                None => { let _ = testing::check(false, "expected result")
                }
            }
        }
    }

    #[test]
    fn goroutine_division_by_zero_sentinel() {
        let tx, rx = channel()
        let _ = cohort {
            spawn(|| super::safe_divide(10, 0, tx))
            match rx.recv() {
                Some(v) => { let _ = testing::check_eq(v, -1, "div by zero sentinel")
                }
                None => { let _ = testing::check(false, "expected result")
                }
            }
        }
    }

    #[test]
    fn parallel_sum_of_squares() {
        let tx, rx = channel()
        let mut total = 0
        let _ = cohort {
            spawn(|| super::compute_squares(0, 5, tx))
            spawn(|| super::compute_squares(5, 10, tx))
            for _ in 0..2 {
                if let Some(v) = rx.recv() {
                    total += v
                }
            }
        }
        // 0+1+4+9+16 + 25+36+49+64+81 = 30+255 = 285
        let _ = testing::check_eq(total, 285, "sum squares 0..10")
    }
}
