use std::utf8

fn main() {
    let ascii = "hello"
    let multi = "héllo你"
    let emoji = "😀"
    let blank = ""

    // rune_count_in_string
    println!("count-ascii = {}", utf8::rune_count_in_string(ascii))
    println!("count-multi = {}", utf8::rune_count_in_string(multi))
    println!("count-emoji = {}", utf8::rune_count_in_string(emoji))
    println!("count-empty = {}", utf8::rune_count_in_string(blank))

    // valid_string
    println!("valid-multi = {}", utf8::valid_string(multi))
    println!("valid-empty = {}", utf8::valid_string(blank))

    // valid_rune (codepoint argument)
    println!("valid_rune-A = {}", utf8::valid_rune(65))
    println!("valid_rune-surrogate = {}", utf8::valid_rune(0xD800))
    println!("valid_rune-max = {}", utf8::valid_rune(0x10FFFF))
    println!("valid_rune-oob = {}", utf8::valid_rune(0x110000))

    // rune_len (codepoint argument)
    println!("rune_len-a = {}", utf8::rune_len(97))
    println!("rune_len-eacute = {}", utf8::rune_len(0xE9))
    println!("rune_len-cjk = {}", utf8::rune_len(0x4F60))
    println!("rune_len-emoji = {}", utf8::rune_len(0x1F600))
    println!("rune_len-surrogate = {}", utf8::rune_len(0xD800))

    // rune_start (byte argument)
    println!("rune_start-a = {}", utf8::rune_start(97))
    println!("rune_start-cont = {}", utf8::rune_start(0x80))
    println!("rune_start-lead = {}", utf8::rune_start(0xE4))

    // full_rune_in_string
    println!("full_rune-ascii = {}", utf8::full_rune_in_string(ascii))
    println!("full_rune-empty = {}", utf8::full_rune_in_string(blank))
    println!("full_rune-multi = {}", utf8::full_rune_in_string(multi))

    // decode_rune_in_string -> (char, width)
    let (c1, w1) = utf8::decode_rune_in_string(multi)
    println!("decode_first = U+{:04X} width {}", c1 as i64, w1)
    let (c2, w2) = utf8::decode_rune_in_string(emoji)
    println!("decode_emoji = U+{:04X} width {}", c2 as i64, w2)
    let (c3, w3) = utf8::decode_rune_in_string(blank)
    println!("decode_empty = U+{:04X} width {}", c3 as i64, w3)

    // decode_last_rune_in_string -> (char, width)
    let (l1, lw1) = utf8::decode_last_rune_in_string(multi)
    println!("decode_last = U+{:04X} width {}", l1 as i64, lw1)
    let (l2, lw2) = utf8::decode_last_rune_in_string(ascii)
    println!("decode_last_ascii = U+{:04X} width {}", l2 as i64, lw2)
}
