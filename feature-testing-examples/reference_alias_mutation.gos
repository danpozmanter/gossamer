// Reference Alias Mutation
// Pass &T and &mut T through helper functions and verify aliased reads
// and array-element mutation work consistently across all tiers.

struct Counter {
    value: i64,
}

fn inspect(c: &Counter) -> i64 {
    c.value
}

fn increment(c: &mut Counter) {
    c.value += 1
}

fn reset(c: &mut Counter) {
    c.value = 0
}

fn alias_test() {
    let a = Counter(10)

    // Read-only reference: inspect just reads the value.
    let via_ref = inspect(&a)
    println!("via inspect: {}", via_ref)

    // Direct read: no aliasing, just field access.
    println!("direct read: {}", a.value)
}

fn array_alias() {
    let mut arr: [i64] = [1, 2, 3, 4, 5]
    let first_val = arr[0]
    arr[4] += first_val
    println!("last after += first: {}", arr[4])
}

fn main() {
    alias_test()
    array_alias()
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn inspect_reads_value() {
        let c = super::Counter(42)
        let _ = testing::check_eq(&super::inspect(&c), &42, "inspect returns value")
    }

    #[test]
    fn increment_adds_one() {
        let mut c = super::Counter(0)
        super::increment(&mut c)
        let _ = testing::check_eq(&c.value, &1, "increment from 0 → 1")
        super::increment(&mut c)
        let _ = testing::check_eq(&c.value, &2, "increment from 1 → 2")
    }

    #[test]
    fn reset_zeroes_value() {
        let mut c = super::Counter(99)
        super::reset(&mut c)
        let _ = testing::check_eq(&c.value, &0, "reset → 0")
    }
}
