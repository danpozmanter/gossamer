// A `u64` reaching a function that takes one.
//
// An unsigned expression carries its own value representation, so a reader that
// recognises only the signed one sees nothing where a `u64` was passed, and a
// silent default then answers for a value the program did supply. The bit
// pattern of a float is the case where that is loudest: the answer is zero
// rather than the number.
//
// The conversions run in a loop so the body carrying them is one the compiled
// tiers answer for, rather than one the interpreter stands in for.

use std::encoding::binary

fn main() {
    let v: f64 = 2.5
    let signed: i64 = v.to_bits() as i64
    let widened: u64 = signed as u64
    let mut buf: Vec<u8> = #[]
    buf.extend(binary::put_u64_le(#[], signed))
    let read = match binary::get_u64_le_at(buf, 0) {
        Ok(bits) => bits
        Err(_) => 0u64
    }
    let w: f32 = 1.25

    // The same pattern four ways: straight off `to_bits`, cast in the call
    // itself, through a binding the cast produced, and as a buffer hands it
    // over. At single width too, which reads its own way.
    let mut a: f64 = 0.0
    let mut b: f64 = 0.0
    let mut c: f64 = 0.0
    let mut d: f64 = 0.0
    let mut e: f32 = 0.0
    for _i in 0..64 {
        a = f64::from_bits(v.to_bits())
        b = f64::from_bits(signed as u64)
        c = f64::from_bits(widened)
        d = f64::from_bits(read)
        e = f32::from_bits(w.to_bits())
    }
    println("direct   {}", a)
    println("in call  {}", b)
    println("bound    {}", c)
    println("buffer   {}", d)
    println("f32      {}", e)
}
