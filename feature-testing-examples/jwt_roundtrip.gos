// Cross-tier parity for std::jwt via the struct-marshalling-free
// JSON-string entry API. HS256 and EdDSA use fixed keys, so their
// tokens are fully deterministic and must be byte-identical across the
// bytecode VM, Cranelift, and LLVM tiers. ES256 uses a fresh P-256
// keypair, so only the (deterministic) recovered claims are printed.
use std::jwt
use std::crypto

fn main() {
    let key: [u8] = [115, 101, 99, 114, 101, 116]
    let claims = "{\"iss\":\"acme\",\"sub\":\"user-1\"}"

    // HS256 - fixed shared key + claims => deterministic token.
    match jwt::sign_hs("HS256", claims, key) {
        Ok(tok) => {
            println!("hs256_token={}", tok)
            match jwt::verify_hs(tok, "HS256", key, 0) {
                Ok(c) => println!("hs256_claims={}", c),
                Err(e) => println!("hs256_verify_err={}", e),
            }
        }
        Err(e) => println!("hs256_sign_err={}", e),
    }

    // ES256 - fresh P-256 keypair => deterministic recovered claims.
    match crypto::ecdsa::keypair_pem() {
        Ok((sk, pk)) => {
            match jwt::sign_es256(claims, sk) {
                Ok(tok) => {
                    match jwt::verify_es256(tok, pk, 0) {
                        Ok(c) => println!("es256_claims={}", c),
                        Err(e) => println!("es256_verify_err={}", e),
                    }
                }
                Err(e) => println!("es256_sign_err={}", e),
            }
        }
        Err(e) => println!("es256_keypair_err={}", e),
    }

    // EdDSA - fixed Ed25519 PKCS#8 key => deterministic token.
    let ed_sk = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIMGzpz4MfnWb0FMmthtTT6IvBH4n4ti0EFayz8iMovlD\n-----END PRIVATE KEY-----\n"
    let ed_pk = "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAsuvIaeV3DijvbULaAq61hm4Ck1ojibsg77DHehjqlAo=\n-----END PUBLIC KEY-----\n"
    match jwt::sign_eddsa(claims, ed_sk) {
        Ok(tok) => {
            println!("eddsa_token={}", tok)
            match jwt::verify_eddsa(tok, ed_pk, 0) {
                Ok(c) => println!("eddsa_claims={}", c),
                Err(e) => println!("eddsa_verify_err={}", e),
            }
        }
        Err(e) => println!("eddsa_sign_err={}", e),
    }
}
