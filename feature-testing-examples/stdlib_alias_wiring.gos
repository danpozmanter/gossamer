// Deprecated-but-callable aliases that previously had no compiled
// dispatch: os::home, os::set_cwd, thread::sleep_ms, fs::mkdir,
// fs::mkdir_all, fs::read_file, path::walk. Each routes to the same
// runtime shim as its canonical spelling, so the output is identical
// to the canonical form across every tier.

use std::env
use std::fs
use std::os
use std::path
use std::thread

fn main() {
    // os::home == env::home_dir (Option<String>).
    match os::home() {
        Some(h) => println!("home_nonempty={}", h.len() > 0),
        None => println!("home_nonempty=false"),
    }

    thread::sleep_ms(1)
    println!("slept=true")

    let dir = path::join(&env::temp_dir(), &"gossamer-alias-demo")
    let _ = fs::remove_all(&dir)
    let nested = path::join(&dir, &"a")
    match fs::mkdir_all(&nested) {
        Ok(_) => println!("mkdir_all_ok=true"),
        Err(e) => println!("mkdir_all_err={}", e),
    }

    let file = path::join(&dir, &"data.bin")
    let _ = fs::write(&file, &"abc")
    let bytes = fs::read_file(&file).unwrap()
    println!("read_file_len={}", bytes.len())

    match os::set_cwd(&dir) {
        Ok(_) => println!("set_cwd_ok=true"),
        Err(e) => println!("set_cwd_err={}", e),
    }

    let entries = path::walk(&dir).unwrap()
    println!("walk_nonempty={}", entries.len() > 0)

    let _ = fs::remove_all(&dir)
}
