// Canonical stdlib namespace wiring across tiers.

use std::env
use std::fs
use std::path

fn main() {
    match env::home_dir() {
        Some(h) => println!("home_nonempty={}", h.len() > 0),
        None => println!("home_nonempty=false"),
    }

    let dir = path::join(&env::temp_dir(), &"gossamer-alias-demo")
    let _ = fs::remove_dir_all(&dir)
    let nested = path::join(&dir, &"a")
    match fs::create_dir_all(&nested) {
        Ok(_) => println!("mkdir_all_ok=true"),
        Err(e) => println!("mkdir_all_err={}", e),
    }

    let file = path::join(&dir, &"data.bin")
    let _ = fs::write(&file, &"abc")
    let bytes = fs::read(&file).unwrap()
    println!("read_file_len={}", bytes.len())

    match env::set_current_dir(&dir) {
        Ok(_) => println!("set_cwd_ok=true"),
        Err(e) => println!("set_cwd_err={}", e),
    }

    let entries = path::walk(&dir).unwrap()
    println!("walk_nonempty={}", entries.len() > 0)

    let _ = fs::remove_dir_all(&dir)
}
