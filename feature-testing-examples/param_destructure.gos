// Pattern destructuring in function parameters: tuple, struct, and
// tuple-struct patterns bind their components at the call boundary,
// lowering to a fresh local plus a destructuring `let` on every tier.

struct Point { x: i64, y: i64 }
struct Pair { left: i64, right: i64 }

fn tup((a, b): (i64, i64)) -> i64 { a * b }
fn named(Point { x, y }: Point) -> i64 { x + y }
fn pair(Pair { left, right }: Pair) -> i64 { left - right }
fn nested((Point { x, y }, k): (Point, i64)) -> i64 { x + y + k }

fn main() {
    println!("{}", tup((6, 7)))
    println!("{}", named(Point { x: 3, y: 4 }))
    println!("{}", pair(Pair { left: 20, right: 5 }))
    println!("{}", nested((Point { x: 1, y: 2 }, 10)))
}
