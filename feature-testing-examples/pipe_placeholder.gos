// `|>` composes free functions, which have no receiver to chain from. A step
// is a bare callable, or a call that names the piped value's slot with `$`.
// A pure parse-time desugar, so it runs identically on the VM, Cranelift, and
// LLVM tiers:
//
//   x |> f            => f(x)
//   x |> f(a, $)      => f(a, x)
//   x |> f($, a)      => f(x, a)
//   x |> |v| v + 1    => the closure applied to x
//
// A method already chains, and a chain can feed a pipe.

use std::iter
use std::strings

struct Point {
    x: i64
    y: i64
}

fn label(p: Point) -> String {
    format!("{},{}", p.x, p.y)
}

fn shout(s: String) -> String {
    s + "!"
}

fn scale(factor: i64, n: i64) -> i64 {
    n * factor
}

fn main() {
    // a bare callable takes the value as its only argument
    println!("{}", "hi" |> shout)

    // a method chain feeds a pipe; the chain is the shorter spelling
    println!("{}", "  Ab  ".trim().to_lowercase() |> shout)

    // `$` names the slot, so a data-first callee reads like a data-last one
    println!("{}", 3 |> scale(10, $))
    match "world" |> strings::slice($, 1, 4) {
        Ok(part) => println!("{}", part)
        Err(_) => println!("slice failed")
    }

    // a format macro takes the value through the same explicit slot
    println!("{}", "world" |> format!("hello, {}", $))

    // data-last `iter::` steps name the slot too, and the result chains
    let evens = #[1, 2, 3, 4, 5, 6] |> iter::filter(|x: i64| x % 2 == 0, $).len()
    println!("{}", evens)

    // a bare callable takes a struct the same way it takes a scalar
    println!("{}", Point { x: 7, y: 9 } |> label)
}

#[cfg(test)]
mod pipe_placeholder_tests {
    use std::iter
    use std::strings
    use std::testing

    #[test]
    fn bare_callable_step() {
        let _ = testing::check(("hi" |> super::shout) == "hi!", "x |> f is f(x)")
    }

    #[test]
    fn method_chain_feeds_a_pipe() {
        let piped = "  Ab  ".trim().to_lowercase() |> super::shout
        let _ = testing::check(piped == "ab!", "a chain is an ordinary pipe operand")
    }

    #[test]
    fn placeholder_names_the_trailing_slot() {
        let _ = testing::check((3 |> super::scale(10, $)) == 30, "x |> f(a, $) is f(a, x)")
    }

    #[test]
    fn placeholder_names_a_leading_slot() {
        match "world" |> strings::slice($, 1, 4) {
            Ok(part) => {
                let _ = testing::check(part == "orl", "x |> f($, a) is f(x, a)")
            }
            Err(_) => {
                let _ = testing::check(false, "slice should succeed")
            }
        }
    }

    #[test]
    fn format_argument_receives_the_value() {
        let greeting = "world" |> format!("hello, {}", $)
        let _ = testing::check(greeting == "hello, world", "a macro slot is named too")
    }

    #[test]
    fn mixed_with_iter() {
        let n = #[1, 2, 3, 4] |> iter::filter(|x: i64| x % 2 == 0, $).len()
        let _ = testing::check(n == 2, "an iter step chains into a method")
    }
}
