// Struct / tuple values as HashMap and HashSet keys. The VM keys aggregates by
// value (recursively); the compiled tiers key by the aggregate's content (via a
// per-slot layout descriptor that dereferences `String` fields), so two equal
// values at distinct allocations share a slot on every tier - flat structs,
// `String`-field structs, nested structs, and tuples alike.

use std::collections::HashMap
use std::collections::HashSet

#[derive(Clone, PartialEq, Eq, Hash, Debug)]
struct Point { x: i64, y: i64 }

#[derive(Clone, PartialEq, Eq, Hash, Debug)]
struct User { name: String, id: i64 }

#[derive(Clone, PartialEq, Eq, Hash, Debug)]
struct Cell { at: Point, label: String }

fn get_or(m: &HashMap<Point, i64>, k: &Point) -> i64 {
    match m.get(k) {
        Some(v) => v,
        None => -1,
    }
}

// Length after inserting two equal-valued keys (one slot) - for the tests,
// which can't name `super::Point` inside a generic argument.
fn equal_keys_len() -> i64 {
    let mut m: HashMap<Point, i64> = HashMap::new()
    m.insert(Point { x: 1, y: 2 }, 1)
    m.insert(Point { x: 1, y: 2 }, 2)
    m.len()
}

// Length after inserting two distinct keys (two slots).
fn distinct_keys_len() -> i64 {
    let mut m: HashMap<Point, i64> = HashMap::new()
    m.insert(Point { x: 1, y: 2 }, 1)
    m.insert(Point { x: 2, y: 1 }, 2)
    m.len()
}

fn main() {
    // Flat struct keys: distinct allocations of an equal value collide; a
    // re-inserted key overwrites; a distinct key is a distinct slot.
    let mut m: HashMap<Point, i64> = HashMap::new()
    m.insert(Point { x: 1, y: 2 }, 10)
    m.insert(Point { x: 3, y: 4 }, 20)
    m.insert(Point { x: 1, y: 2 }, 99)
    println!("{}", get_or(&m, &Point { x: 1, y: 2 }))
    println!("{}", get_or(&m, &Point { x: 9, y: 9 }))
    println!("len {}", m.len())

    // String-field struct key.
    let mut um: HashMap<User, i64> = HashMap::new()
    um.insert(User { name: "ada", id: 1 }, 100)
    um.insert(User { name: "bob", id: 2 }, 200)
    let ada = User { name: "ada", id: 1 }
    println!("{}", match um.get(&ada) { Some(v) => v, None => -1 })
    println!("ulen {}", um.len())

    // Nested-struct + String key.
    let mut cm: HashMap<Cell, i64> = HashMap::new()
    cm.insert(Cell { at: Point { x: 5, y: 6 }, label: "home" }, 7)
    let c = Cell { at: Point { x: 5, y: 6 }, label: "home" }
    println!("{}", match cm.get(&c) { Some(v) => v, None => -1 })

    // Tuple key.
    let mut tm: HashMap<(i64, i64), String> = HashMap::new()
    tm.insert((1, 2), "pair")
    let tk = (1, 2)
    println!("{}", match tm.get(&tk) { Some(v) => v, None => "none" })

    // HashSet of structs.
    let mut seen: HashSet<Point> = HashSet::new()
    seen.insert(Point { x: 0, y: 0 })
    seen.insert(Point { x: 0, y: 0 })
    println!("has {}", seen.contains(&Point { x: 0, y: 0 }))
    println!("hasnt {}", seen.contains(&Point { x: 1, y: 1 }))
    println!("slen {}", seen.len())
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn equal_struct_keys_collide() {
        testing::check(super::equal_keys_len() == 1, "an equal-valued key overwrites")
    }

    #[test]
    fn distinct_struct_keys_separate() {
        testing::check(super::distinct_keys_len() == 2, "distinct keys are distinct slots")
    }
}
