// Cross-tier regression for the bare HTTP free-function aliases:
// `native_client::{get,post,put,delete}`, `proxy::forward`, and
// `static_files::serve_file`. Each was interp-only (the canonical
// compiled shims were unwired or, for `native_client::get`, mapped with
// the wrong arity). They now lower to dedicated `gos_rt_*` shims so the
// bytecode VM (`gos run`) and LLVM AOT (`gos build`) behave identically.
//
// `native_client` + `proxy::forward` issue one-shot requests against an
// in-process echo server; `static_files::serve_file` reads a temp file
// into a 200 Response.
//
// Self-terminating: the client runs in main and exits explicitly, so
// the run is a plain stdout-parity comparison. Binds a fixed loopback
// port, serialized under SERVER_PORT_LOCK by
// `http_bare_aliases_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::env
use std::fs
use std::http
use std::http::native_client
use std::http::proxy
use std::http::static_files
use std::path
use std::process
use std::time

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> http::Response {
        http::Response::text(200, "m=" + &r.method + " b=" + &r.body)
    }
}

fn serve_app() {
    if let Err(e) = http::serve("127.0.0.1:23914", App { }) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, []) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go serve_app()
    let url = "http://127.0.0.1:23914/x"
    await_ready(&url)

    match native_client::get(&url) {
        Ok(r) => println!("nc_get status={} body={}", r.status, r.body),
        Err(e) => println!("nc_get error: {}", e),
    }
    match native_client::post(&url, "p", "text/plain") {
        Ok(r) => println!("nc_post status={} body={}", r.status, r.body),
        Err(e) => println!("nc_post error: {}", e),
    }
    match native_client::put(&url, "q", "text/plain") {
        Ok(r) => println!("nc_put status={} body={}", r.status, r.body),
        Err(e) => println!("nc_put error: {}", e),
    }
    match native_client::delete(&url) {
        Ok(r) => println!("nc_delete status={} body={}", r.status, r.body),
        Err(e) => println!("nc_delete error: {}", e),
    }

    match proxy::forward(&url, "GET", "") {
        Ok(r) => println!("proxy_get status={} body={}", r.status, r.body),
        Err(e) => println!("proxy_get error: {}", e),
    }
    match proxy::forward(&url, "POST", "fwd") {
        Ok(r) => println!("proxy_post status={} body={}", r.status, r.body),
        Err(e) => println!("proxy_post error: {}", e),
    }

    let file = path::join(&env::temp_dir(), &"gossamer_serve_file_fixture.txt")
    let _ = fs::write(&file, "served-from-disk")
    match static_files::serve_file(&file) {
        Ok(r) => println!("serve_file status={} body={}", r.status, r.body),
        Err(e) => println!("serve_file error: {}", e),
    }
    let _ = fs::remove_dir_all(&file)

    process::exit(0)
}
