// Destructuring a tuple-returning allocator must be correct on every tier
// in both shapes the compiler can take:
//
//  (1) An eligible loop body is auto-regioned. `let (tree, next) = build(..)`
//      registers BOTH destructured names as body-local, so the heap tree
//      lives in the iteration's arena and is bulk-freed at the back-edge.
//  (2) A function-scope destructure is NOT regioned, so the drop pass owns
//      the tuple per-field: the RC `Tree` element is retained at the field
//      extract and released when the binding dies. The `i64` element and any
//      `Result`/`Option` element are by-value and never RC-accounted.
//
// Both paths must produce identical output under `gos run` and `gos build`.

enum Tree {
    Leaf(i64),
    Node(Box<Tree>, Box<Tree>),
}

fn build(depth: i64, seed: i64) -> (Tree, i64) {
    if depth == 0 {
        (Tree::Leaf(seed % 100), seed * 6364136223846793005 + 1)
    } else {
        let (l, s1) = build(depth - 1, seed)
        let (r, s2) = build(depth - 1, s1)
        (Tree::Node(Box::new(l), Box::new(r)), s2 + 1)
    }
}

fn sum(t: &Tree) -> i64 {
    match t {
        Tree::Leaf(v) => *v,
        Tree::Node(l, r) => sum(l) + sum(r),
    }
}

// Function-scope destructure: `tree` dies here, so the per-field tuple
// teardown is what releases its heap nodes (no leak, no premature free).
fn fold_round(seed: i64) -> i64 {
    let (tree, next_seed) = build(4, seed)
    sum(&tree) + (next_seed % 7)
}

fn main() {
    // (1) Regioned loop: build / fold / discard each round.
    let mut seed: i64 = 12345
    let mut acc: i64 = 0
    let mut i: i64 = 0
    while i < 100 {
        let (tree, next_seed) = build(6, seed)
        seed = next_seed
        acc += sum(&tree)
        i += 1
    }

    // (2) Non-regioned function-scope destructure, driven in a loop.
    let mut total: i64 = 0
    let mut k: i64 = 0
    while k < 50 {
        total += fold_round(k)
        k += 1
    }

    println!("{} {}", acc, total)
}
