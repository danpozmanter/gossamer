// Cross-tier regression for the bearer-auth check middleware
// (`http::middleware::bearer_ok`). The handler runs the caller's
// Gossamer `verify` closure on the extracted Authorization bearer
// token - the closure crosses the C-ABI via the env-thunk convention
// shared with the iter / Once / RwLock combinators. A valid token
// reaches the handler body (200); an invalid or absent one is rejected
// (401). The 401-vs-body shaping is plain Gossamer code, so output is
// bit-identical under `gos` (bytecode VM) and `gos build` (LLVM
// AOT).
//
// Self-terminating: the client runs in main and exits explicitly, so
// the run is a plain stdout-parity comparison. Binds a fixed loopback
// port, serialized under SERVER_PORT_LOCK by
// `http_middleware_bearer_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::http::middleware
use std::process
use std::time

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> http::Response {
        if middleware::bearer_ok(&r, |tok| tok == "s3cret") {
            http::Response::text(200, "welcome")
        } else {
            http::Response::text(401, "unauthorized")
        }
    }
}

fn serve_app() {
    if let Err(e) = http::serve("127.0.0.1:23885", App { }) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting. A 401
// is still an Ok response (non-2xx is not a transport error), so the
// no-header probe is enough to detect readiness.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, []) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go serve_app()
    await_ready(&"http://127.0.0.1:23885/x")
    // Valid token → handler body.
    let ok_hdr: [(String, String)] = [("Authorization", "Bearer s3cret")]
    match http::request("GET", "http://127.0.0.1:23885/x", "", ok_hdr) {
        Ok(r) => println!("valid status={} body={}", r.status, r.body),
        Err(e) => println!("valid error: {}", e),
    }
    // Wrong token → 401.
    let bad_hdr: [(String, String)] = [("Authorization", "Bearer nope")]
    match http::request("GET", "http://127.0.0.1:23885/x", "", bad_hdr) {
        Ok(r) => println!("wrong status={} body={}", r.status, r.body),
        Err(e) => println!("wrong error: {}", e),
    }
    // No header → 401 (verify is never invoked).
    match http::get("http://127.0.0.1:23885/x", []) {
        Ok(r) => println!("none status={} body={}", r.status, r.body),
        Err(e) => println!("none error: {}", e),
    }
    process::exit(0)
}
