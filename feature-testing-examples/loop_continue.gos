// Loop Continue
// Exercises `continue` in while and for loops to verify skip semantics
// are identical across all three execution tiers.

fn sum_odds_while(limit: i64) -> i64 {
    let mut sum = 0
    let mut i = 0
    while i < limit {
        i += 1
        if i % 2 == 0 {
            continue
        }
        sum += i
    }
    sum
}

fn count_non_multiples_of_three(n: i64) -> i64 {
    let mut count = 0
    for i in 1..=n {
        if i % 3 == 0 {
            continue
        }
        count += 1
    }
    count
}

fn sum_skipping(limit: i64, skip_a: i64, skip_b: i64) -> i64 {
    let mut total = 0
    for i in 0..limit {
        if i == skip_a || i == skip_b {
            continue
        }
        total += i
    }
    total
}

fn count_evens_while(limit: i64) -> i64 {
    let mut evens: i64 = 0
    let mut i = 0
    while i < limit {
        i += 1
        if i % 2 != 0 {
            continue
        }
        evens += 1
    }
    evens
}

fn main() {
    let odd_sum = sum_odds_while(10)
    println!("sum of odds 1..10 = {}", odd_sum)

    let count = count_non_multiples_of_three(9)
    println!("non-mult-3 in 1..=9 = {}", count)

    let skipped = sum_skipping(5, 1, 3)
    println!("0+2+4 (skip 1,3) = {}", skipped)

    let evens = count_evens_while(20)
    println!("even count 1..20 = {}", evens)

    let mut acc = 0
    for i in 0..10 {
        if i % 4 == 0 {
            continue
        }
        acc += i
    }
    println!("sum skip mult4 = {}", acc)
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn continue_while_skips_evens() {
        let s = super::sum_odds_while(9)
        testing::check_eq(&s, &25, "1+3+5+7+9 == 25")
    }

    #[test]
    fn continue_for_range() {
        let c = super::count_non_multiples_of_three(9)
        testing::check_eq(&c, &6, "1,2,4,5,7,8 == 6 items")
    }

    #[test]
    fn continue_skips_specific_values() {
        let s = super::sum_skipping(5, 1, 3)
        testing::check_eq(&s, &6, "0+2+4 == 6")
    }

    #[test]
    fn continue_while_evens() {
        let e = super::count_evens_while(20)
        testing::check_eq(&e, &10, "10 even numbers in 1..20")
    }

    #[test]
    fn continue_for_skip_mult4() {
        let mut acc = 0
        for i in 0..10 {
            if i % 4 == 0 {
                continue
            }
            acc += i
        }
        testing::check_eq(&acc, &33, "1+2+3+5+6+7+9 == 33, skip 0,4,8")
    }
}
