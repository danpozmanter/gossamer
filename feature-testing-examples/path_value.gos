use std::path

let base = path::Path::new("a/./b")
let joined = base.normalize().join("file.txt")
assert(joined.as_str() == "a/b/file.txt", "normalized join")
assert(joined.file_name() == Some("file.txt"), "file name")
assert(joined.stem() == Some("file"), "stem")
assert(joined.extension() == Some(".txt"), "extension")
assert(joined.starts_with(&path::Path::new("a/b")), "component prefix")
