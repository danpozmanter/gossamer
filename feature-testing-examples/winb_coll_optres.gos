// Win B collections sweep: std::option / std::result combinator
// surface across tiers, with special attention to Option/Result
// payloads that carry structs. map/and_then/filter/or/or_else/
// unwrap_or/unwrap_or_else/zip/flatten/is_some/is_none and result
// map/map_err/and_then/or_else/unwrap_or/unwrap_or_else/ok/err/is_ok/
// is_err. Bit-identical VM vs compiled.

use std::option
use std::result
use std::errors

#[derive(PartialEq, Eq, Debug)]
struct Point { x: i64, y: i64 }

fn main() {
    // ---- Option, scalar payloads ----
    let some: Option<i64> = Some(3)
    let none: Option<i64> = None
    println!("map {}", some |> |v| option::map(|n: i64| n + 1, v) |> |v| option::unwrap_or(0, v))
    println!("map-none {}", none |> |v| option::map(|n: i64| n + 1, v) |> |v| option::unwrap_or(-1, v))
    println!("and_then {}"
        some |> |v| option::and_then(|n: i64| if n > 1 { Some(n * 10) } else { None }, v) |> |v| option::unwrap_or(0, v))
    println!("filter-keep {}", some |> |v| option::filter(|n: i64| n % 2 == 1, v) |> |v| option::unwrap_or(0, v))
    println!("filter-drop {}", some |> |v| option::filter(|n: i64| n % 2 == 0, v) |> |v| option::unwrap_or(-1, v))
    println!("or {}", none |> |v| option::or(Some(5), v) |> |v| option::unwrap_or(0, v))
    println!("or_else {}", none |> |v| option::or_else(|| Some(6), v) |> |v| option::unwrap_or(0, v))
    println!("unwrap_or_else {}", none |> |v| option::unwrap_or_else(|| 9, v))
    println!("is_some {} is_none {}", some |> option::is_some, none |> option::is_none)

    // zip + flatten.
    let zipped = some |> |v| option::zip(Some(4), v)
    let mut zs = 0
    if let Some((a, b)) = zipped { zs = a + b }
    println!("zip {}", zs)
    let nested: Option<Option<i64>> = Some(Some(8))
    println!("flatten {}", nested |> option::flatten |> |v| option::unwrap_or(0, v))

    // ---- Option, struct payloads ----
    let sp: Option<Point> = Some(Point { x: 1, y: 2 })
    let np: Option<Point> = None
    match sp {
        Some(p) => println!("struct some {} {}", p.x, p.y)
        None => println!("struct some none")
    }
    println!("struct is_some {} none is_none {}", sp |> option::is_some, np |> option::is_none)
    // map a struct option to a scalar.
    println!("struct map {}", sp |> |v| option::map(|p: Point| p.x + p.y, v) |> |v| option::unwrap_or(0, v))
    // and_then producing a new struct option, read back.
    let moved = sp |> |v| option::and_then(|p: Point| Some(Point { x: p.x + 10, y: p.y + 20 }), v)
    match moved {
        Some(p) => println!("struct and_then {} {}", p.x, p.y)
        None => println!("struct and_then none")
    }

    // ---- Result, scalar payloads ----
    let ok: Result<i64, errors::Error> = Ok(2)
    let bad: Result<i64, errors::Error> = Err(errors::new("boom"))
    println!("r map {}", ok |> |v| result::map(|n: i64| n * 3, v) |> |v| result::unwrap_or(0, v))
    println!("r map-err-default {}"
        bad |> |v| result::map(|n: i64| n * 3, v) |> |v| result::unwrap_or(-1, v))
    println!("r and_then {}", ok |> |v| result::and_then(|n: i64| Ok(n + 10), v) |> |v| result::unwrap_or(0, v))
    println!("r or_else {}", bad |> |v| result::or_else(|_e: errors::Error| Ok(7), v) |> |v| result::unwrap_or(0, v))
    println!("r is_ok {} is_err {}", ok |> result::is_ok, bad |> result::is_err)
    println!("r ok->some {} err->some {}"
        ok |> result::ok |> option::is_some, bad |> result::err |> option::is_some)
    bad |> |v| result::map_err(|e: errors::Error| errors::wrap(e, "ctx"), v)
        |> |v| result::unwrap_or_else(|e: errors::Error| println!("r unwrap_or_else {}", e), v)

    // ---- Result, struct payloads ----
    let rsp: Result<Point, errors::Error> = Ok(Point { x: 5, y: 6 })
    let rbad: Result<Point, errors::Error> = Err(errors::new("nope"))
    match rsp {
        Ok(p) => println!("r struct ok {} {}", p.x, p.y)
        Err(e) => println!("r struct err {}", e)
    }
    println!("r struct map {}", rsp |> |v| result::map(|p: Point| p.x * p.y, v) |> |v| result::unwrap_or(0, v))
    let rmoved = rsp |> |v| result::and_then(|p: Point| Ok(Point { x: p.x + 1, y: p.y + 1 }), v)
    match rmoved {
        Ok(p) => println!("r struct and_then {} {}", p.x, p.y)
        Err(_) => println!("r struct and_then err")
    }
    match rbad |> |v| result::map(|p: Point| p.x, v) {
        Ok(v) => println!("r struct bad ok {}", v)
        Err(e) => println!("r struct bad err {}", e)
    }
}
