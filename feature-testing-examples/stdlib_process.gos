// Locks the canonical `process::run` free-call path across tiers. The
// other process fixtures only exercise the `exec::` alias; this pins
// the `process::` spelling advertised in the skill card.
use std::process

fn main() {
    match process::run(&"echo", &Vec::from(["gossamer-0.14"])) {
        Ok(o) => print!("{}", o.stdout)
        Err(e) => println!("err: {}", e)
    }
}
