// Cross-tier coverage for streamed server responses
// (`Response::stream`) - the proxy-passthrough shape. A proxy
// handler opens an upstream `http::stream` and returns
// `http::Response::stream(up.status, up.content_type, up)`; the
// server writes status + headers + `Transfer-Encoding: chunked`
// and drains the upstream reader to the client in 8 KiB frames
// with the 0-length terminal frame - no full-body buffering.
//
// The client GETs through the proxy twice (a fresh upstream
// stream must be opened per request) and then GETs /consumed,
// whose handler verifies the consume semantics: after
// `Response::stream(...)` the ResponseStream handle is spent, so
// `next_chunk` yields `None` (the handler answers 500 if it ever
// sees data) while the response still drains the full body.
//
// Self-terminating: the client runs in main and exits explicitly.
// Binds fixed loopback ports - serialized under SERVER_PORT_LOCK
// by `http_proxy_stream_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::env
use std::http
use std::process
use std::time

struct Upstream { }

impl http::Handler for Upstream {
    fn serve(&self, _r: http::Request) -> Result<http::Response, http::Error> {
        Ok(http::Response::text(200, "upstream payload: the quick brown fox"))
    }
}

/// The two ports this run listens on. The caller names them, so the fixture
/// competes with nothing on the box; the defaults are what running it by hand
/// gets.
fn upstream_addr() -> String { env::args().first().unwrap_or("127.0.0.1:23877") }

fn proxy_addr() -> String {
    let a = env::args()
    if a.len() > 1 { a[1] } else { "127.0.0.1:23878" }
}

struct Proxy { }

impl http::Handler for Proxy {
    fn serve(&self, r: http::Request) -> Result<http::Response, http::Error> {
        match http::stream(r.method, "http://" + upstream_addr() + "/data", r.body, Vec::from([])) {
            Ok(up) => {
                if r.path() == "/consumed" {
                    let streamed = http::Response::stream(up.status, up.content_type, up)
                    if let Some(_) = up.next_chunk(64) {
                        return Ok(http::Response::text(500, "stream not consumed"))
                    }
                    return Ok(streamed)
                }
                Ok(http::Response::stream(up.status, up.content_type, up))
            }
            Err(_) => Ok(http::Response::text(502, "bad upstream"))
        }
    }
}

fn run_upstream() {
    if let Err(e) = http::serve(upstream_addr(), Upstream { }) {
        eprintln("serve failed: {e}")
    }
}

fn run_proxy() {
    if let Err(e) = http::serve(proxy_addr(), Proxy { }) {
        eprintln("serve failed: {e}")
    }
}

fn fetch(label: String, path: String) {
    match http::get("http://" + proxy_addr() + path, Vec::from([])) {
        Ok(resp) => println(
            "{} status={} ct={} len={} body={}"
            label
            resp.status
            resp.content_type
            resp.raw_bytes.len()
            resp.body
        )
        Err(e) => println("{} error: {}", label, e)
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
// Upstream is probed before the proxy: the proxy answers 502
// (an Ok response) while the upstream is still down.
fn await_ready(url: String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    spawn(|| run_upstream())
    spawn(|| run_proxy())
    await_ready("http://" + upstream_addr() + "/data")
    await_ready("http://" + proxy_addr() + "/a")
    fetch("first", "/a")
    fetch("second", "/b")
    fetch("consumed", "/consumed")
    process::exit(0)
}
