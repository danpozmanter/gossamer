struct Popped {
    key: String
    value: String
}

fn popped() -> Option<Popped> {
    Some(Popped { key: "k", value: "build" })
}

fn lengths(rounds: i64) -> i64 {
    let mut total = 0
    for _ in 0..rounds {
        total += popped().map(|p| p.value.len()).unwrap_or(0)
    }
    total
}

fn main() {
    println!("{:?}", popped().map(|p| p.value))
    println!("{:?}", popped().map(|p| p.key.len()))
    println!("{}", lengths(200))
}
