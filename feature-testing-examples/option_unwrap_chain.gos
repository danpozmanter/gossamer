// Option Unwrap Chain
// Chain Option and Result transformations with ?, map_err, and
// if let to test propagation and short-circuit correctness.

use std::errors

fn maybe_double(n: i64) -> Option<i64> {
    if n > 0 { Some(n * 2) } else { None }
}

fn safe_divide(a: i64, b: i64) -> Result<i64, errors::Error> {
    if b == 0 {
        return Err(errors::new("division by zero"))
    }
    Ok(a / b)
}

fn pipeline(a: i64, b: i64) -> Result<i64, errors::Error> {
    let doubled = match maybe_double(a) {
        Some(v) => v,
        None => return Err(errors::new("double failed")),
    }
    let divided = safe_divide(doubled, b)?
    let tripled = match maybe_double(divided) {
        Some(v) => v + divided,
        None => return Err(errors::new("triple failed")),
    }
    Ok(tripled)
}

fn main() {
    // Happy path
    let r = pipeline(6, 3)
    match r {
        Ok(v) => println!("pipeline(6,3) = {}", v),
        Err(e) => println!("unexpected error: {}", e.message()),
    }

    // Short-circuit on bad double
    let r2 = pipeline(-1, 3)
    match r2 {
        Ok(v) => println!("unexpected success: {}", v),
        Err(e) => println!("expected error: {}", e.message()),
    }

    // Short-circuit on divide-by-zero
    let r3 = pipeline(6, 0)
    match r3 {
        Ok(v) => println!("unexpected success: {}", v),
        Err(e) => println!("expected error: {}", e.message()),
    }

    // if let chain
    let first = Some(10)
    if let Some(n) = first {
        if let Some(m) = maybe_double(n) {
            if let Ok(d) = safe_divide(m, 4) {
                println!("if-let chain result = {}", d)
            }
        }
    }

    // while let with Option iteration
    let mut opt: Option<i64> = Some(5)
    while let Some(n) = opt {
        println!("while let opt = {}", n)
        opt = if n > 0 { Some(n - 1) } else { None }
    }
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn maybe_double_positive() {
        match super::maybe_double(5) {
            Some(v) => { let _ = testing::check_eq(&v, &10, "double(5)=10"); },
            None => { let _ = testing::check(false, "expected Some"); },
        }
    }

    #[test]
    fn maybe_double_negative_gives_none() {
        match super::maybe_double(-1) {
            Some(_) => { let _ = testing::check(false, "expected None"); },
            None => { let _ = testing::check(true, "None for negative"); },
        }
    }

    #[test]
    fn safe_divide_ok() {
        match super::safe_divide(10, 2) {
            Ok(v) => { let _ = testing::check_eq(&v, &5, "10/2=5"); },
            Err(_) => { let _ = testing::check(false, "unexpected error"); },
        }
    }

    #[test]
    fn safe_divide_zero() {
        match super::safe_divide(10, 0) {
            Ok(_) => { let _ = testing::check(false, "expected error"); },
            Err(e) => { let _ = testing::check(e.message().contains("zero"), "div zero error"); },
        }
    }

    #[test]
    fn pipeline_happy_path() {
        match super::pipeline(6, 3) {
            Ok(v) => { let _ = testing::check_eq(&v, &12, "6*2/3*2=12"); },
            Err(_) => { let _ = testing::check(false, "unexpected error"); },
        }
    }
}
