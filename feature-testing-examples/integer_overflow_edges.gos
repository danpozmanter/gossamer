// Integer Overflow Edges
// Perform arithmetic near i64 and u64 limits with +=, casts, and
// comparisons to surface overflow handling differences between
// execution modes.

fn main() {
    let max_i64: i64 = 9223372036854775807
    let max_u64: u64 = 18446744073709551615

    // Wrapping / checked behaviour should be consistent
    let mut a: i64 = max_i64 - 1
    a += 1
    println!("i64 near-max + 1 = {}", a)

    let mut b: u64 = max_u64 - 2
    b += 1
    // Both VM (i64-internal) and compiled tier agree when printing as i64.
    println!("u64 near-max + 1 = {}", b as i64)

    // Casts across signed/unsigned boundaries
    let c: i64 = -1
    let casted: u64 = c as u64
    println!("-1 as u64 = {}", casted)

    let d: u64 = 18446744073709551615
    let back: i64 = d as i64
    println!("max u64 as i64 = {}", back)

    // Comparisons at boundaries
    let e: i64 = -9223372036854775808
    println!("i64 min = {}", e)
    println!("i64 min < 0 = {}", e < 0)

    let f: u64 = 0
    println!("u64 zero - 1 (as i64) = {}", (f - 1) as i64)

    // Explicit widening via intermediate
    let g: i32 = 2147483647
    let mut h: i64 = g as i64
    h += 1
    println!("i32 max widened + 1 = {}", h)
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn neg_one_as_u64_roundtrip() {
        let v: i64 = -1
        let u = v as u64
        testing::check_eq(&(u as i64), &v, "-1 as u64 round-trips")
    }

    #[test]
    fn i64_min_is_negative() {
        let min: i64 = -9223372036854775808
        testing::check(min < 0, "i64 min is negative")
    }

    #[test]
    fn i32_max_widened() {
        let g: i32 = 2147483647
        let h: i64 = g as i64
        let result = h + 1
        testing::check_eq(&result, &2147483648, "i32 max widened + 1")
    }

    #[test]
    fn max_u64_as_i64() {
        let d: u64 = 18446744073709551615
        let back: i64 = d as i64
        testing::check_eq(&back, &-1, "max u64 as i64 = -1")
    }
}
