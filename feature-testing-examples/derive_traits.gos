// `#[derive(...)]` for the standard traits. The synthesizer emits real `impl`
// methods at parse time (the same path that derives JSON/TOML/YAML), so they
// lower through every tier exactly like hand-written code: `==` / `!=` route
// to the synthesized `eq`, `{:?}` / `{}` route to `fmt`, on the VM walker,
// Cranelift, and LLVM.
//
// Covers structs with: primitive + String fields, a NESTED struct field, and
// a GENERIC type parameter, plus tuple / unit-variant ENUMS. (Struct-payload
// enum variants and `Hash` are not derived yet.)

#[derive(PartialEq, Eq, Default, Debug)]
struct Point { x: i64, y: i64 }

#[derive(PartialEq, Default, Debug)]
struct Line { from: Point, to: Point, label: String }

#[derive(PartialEq, Debug)]
struct Wrap<T> { value: T, tag: i64 }

#[derive(PartialEq, Eq, Debug, Default)]
enum Token { Num(i64), Pair(i64, i64), #[default] End }

fn unit_x() -> Point { Point(1, 0) }
fn diag() -> Line { Line(Point(0, 0), Point(2, 2), "d") }
fn wrapped() -> Wrap<i64> { Wrap(7, 1) }
fn zero_line() -> Line { Line::default() }
fn pair() -> Token { Token::Pair(3, 4) }

fn main() {
    // PartialEq / Eq, including a nested-struct field.
    println!("{}", unit_x() == unit_x())
    println!("{}", unit_x() != Point(9, 0))
    println!("{}", diag() == diag())
    println!("{}", diag() != Line(Point(0, 0), unit_x(), "d"))

    // Clone + Default.
    println!("{}", diag().clone() == diag())
    let z = Line::default()
    println!("{} {} '{}'", z.from.x, z.to.y, z.label)

    // Debug (nested + generic).
    println!("{:?}", unit_x())
    println!("{:?}", diag())
    println!("{:?}", wrapped())

    // Generic PartialEq.
    println!("{}", wrapped() == Wrap(7, 1))
    println!("{}", wrapped() != Wrap(8, 1))

    // Enum: Clone, PartialEq, Debug, Default.
    println!("{}", pair() == pair().clone())
    println!("{}", pair() != Token::Num(7))
    println!("{:?}", pair())
    println!("{:?}", Token::Num(5))
    println!("{:?}", Token::default())
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn nested_eq_and_clone() {
        let d = super::diag()
        let _ = testing::check(d == d.clone(), "nested struct equals its clone")
    }

    #[test]
    fn default_is_zero_valued() {
        let z = super::zero_line()
        let _ = testing::check(z.from.x == 0 && z.to.y == 0, "Default zeroes nested fields")
    }

    #[test]
    fn generic_eq() {
        let _ = testing::check(super::wrapped() == super::wrapped(), "generic struct equality")
    }

    #[test]
    fn enum_eq_and_default() {
        let _ = testing::check(super::pair() == super::pair().clone(), "enum equals its clone")
        let _ = testing::check(super::pair() != super::Token::Num(1), "different variants are unequal")
    }
}
