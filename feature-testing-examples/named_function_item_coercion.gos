// Bare named functions used where `Fn(...) -> ...` callbacks are expected.
// This pins the shared frontend's function-item-to-Fn coercion across direct
// HOF calls and method-form sequence combinators.

fn inc(x: i64) -> i64 { x + 1 }
fn double(x: i64) -> i64 { x * 2 }
fn is_even(x: i64) -> bool { x % 2 == 0 }
fn add(acc: i64, x: i64) -> i64 { acc + x }

fn apply_i64(f: Fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn keep_i64(xs: Vec<i64>, pred: Fn(i64) -> bool) -> Vec<i64> {
    let mut out: Vec<i64> = Vec::from([])
    for x in xs {
        if pred(x) {
            out.push(x)
        }
    }
    out
}

fn main() {
    let xs = Vec::from([1, 2, 3, 4])
    println!("{}", apply_i64(inc, 41))
    println!("{:?}", xs.map(double))
    println!("{:?}", keep_i64(xs, is_even))
    println!("{}", xs.fold(0, add))
}
