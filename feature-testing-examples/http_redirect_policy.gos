// Cross-tier coverage for the programmer-selectable redirect
// policy: `http::Client::builder().max_redirects(n).timeout_ms(t)
// .build()` plus `client.request` / `client.request_bytes`.
//
// Client A (default policy) follows the 302 from /hop and lands on
// /data with the final body. Client B (`max_redirects(0)` - the
// proxy-correct mode) gets the 302 back raw with its Location
// header intact. Client C exercises the binary-body
// `request_bytes` path through the same configured client.
//
// Self-terminating: the client runs in main and exits explicitly.
// Binds a fixed loopback port - serialized under SERVER_PORT_LOCK
// by `http_redirect_policy_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::process
use std::time

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> Result<http::Response, http::Error> {
        let path = r.path()
        if path == "/hop" {
            return Ok(http::Response::text(302, "redirecting").with_header("Location", "/data"))
        }
        if path == "/echo" {
            return Ok(http::Response::text(200, r.body))
        }
        Ok(http::Response::text(200, "landed"))
    }
}

fn run_server() {
    if let Err(e) = http::serve("127.0.0.1:23875", App { }) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
// Probes /data (a plain 200) so the redirect legs stay untouched.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go run_server()
    await_ready(&"http://127.0.0.1:23875/data")

    let follow = http::Client::builder().timeout_ms(5000).build()
    match follow.request("GET", "http://127.0.0.1:23875/hop", "", #[]) {
        Ok(r) => println!("a_status={} a_body={}", r.status, r.body),
        Err(e) => println!("a_error: {}", e),
    }

    let raw = http::Client::builder().max_redirects(0).timeout_ms(5000).build()
    match raw.request("GET", "http://127.0.0.1:23875/hop", "", #[]) {
        Ok(r) => println!("b_status={} b_location={}", r.status, r.location),
        Err(e) => println!("b_error: {}", e),
    }

    match follow.request_bytes("POST", "http://127.0.0.1:23875/echo", #[104, 105], #[]) {
        Ok(r) => println!("c_status={} c_body={}", r.status, r.body),
        Err(e) => println!("c_error: {}", e),
    }

    process::exit(0)
}
