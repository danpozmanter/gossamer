// String Concatenation Stress
// Build strings using +, +=, format!, and println! in different
// combinations to catch ownership and allocation mismatches.

fn main() {
    let a = "hello"
    let b = "world"
    let c = a + ", " + &b
    println("plus chain: {}", c)

    let mut acc = ""
    for word in ["the", "quick", "brown", "fox"] {
        if acc.len() > 0 {
            acc += " "
        }
        acc += word
    }
    println("accumulated: {}", acc)

    let numbered = format("{} {} {}", 1, 2, 3)
    println("format! numbers: {}", numbered)

    let mixed = format("int={} float={} str={}", 42, 3.14, "pi")
    println("format! mixed: {}", mixed)

    let name = "gossamer"
    let version = "0.1"
    let greeting = format("welcome to {} v{}", name, version)
    println("{}", greeting)

    // Repeated mutation
    let mut line = ""
    line += "start"
    line += " -> "
    line += "middle"
    line += " -> "
    line += "end"
    println("mut line: {}", line)

    // Borrow after concat
    let base = "base"
    let extended = base.clone() + "_extended"
    println("base still borrowable: {}", base)
    println("extended: {}", extended)
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn plus_concat() {
        let a = "hello"
        let b = "world"
        let c = a + ", " + &b
        let _ = testing::check_eq(c, "hello, world", "plus concat")
    }

    #[test]
    fn format_numbers() {
        let s = format("{} {} {}", 1, 2, 3)
        let _ = testing::check_eq(s, "1 2 3", "format numbers")
    }

    #[test]
    fn accumulate_words() {
        let mut acc = ""
        for w in ["a", "b", "c"] {
            if acc.len() > 0 {
                acc += " "
            }
            acc += w
        }
        let _ = testing::check_eq(acc, "a b c", "accumulated words")
    }

    #[test]
    fn mut_append_chain() {
        let mut s = ""
        s += "x"
        s += "-"
        s += "y"
        let _ = testing::check_eq(s, "x-y", "mut append chain")
    }
}
