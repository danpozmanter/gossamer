// Phase 1 BTreeMap uses String keys and i64 values across every runtime tier.

use std::collections::BTreeMap

fn main() {
    let mut m: BTreeMap<String, i64> = BTreeMap::new()
    m.insert("c", 3)
    m.insert("a", 1)
    m.insert("b", 2)
    let mut out = ""
    for (k, v) in m.iter() {
        out += format("{}={} ", k, v)
    }
    let entries = m.iter().collect()
    let mut indexed = ""
    for (i, entry) in entries.iter().enumerate() {
        indexed += format("{}:{}={} ", i, entry.0, entry.1)
    }
    println("{}{}len={} get={} has={}", out, indexed, m.len(), m.get_or("b", 0), m.contains("a"))
}
