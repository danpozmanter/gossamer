// Closure Lifetime and Capture Inference
// Demonstrates closure capture via single-expression closures:
// immutable capture, closure composition, higher-order map/filter,
// and returning closures from functions as first-class values.

fn make_adder(n: i64) -> Fn(i64) -> i64 {
    |x| x + n
}

fn make_multiplier(n: i64) -> Fn(i64) -> i64 {
    |x| x * n
}

fn make_threshold_pred(t: i64) -> Fn(i64) -> bool {
    |x| x > t
}

fn compose(f: Fn(i64) -> i64, g: Fn(i64) -> i64) -> Fn(i64) -> i64 {
    |x| f(g(x))
}

fn map_fn(xs: [i64], f: Fn(i64) -> i64) -> [i64] {
    let mut out: [i64] = []
    for x in xs {
        out.push(f(x))
    }
    out
}

fn filter_fn(xs: [i64], pred: Fn(i64) -> bool) -> [i64] {
    let mut out: [i64] = []
    for x in xs {
        if pred(x) {
            out.push(x)
        }
    }
    out
}

fn reduce_fn(xs: [i64], init: i64, f: Fn(i64, i64) -> i64) -> i64 {
    let mut acc = init
    for x in xs {
        acc = f(acc, x)
    }
    acc
}

fn apply_n(f: Fn(i64) -> i64, x: i64, n: i64) -> i64 {
    let mut result = x
    let mut i = 0
    while i < n {
        result = f(result)
        i += 1
    }
    result
}

fn pipeline(xs: [i64], ops: [Fn(i64) -> i64]) -> [i64] {
    let mut result = xs
    for op in ops {
        result = map_fn(result, op)
    }
    result
}

fn main() {
    // Closures capturing from enclosing scope
    let add5 = make_adder(5)
    let mul3 = make_multiplier(3)
    println!("add5(10) = {}", add5(10))
    println!("mul3(7) = {}", mul3(7))

    // Composition: add5 after mul3
    let mul3_then_add5 = compose(add5, mul3)
    println!("mul3_then_add5(4) = {}", mul3_then_add5(4))

    // map + filter with closures
    let nums = [1, 2, 3, 4, 5, 6, 7, 8]
    let doubled = map_fn(nums, |x| x * 2)
    println!("doubled[0] = {}", doubled[0])
    println!("doubled[7] = {}", doubled[7])

    let threshold = 4
    let pred = make_threshold_pred(threshold)
    let evens = filter_fn(nums, pred)
    println!("above-4 count = {}", evens.len())
    println!("above-4[0] = {}", evens[0])

    // reduce with inline closure
    let sum = reduce_fn(nums, 0, |a, b| a + b)
    println!("sum 1..8 = {}", sum)

    let product = reduce_fn([1, 2, 3, 4], 1, |a, b| a * b)
    println!("product 1*2*3*4 = {}", product)

    // apply_n: repeated application
    let add1 = make_adder(1)
    println!("add1 applied 5 times to 0: {}", apply_n(add1, 0, 5))

    // Pipeline of ops: +1 then *2 then -1
    let mut ops: [Fn(i64) -> i64] = []
    ops.push(make_adder(1))
    ops.push(make_multiplier(2))
    ops.push(make_adder(-1))
    let result = pipeline([1, 2, 3, 4], ops)
    // (1+1)*2-1=3, (2+1)*2-1=5, (3+1)*2-1=7, (4+1)*2-1=9
    println!("pipeline[0] = {}", result[0])
    println!("pipeline[3] = {}", result[3])
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn adder_captures_correctly() {
        let add10 = super::make_adder(10)
        testing::check_eq(&add10(5), &15, "5+10=15")
        testing::check_eq(&add10(0), &10, "0+10=10")
        testing::check_eq(&add10(-3), &7, "-3+10=7")
    }

    #[test]
    fn composition_applies_right_to_left() {
        let add1 = super::make_adder(1)
        let mul2 = super::make_multiplier(2)
        let f = super::compose(add1, mul2)
        // f(x) = (x*2)+1
        testing::check_eq(&f(3), &7, "(3*2)+1=7")
        testing::check_eq(&f(0), &1, "(0*2)+1=1")
    }

    #[test]
    fn apply_n_repeated_application() {
        let add2 = super::make_adder(2)
        testing::check_eq(&super::apply_n(add2, 0, 5), &10, "add2 x5 from 0 = 10")
    }

    #[test]
    fn reduce_sum_and_product() {
        let xs = [1, 2, 3, 4, 5]
        let s = super::reduce_fn(xs, 0, |a, b| a + b)
        testing::check_eq(&s, &15, "1+2+3+4+5=15")
        let p = super::reduce_fn(xs, 1, |a, b| a * b)
        testing::check_eq(&p, &120, "5!=120")
    }

    #[test]
    fn pipeline_applies_ops_in_order() {
        let mut ops: [Fn(i64) -> i64] = []
        ops.push(super::make_adder(1))
        ops.push(super::make_multiplier(2))
        let result = super::pipeline([4], ops)
        // (4+1)*2=10
        testing::check_eq(&result[0], &10, "(4+1)*2=10")
    }
}
