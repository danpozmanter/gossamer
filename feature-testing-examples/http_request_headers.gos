// Cross-tier regression for inbound server request headers.
// `r.headers` on an `http::Request` must be a real
// `Vec<(String, String)>` on every tier: the compiled h1 server
// eagerly parses the header section (lowercase names, trimmed
// values, last-wins dedupe, name-sorted - the interp `Headers`
// map view), and the `for (name, value) in r.headers` tuple
// destructure must lower without the historical MIR panic /
// first-request segfault. Also pins `r.path` query-stripping and
// `r.query` parity for request-targets with a query component.
//
// Only intentionally-sent `x-*` headers are inspected - client
// engines add differing default headers (user-agent, accept), so
// totals over the full bag would be nondeterministic.
//
// Self-terminating: the client runs in main and exits explicitly.
// Binds a fixed loopback port - serialized under SERVER_PORT_LOCK
// by `http_request_headers_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::process
use std::time

// Selected-header lookup through a borrowed header list - the
// historical segfault shape (no native lowering existed for the
// ("http::Request", "headers") field projection).
fn header_of(headers: &[(String, String)], want: String) -> String {
    let mut found = ""
    for (name, value) in headers {
        if name == want {
            found = *value
        }
    }
    found
}

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> Result<http::Response, http::Error> {
        let mut custom = 0
        for (name, _value) in r.headers {
            if name.starts_with("x-") {
                custom += 1
            }
        }
        let alpha = header_of(&r.headers, "x-alpha")
        let beta = header_of(&r.headers, "x-beta")
        let body = format!(
            "custom={} alpha={} beta={} path={} query={}",
            custom, alpha, beta, r.path, r.query,
        )
        Ok(http::Response::text(200, body))
    }
}

fn serve_app() {
    if let Err(e) = http::serve("127.0.0.1:23879", App { }) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
// The probe sends no x-* headers, so the handler's per-request
// custom count is undisturbed.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from(#[])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go serve_app()
    await_ready(&"http://127.0.0.1:23879/echo")
    let headers: Vec<(String, String)> = Vec::from(#[("X-Alpha", "a1"), ("x-beta", "b2")])
    match http::request("GET", "http://127.0.0.1:23879/echo?k=1&n=2", "", headers) {
        Ok(r) => println!("status={} {}", r.status, r.body),
        Err(e) => println!("error: {}", e),
    }
    process::exit(0)
}
