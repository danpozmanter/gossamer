// Open-ended range patterns: `..=hi`, `..hi` (open start) and
// `lo..` (open end), mirroring closed `lo..=hi` ranges.

fn classify(n: i64) -> String {
    match n {
        ..=-1 => "negative"
        0 => "zero"
        1.. => "positive"
        _ => "unreachable"
    }
}

fn band(b: u8) -> i64 {
    match b {
        ..=63 => 0
        64..=191 => 1
        192.. => 2
        _ => -1
    }
}

fn exclusive_open(n: i64) -> String {
    match n {
        ..0 => "below"
        0..10 => "single-digit"
        10.. => "ten-plus"
        _ => "unreachable"
    }
}

fn main() {
    println!("{}", classify(-5))
    println!("{}", classify(0))
    println!("{}", classify(7))

    println!("{}", band(10))
    println!("{}", band(128))
    println!("{}", band(240))

    println!("{}", exclusive_open(-3))
    println!("{}", exclusive_open(4))
    println!("{}", exclusive_open(50))
}
