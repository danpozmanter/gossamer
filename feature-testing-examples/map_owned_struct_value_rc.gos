// A struct with heap fields stored in a map, read back after the binding that
// put it there is gone.
//
// The compiled tiers count a struct's `String` and `Vec` fields per binding
// rather than through the aggregate, and a hash container keeps the word it
// is handed rather than copying the slots - so an insert that took no share
// of those fields left the entry holding storage that died with the binding
// which inserted it. Reading straight afterwards proves nothing, because the
// freed block is intact until something claims it; this fills, allocates over
// the gap, and only then reads every entry back.
//
// `store` is where the share is minted: its `held` and the clone it inserts
// both end at the call's return, and the entry has to outlive them.

struct Held {
    name: String
    parts: Vec<i64>
}

fn store(into: &mut Map<String, Held>, n: i64) {
    let held = Held { name: format("held-{}", n), parts: #[n, n + 1, n + 2] }
    let _ = into.insert(format("k-{}", n), held.clone())
}

fn main() {
    let mut kept: Map<String, Held> = Map::new()
    for n in 0..200 {
        store(&mut kept, n)
    }

    // Allocation traffic of a shape that would take a freed entry's block.
    let mut filler: Vec<String> = #[]
    for n in 0..400 {
        filler.push(format("filler-{}", n))
    }

    let mut wrong_name = 0
    let mut wrong_parts = 0
    let mut missing = 0
    for n in 0..200 {
        match kept.get(format("k-{}", n)) {
            Some(found) => {
                if found.name != format("held-{}", n) {
                    wrong_name += 1
                }
                if found.parts.len() != 3 || found.parts[0] != n || found.parts[2] != n + 2 {
                    wrong_parts += 1
                }
            }
            None => missing += 1
        }
    }
    println("entries whose name changed:  {}", wrong_name)
    println("entries whose parts changed: {}", wrong_parts)
    println("entries that went missing:   {}", missing)
    println("kept: {} filler: {}", kept.len(), filler.len())

    // Taking one out hands its share over, and the value still reads.
    match Map::pop(&mut kept, "k-7") {
        Some(taken) => println("taken: {} {:?}", taken.name, taken.parts)
        None => println("taken: nothing")
    }
    println("entries left: {}", kept.len())
}
