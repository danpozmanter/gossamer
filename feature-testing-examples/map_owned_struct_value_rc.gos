// A struct with heap fields stored in a map, read back, and taken out again
// after the binding that put it there is gone.
//
// The entry needs a reference of its own: reading a value hands out a share
// and overwriting one gives a share up, so an insert that took none left the
// map holding a value nobody had counted. It kept working until the caller's
// own binding died, and then the entry pointed at freed memory - which a
// later read only notices once some other allocation has taken the block.
// The loop below both fills and re-reads, so a missing share shows up as a
// changed field rather than as a crash nobody can place.

struct Held {
    name: String
    parts: Vec<i64>
}

// The value goes in inside this function, so the local that carried it is
// gone by the time the caller reads the entry back.
fn store(into: &mut Map<String, Held>, n: i64) {
    let held = Held { name: format!("held-{}", n), parts: #[n, n + 1, n + 2] }
    let _ = into.insert(format!("k-{}", n), held.clone())
}

fn main() {
    let mut kept: Map<String, Held> = Map::new()
    for n in 0..200 {
        store(&mut kept, n)
    }

    // Allocation traffic of a shape that would take a freed entry's block.
    let mut filler: Vec<String> = #[]
    for n in 0..400 {
        filler.push(format!("filler-{}", n))
    }

    let mut wrong_name = 0
    let mut wrong_parts = 0
    let mut missing = 0
    for n in 0..200 {
        match kept.get(&format!("k-{}", n)) {
            Some(found) => {
                if found.name != format!("held-{}", n) {
                    wrong_name += 1
                }
                if found.parts.len() != 3 || found.parts[0] != n {
                    wrong_parts += 1
                }
            }
            None => missing += 1
        }
    }
    println!("entries whose name changed:  {}", wrong_name)
    println!("entries whose parts changed: {}", wrong_parts)
    println!("entries that went missing:   {}", missing)
    println!("filler intact: {}", filler.len())

    // Taking one out hands its share over, and the value still reads.
    match Map::pop(&mut kept, "k-7") {
        Some(taken) => println!("taken: {} {:?}", taken.name, taken.parts)
        None => println!("taken: nothing")
    }
    println!("entries left: {}", kept.len())
}
