// Qualified `Vec::remove(&mut xs, i)` follows the checked method form. It
// removes the element in place and returns it through Ok on every tier.

fn main() {
    let mut xs: Vec<i64> = Vec::from([10, 20, 30, 40, 50])
    let r = Vec::remove(&mut xs, 1).unwrap_or(-1)
    let mut sum = 0
    for x in xs { sum += x }
    println!("removed={} len={} sum={} first={}", r, xs.len(), sum, xs[0])
    let r2 = Vec::remove(&mut xs, 0).unwrap_or(-1)
    println!("removed2={} len={}", r2, xs.len())
}
