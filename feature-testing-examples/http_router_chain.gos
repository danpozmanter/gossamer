// Cross-tier regression for Router verb-method chaining via |>.
// Building the route table as an expression:
//   Router::new() |> $.get("/a", fa) |> $.post("/b", fb) |> $.get("/c", fc)
// requires each verb method to return the router so the pipe delivers a typed
// value to the next call.
//
// Self-terminating: the client runs in main and exits explicitly, so the
// fixture is a plain stdout-parity comparison. Binds a fixed loopback port,
// serialized under SERVER_PORT_LOCK by
// http_router_chain_parity_across_tiers in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::http::router
use std::process
use std::time

fn get_a(_r: http::Request) -> http::Response {
    http::Response::text(200, "a-ok")
}

fn post_b(_r: http::Request) -> http::Response {
    http::Response::text(201, "b-created")
}

fn get_c(_r: http::Request) -> http::Response {
    http::Response::text(200, "c-ok")
}

fn serve_chained() {
    let r = router::Router::new()
        |> $.get("/a", get_a)
        |> $.post("/b", post_b)
        |> $.get("/c", get_c)
    if let Err(e) = http::serve("127.0.0.1:23882", r) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go serve_chained()
    await_ready(&"http://127.0.0.1:23882/a")
    match http::get("http://127.0.0.1:23882/a", Vec::from([])) {
        Ok(r) => println!("get_a status={} body={}", r.status, r.body)
        Err(e) => println!("get_a error: {}", e)
    }
    match http::request("POST", "http://127.0.0.1:23882/b", "", Vec::from([])) {
        Ok(r) => println!("post_b status={} body={}", r.status, r.body)
        Err(e) => println!("post_b error: {}", e)
    }
    match http::get("http://127.0.0.1:23882/c", Vec::from([])) {
        Ok(r) => println!("get_c status={} body={}", r.status, r.body)
        Err(e) => println!("get_c error: {}", e)
    }
    process::exit(0)
}
