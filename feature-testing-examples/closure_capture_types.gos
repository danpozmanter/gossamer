// A closure's captured value keeps its own type, whatever expression the
// capture is reached through and whatever the closure returns. The
// environment slot is laid out and reference-counted by that type, so a
// capture typed from anything else hands one kind of value to another's
// contract.
fn main() {
    // An i64 capture reached through a tuple, in a closure returning a
    // String. Every value of `y` runs, not just the ones whose bits
    // happen to be a rejected pointer shape.
    let mut y = 0
    while y < 24 {
        let row = (0..=3)
            .map(|x| { let cell = (x, y); if cell.0 == cell.1 % 4 { "#" } else { "." } })
            .collect()
            .join("")
        println("{} {}", y, row)
        y += 1
    }

    // The same capture reached through a Vec literal, a fixed array, a
    // Set literal, and a range.
    let k = 13
    let through_vec = (0..3).map(|x| { let v = #[x, k]; v[1] }).collect()
    let through_array = (0..3).map(|x| { let a = [x, k]; a[1] }).collect()
    let through_set = (0..3).map(|x| { let s = #{ x, k }; s.len() }).collect()
    let through_range = (0..3)
        .map(|x| { let r = x..k
            let mut n = 0
            for _ in r { n += 1 }
            n })
                .collect()
    println(
        "{:?} {:?} {:?} {:?}"
        through_vec
        through_array
        through_set
        through_range
    )

    // Captures of different types in one closure, none of them the
    // return type.
    let scale = 3
    let bias = 0.5
    let label = "n"
    let mixed = (1..=3)
        .map(|x| { let t = (x, scale, bias, label); format("{}{}", t.3, x * t.1) })
        .collect()
    println("{:?}", mixed)

    // A String capture stays a String: it is retained and released as
    // one across every element.
    let prefix = "row-"
    let labelled = (0..4).map(|x| { let t = (prefix, x); t.0 }).collect()
    println("{:?}", labelled)

    // A map keyed by a captured tuple, the shape the whole chain was
    // found through.
    let mut panels: Map<(i64, i64), i64> = {}
    panels.insert((1, 2), 7)
    let looked_up = (0..3).map(|x| panels.get_or((x, 2), 0)).collect()
    println("{:?} {}", looked_up, panels.len())
}
