// `cohort { }` - structured concurrency. Every goroutine `spawn`ed while
// the block runs is joined before the block's value exists, so the
// transcript below is fully determined: nothing prints from a child, and
// each line reports a cohort that has already finished.

use std::errors

fn work(n: i64) -> Result<i64, errors::Error> {
    if n < 0 {
        return Err(errors::newf("negative input {}", n))
    }
    Ok(n * 10)
}

fn main() {
    // Every child succeeds: the cohort answers Ok.
    let all_ok = cohort {
        let _a = spawn(|| work(1))
        let _b = spawn(|| work(2))
        let _c = spawn(|| work(3))
    }
    println("all ok: {:?}", all_ok)

    // A child fails: fail-fast reports that child's error.
    let one_failed = cohort {
        let _a = spawn(|| work(1))
        let _b = spawn(|| work(-2))
    }
    println("one failed: {:?}", one_failed)

    // The lowest-index failure is the reported one, whichever child
    // happens to finish first, so this answer never varies.
    let two_failed = cohort {
        let _a = spawn(|| work(-1))
        let _b = spawn(|| work(-2))
    }
    println("two failed: {:?}", two_failed)

    // A cohort's value composes with `?` like any fallible call.
    match run_stage() {
        Ok(()) => println("stage: ok")
        Err(e) => println("stage: {}", e)
    }

    // Nested cohorts: the inner one is joined before the outer sees it.
    let nested = cohort {
        let _outer = spawn(|| work(4))
        let inner = cohort {
            let _x = spawn(|| work(5))
        }
        println("inner: {:?}", inner)
    }
    println("nested: {:?}", nested)

    // A child that panics fails its cohort rather than the process.
    let panicked = cohort {
        let _p = spawn(|| -> Result<i64, errors::Error> {
            panic("child gave up")
        })
    }
    println("panicked: {}", panicked.is_err())

    // An empty cohort has nothing to wait for.
    let empty = cohort {}
    println("empty: {:?}", empty)
}

fn run_stage() -> Result<(), errors::Error> {
    cohort {
        let _a = spawn(|| work(7))
    }?
    Ok(())
}
