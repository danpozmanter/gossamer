// fs::metadata struct-field access must marshal bit-identically on
// every tier. The compiled tiers fold a 6-slot leaf tuple
// (`gos_rt_fs_metadata_raw`) into a real `Metadata` struct via an
// injected Gossamer wrapper (the x509 `CertInfo` pattern), so
// `fs::metadata(p).size` / `.is_file` lower natively instead of
// SIGSEGV-ing on the old size-only `Result<i64>` shim.

use std::env
use std::fs
use std::path

fn main() {
    let dir = path::join(&env::temp_dir(), &"gossamer-fs-metadata-demo")
    let _ = fs::create_dir_all(&dir)
    let file = path::join(&dir, &"probe.txt")
    let _ = fs::write(&file, "hello, gossamer\n".as_bytes())

    let m = fs::metadata(&file).unwrap()
    println!(
        "file: size={} is_file={} is_dir={} is_symlink={} readonly={}"
        m.size, m.is_file, m.is_dir, m.is_symlink, m.readonly
    )
    assert(m.size > 0, "file size positive")
    assert_eq(m.size, 16, "known content length")
    assert(m.is_file, "is_file true")
    assert(!m.is_dir, "file not dir")
    assert(m.modified_unix_ms > 0, "modified timestamp present")

    let d = fs::metadata(&dir).unwrap()
    println!("dir: is_file={} is_dir={}", d.is_file, d.is_dir)
    assert(d.is_dir, "dir is_dir true")
    assert(!d.is_file, "dir not file")

    let _ = fs::remove_dir_all(&dir)
    println!("ok")
}
