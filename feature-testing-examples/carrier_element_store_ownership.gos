// An `Option` / `Result` element written through an index takes its own
// share of the payload the carrier points at. The sequence owns what it
// holds for as long as it lives, so the temporary the store copied from
// is free to release its own share on its next overwrite and at the
// return sweep. Each check builds a sequence, allocates over it, and
// reads it back, so an element naming a released block reads whatever
// the later allocation put there. Every boundary here is a scalar, which
// keeps the bodies inside the JIT's admission rules.
// Bit-identical on the VM, Cranelift, and LLVM tiers.

fn array_of_option_tuples(base: i64) -> i64 {
    let mut xs: [Option<(i64, i64)>; 16] = [None; 16]
    let mut i = 0
    while i < 16 {
        xs[i] = Some((base + i, base + i * 2))
        i += 1
    }
    // Allocations of the same shape, after the sequence is complete.
    let mut churn: [Option<(i64, i64)>; 16] = [None; 16]
    let mut j = 0
    while j < 16 {
        churn[j] = Some((-1, -1))
        j += 1
    }
    let mut total = 0
    for k in 0..16 {
        match xs[k] {
            Some((a, b)) => total += a + b
            None => total += 100000
        }
    }
    total
}

fn vec_of_option_tuples(base: i64) -> i64 {
    let mut xs: Vec<Option<(i64, i64)>> = #[None; 16]
    let mut i = 0
    while i < 16 {
        xs[i] = Some((base + i, base + i * 2))
        i += 1
    }
    let mut churn: Vec<Option<(i64, i64)>> = #[None; 16]
    let mut j = 0
    while j < 16 {
        churn[j] = Some((-1, -1))
        j += 1
    }
    let mut total = 0
    for k in 0..16 {
        match xs[k] {
            Some((a, b)) => total += a + b
            None => total += 100000
        }
    }
    total
}

fn array_of_result_tuples(base: i64) -> i64 {
    let mut xs: [Result<(i64, i64), i64>; 12] = [Err(0); 12]
    let mut i = 0
    while i < 12 {
        xs[i] = Ok((base + i, base + i))
        i += 1
    }
    let mut churn: [Result<(i64, i64), i64>; 12] = [Err(0); 12]
    let mut j = 0
    while j < 12 {
        churn[j] = Ok((-1, -1))
        j += 1
    }
    let mut total = 0
    for k in 0..12 {
        match xs[k] {
            Ok((a, b)) => total += a + b
            Err(e) => total += e
        }
    }
    total
}

fn array_of_string_payloads(base: i64) -> i64 {
    let mut xs: [Option<(String, i64)>; 8] = [None; 8]
    let mut i = 0
    while i < 8 {
        xs[i] = Some((format!("s{}", base + i), base + i))
        i += 1
    }
    let mut churn: [Option<(String, i64)>; 8] = [None; 8]
    let mut j = 0
    while j < 8 {
        churn[j] = Some((format!("junk{}", j), -1))
        j += 1
    }
    // The text is part of the answer: a reused block shows up as a
    // different length here, not only as a different number.
    let mut total = 0
    for k in 0..8 {
        match xs[k] {
            Some((s, n)) => total += s.len() * 1000 + n
            None => total += 100000
        }
    }
    total
}

// The conditional store the issue reported: one slot is written many
// times, so every carrier it held earlier is a candidate for reuse.
fn conditional_store_fingerprint() -> i64 {
    let mut slots: [Option<(i64, i64)>; 12] = [None; 12]
    let mut pairs: Vec<(i64, i64)> = #[]
    for i in 0..40 {
        pairs.push((i % 12, i))
    }
    let mut head = 0
    while head < pairs.len() {
        let (k, v) = pairs[head]
        head += 1
        if k % 2 == 0 {
            slots[k] = Some((v, k))
        }
    }
    let mut sum = 0
    for j in 0..12 {
        match slots[j] {
            Some((a, b)) => sum += j * 1000 + a + b
            None => ()
        }
    }
    sum
}

fn main() {
    println!("array: {} {} {}", array_of_option_tuples(0), array_of_option_tuples(1000), array_of_option_tuples(100000))
    println!("vec: {} {} {}", vec_of_option_tuples(0), vec_of_option_tuples(1000), vec_of_option_tuples(100000))
    println!("result: {} {}", array_of_result_tuples(0), array_of_result_tuples(100000))
    println!("string: {} {}", array_of_string_payloads(0), array_of_string_payloads(500000))
    // Repeated so a body reaches the JIT threshold and the same answer
    // has to come back from the compiled entry.
    let mut i = 0
    while i < 8 {
        let f = conditional_store_fingerprint()
        if f != 30228 {
            println!("conditional diverged: {}", f)
        }
        i += 1
    }
    println!("conditional: {}", conditional_store_fingerprint())
}
