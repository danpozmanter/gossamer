// std::validate - handle dispatch across function boundaries.
//
// Locks method dispatch on `validate::Errors` / `validate::FieldError`
// values that flow OUT of a function (return) and IN to a function
// (parameter), not just on locals built in the same scope. A validate
// handle is an opaque i64 with no construction-site tag once it crosses
// a boundary, so dispatch must recover the handle kind from the
// receiver's named type. Output is keyed by field in sorted order, so
// it is bit-identical across the bytecode VM (`gos`), the Cranelift
// JIT, and the LLVM AOT tier (`gos build`).
use std::validate

// Returns a populated `Errors` so the caller dispatches on a value that
// carries no local construction tag.
fn build_errors() -> validate::Errors {
    let errs = validate::Errors::new()
    errs.add("name", validate::FieldError::new("name", "must not be empty", "required"))
    errs.add("name", validate::FieldError::new("name", "too short", "length"))
    errs.add("age", validate::FieldError::new("age", "must be >= 0", "range"))
    errs
}

// Returns a single `FieldError` so its accessors dispatch on a returned
// handle.
fn first_field_error() -> validate::FieldError {
    validate::FieldError::new("email", "is not valid", "format")
}

// Dispatches on an `Errors` received by parameter.
fn summarize(errs: validate::Errors) {
    println!("param is_empty: {}", errs.is_empty())
    println!("param len: {}", errs.len())
    println!("param collect: {}", errs.collect())
}

fn main() {
    let errs = build_errors()
    println!("is_empty: {}", errs.is_empty())
    println!("len: {}", errs.len())
    println!("count name: {}", errs.count("name"))
    println!("count missing: {}", errs.count("missing"))
    println!("get name: {}", errs.get("name"))
    println!("collect: {}", errs.collect())

    let fe = first_field_error()
    println!("fe path: {}", fe.path())
    println!("fe message: {}", fe.message())
    println!("fe code: {}", fe.code())

    summarize(build_errors())
}
