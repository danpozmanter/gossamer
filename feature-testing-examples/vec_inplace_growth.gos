// Dynamically-built numeric Vecs grow in place (amortized O(1) push)
// and use flat typed storage (IntArray / FloatVec, 8 bytes per element).
// These are perf-only changes: the output here is identical to a
// deep-copy-per-op, boxed-storage implementation, and identical across
// the VM, Cranelift, and LLVM tiers. Scalar-only output keeps the
// fixture lowerable on the LLVM tier.
fn unwrap_or(o: Option<i64>, d: i64) -> i64 {
    match o {
        Some(v) => v
        None => d
    }
}

fn main() {
    // i64 Vec built via Vec::new + push loop (flat IntArray storage),
    // then pop, sort, and reduce - the canonical O(n) accumulation.
    let mut nums = Vec::new()
    for i in 0..6 { nums.push((i * 7) % 5) }
    let last = unwrap_or(nums.pop(), -1)
    nums.sort()
    let mut total = 0
    for x in nums { total += x }
    println!("nums_total={} nums_len={} pop={}", total, nums.len(), last)

    // f64 Vec built via Vec::new + push loop (flat FloatVec storage).
    let mut fs: Vec<f64> = Vec::new()
    for k in 0..4 { fs.push((3 - k) as f64 + 0.5) }
    fs.sort()
    println!("f0={:.1} f3={:.1}", fs[0], fs[3])

    // pop drains the Vec, then yields None (-> -1) past the end.
    let mut stack = Vec::new()
    stack.push(100)
    stack.push(200)
    let a = unwrap_or(stack.pop(), -1)
    let b = unwrap_or(stack.pop(), -1)
    let c = unwrap_or(stack.pop(), -1)
    println!("pops={} {} {} drained_len={}", a, b, c, stack.len())

    // Integer range driven by iteration.
    let mut rsum = 0
    for x in 0..100 { rsum += x }
    println!("rsum={}", rsum)
}
