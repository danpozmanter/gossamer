// A value-position range is an i64 sequence on every tier: it pipes
// into the iter combinators, binds as a Vec, and prints like one.
use std::iter

fn main() {
    let squares = 0..4 |> iter::map(|i| i * i)
    println!("{:?}", squares)
    println!("{}", 0..5 |> iter::sum)
    let evens = 2..11 |> iter::filter(|k| k % 2 == 0)
    println!("{:?} {}", evens, evens.last().unwrap())
    let r = 1..=3
    println!("{:?} {}", r, r.len())
    let n = 6
    let sieve = [true; n]
    let live = 2..n |> iter::filter(|k| sieve[k] && k != 4)
    println!("{:?}", live)
}
