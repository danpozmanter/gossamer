// A Map value that owns heap children (a String and a Vec) must keep
// those children alive after the inserting binding drops: the stored entry
// aliases the value's single owning reference, so the source's drop must
// not release them. Allocation churn between insert and read would expose a
// premature free as corrupted reads. Must print `ok=50` on every tier.

use std::collections::Map

struct Item { name: String, tags: Vec<String>, n: i64 }

fn make(k: i64) -> Item {
    let mut tags: Vec<String> = Vec::from([])
    tags.push(format!("tag-{}", k))
    Item { name: format!("item-name-number-{}", k), tags: tags, n: k }
}

fn churn() -> i64 {
    let mut acc = 0
    let mut i = 0
    while i < 20000 {
        let s = format!("scratch-{}", i)
        acc += s.len()
        i += 1
    }
    acc
}

fn main() {
    let mut m: Map<i64, Item> = Map::new()
    let mut k = 0
    while k < 50 {
        m.insert(k, make(k))
        k += 1
    }
    let _ = churn()
    let mut ok = 0
    let mut key = 0
    while key < 50 {
        match m.get(key) {
            Some(it) => {
                if it.name == format!("item-name-number-{}", key) && it.tags.len() == 1 {
                    ok += 1
                }
            }
            None => {}
        }
        key += 1
    }
    println!("ok={}", ok)
}
