// Cross-tier fixture for `std::net::smtp`: a loopback SMTP transaction
// against a server written in the fixture itself, so the whole
// conversation - greeting, EHLO, MAIL FROM, RCPT TO, DATA, the
// dot-terminated body, QUIT - is exercised on every tier.
//
// Binds 127.0.0.1:0 and reads the port back, so the parallel SPECS walk
// has no fixed port to contend for. The rendered message carries a
// Message-ID built from the wall clock and the process id, so the
// fixture reports what it found in the body rather than the body.

use std::net
use std::net::smtp
use std::sync::channel

fn sender(addr: String, tx: Sender<String>) {
    match smtp::send(addr, "a@example.com", "b@example.com", "hello", "one\n.\ntwo") {
        Ok(_) => tx.send("sent")
        Err(e) => tx.send(format("failed: {}", e))
    }
}

fn main() {
    let listener = match net::TcpListener::bind("127.0.0.1:0") {
        Ok(l) => l
        Err(e) => { println("bind failed: {}", e)
            return }
    }
    let addr = match listener.local_addr() {
        Ok(a) => a
        Err(e) => { println("addr failed: {}", e)
            return }
    }
    let tx, rx = channel()
    spawn(|| sender(addr, tx))
    let stream, _peer = match listener.accept() {
        Ok(p) => p
        Err(e) => { println("accept failed: {}", e)
            return }
    }
    let _ = stream.write("220 fixture ESMTP ready\r\n".as_bytes())

    let mut buf = ""
    let mut body = ""
    let mut in_data = false
    let mut envelope = ""
    let mut talking = true
    while talking {
        let chunk = match stream.read(4096) {
            Ok(b) => b
            Err(_) => break
        }
        if chunk.len() == 0 { break }
        let text = match String::from_utf8(chunk) {
            Ok(t) => t
            Err(_) => break
        }
        buf += text
        while let Some((line, rest)) = buf.split_once("\r\n") {
            buf = rest
            if in_data {
                if line == "." {
                    in_data = false
                    let _ = stream.write("250 queued\r\n".as_bytes())
                } else {
                    body += line
                    body += "\n"
                }
            } else if line.starts_with("EHLO") {
                let _ = stream.write("250-fixture\r\n250 OK\r\n".as_bytes())
            } else if line.starts_with("MAIL FROM") {
                envelope += line
                envelope += " "
                let _ = stream.write("250 OK\r\n".as_bytes())
            } else if line.starts_with("RCPT TO") {
                envelope += line
                let _ = stream.write("250 OK\r\n".as_bytes())
            } else if line == "DATA" {
                in_data = true
                let _ = stream.write("354 go ahead\r\n".as_bytes())
            } else if line == "QUIT" {
                let _ = stream.write("221 bye\r\n".as_bytes())
                talking = false
            } else {
                let _ = stream.write("500 unrecognized\r\n".as_bytes())
            }
        }
    }
    let _ = stream.close()
    let _ = listener.close()

    println("envelope: {}", envelope)
    println("headers: from={} to={} subject={}"
        body.contains("From: a@example.com")
        body.contains("To: b@example.com")
        body.contains("Subject: hello"))
    // A body line that is just a dot is sent as "..", so it cannot end
    // the DATA block early.
    println("body: one={} stuffed={} two={}"
        body.contains("\none\n")
        body.contains("\n..\n")
        body.contains("\ntwo\n"))
    match rx.recv() {
        Some(status) => println("client: {}", status)
        None => println("client: no result")
    }
}
