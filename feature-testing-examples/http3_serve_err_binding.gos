// Cross-tier regression for the `http_h3::serve` Result surface.
// HTTP/3 mandates TLS, so the server reads the cert / key PEM
// before binding; a missing cert file is a startup failure that is
// the caller's `Err` value on every tier (VM, Cranelift, LLVM) -
// not a panic. The serve expression is typed
// `Result<(), errors::Error>`, so matching it and formatting the
// `Err` payload exercises the same handler-fn-ptr dispatch the h1 /
// h2 servers use.
//
// The cert path is guaranteed absent, so this fixture reads no live
// socket and is fully deterministic: it prints
// `about to bind` then a `read cert` error line and exits 0. Both
// tiers reach the failure through `std::fs::read`, so the OS error
// text is identical across tiers. The exact text + exit code are
// pinned by `http3_serve_err_binding_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::http_h3

struct App { }

impl http::Handler for App {
    fn serve(&self, _r: http::Request) -> http::Response {
        http::Response::text(200, "ok")
    }
}

fn main() {
    println!("about to bind")
    let result = http_h3::serve(
        "127.0.0.1:0",
        "/nonexistent/gossamer-h3-cert.pem",
        "/nonexistent/gossamer-h3-key.pem",
        App(),
    )
    match result {
        Ok(_) => println!("unexpected ok"),
        Err(e) => println!("Error: {}", e),
    }
}
