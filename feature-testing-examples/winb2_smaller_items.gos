// Regression for the 0.18.0 smaller tier-parity items:
// - `String::from(s)` is identity for a string (was VM error / compiled build-fail).
// - `s.parse()`'s error type pins to errors::Error so `{}` Display of an Err
//   lowers correctly on the compiled tier (was a garbage char).
// Output must be bit-identical across the VM, Cranelift, and LLVM tiers.

fn main() {
    let s = String::from("hello")
    println!("from={}", s)

    let ok: Result<i64, _> = "42".parse()
    let bad: Result<i64, _> = "abc".parse()
    match ok {
        Ok(n) => println!("ok={}", n),
        Err(e) => println!("okerr=[{}]", e),
    }
    match bad {
        Ok(n) => println!("bad={}", n),
        Err(e) => println!("baderr=[{}]", e),
    }

    let a = [10, 20, 30]
    println!("inb={}", a[1])
}
