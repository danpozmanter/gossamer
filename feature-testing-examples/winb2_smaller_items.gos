// Regression for the 0.18.0 smaller tier-parity items:
// - `String::from(s)` is identity for a string (was VM error / compiled build-fail).
// - `s.to_i64()` answers an `Option<i64>`, and `{}` of its `None` renders
//   identically on every tier.
// Output must be bit-identical across the VM, Cranelift, and LLVM tiers.

fn main() {
    let s = String::from("hello")
    println("from={}", s)

    let ok: Option<i64> = "42".to_i64()
    let bad: Option<i64> = "abc".to_i64()
    match ok {
        Some(n) => println("ok={}", n)
        None => println("okerr=[not a number]")
    }
    match bad {
        Some(n) => println("bad={}", n)
        None => println("baderr=[not a number]")
    }

    let a = #[10, 20, 30]
    println("inb={}", a[1])
}
