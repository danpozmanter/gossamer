// A multi-field struct (including a heap `String` field) sent over a channel
// and received through a *local* binding's `Receiver` - both an inferred
// `let (tx, rx) = channel()` and a recv in the same function as the send.
// The recv'd payload is a boxed pointer that must deref for field access; the
// channel handle must wire correctly through the inferred `(Sender, Receiver)`
// tuple. Must print identical output on every tier.

use std::sync::channel

struct Msg { id: i64, text: String }

fn produce(tx: Sender<Msg>) {
    tx.send(Msg { id: 1, text: format!("ab") })
    tx.send(Msg { id: 2, text: format!("cde") })
    tx.close()
}

fn consume(rx: Receiver<Msg>) -> i64 {
    let mut total = 0
    while let Some(m) = rx.recv() {
        total += m.id + m.text.len()
    }
    total
}

fn main() {
    // Inferred channel, recv via a typed-parameter Receiver.
    let (tx1, rx1) = channel()
    go produce(tx1)
    let via_param = consume(rx1)

    // Inferred channel, send and recv in the same function on a local Receiver.
    let (tx2, rx2) = channel()
    tx2.send(Msg { id: 10, text: format!("xy") })
    tx2.send(Msg { id: 20, text: format!("zzz") })
    tx2.close()
    let mut via_local = 0
    while let Some(m) = rx2.recv() {
        via_local += m.id + m.text.len()
    }

    println!("via_param={} via_local={}", via_param, via_local)
}
