// String indexing, ranges, substring, and len use Unicode scalar positions.
// Explicit byte access remains available through as_bytes and byte_at.

fn main() {
    let s = "ąčęėšž"
    println!("len={}", s.len())
    println!("chars={} {}", s[0], s[5])
    println!("range={}", s[1..3])
    println!("substring={}", s.substring(0, 2))
    match s.slice(2, 4) {
        Ok(piece) => println!("slice={}", piece)
        Err(err) => println!("slice error={}", err)
    }
    match s.find("ė") {
        Some(index) => println!("find={} char={}", index, s[index])
        None => println!("find=none")
    }
    let bytes = s.as_bytes()
    println!("bytes={} {}", bytes[0], bytes[1])

    let long = "ąąąąąąąąąąąąąąąąąąąąąąąąąąąąąąąąčę"
    println!("block={} {}", long[32], long[33])
    let mut grown = String::with_capacity(96)
    for _ in 0..33 { grown.push('ą') }
    grown.push('ž')
    println!("grown={} len={}", grown[33], grown.len())
}
