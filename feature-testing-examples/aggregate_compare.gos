// Structural comparison of aggregates, bit-identical on every tier:
// fixed arrays and growable Vecs compare element-wise with `==`/`!=`;
// tuples compare lexicographically with all six operators (the VM walks
// them at runtime, the compiled tiers route to gos_rt_tuple_cmp /
// gos_rt_vec_eq). Closes the silent footguns where `[1,2,3] == [1,2,3]`
// returned `false` and `(1,2) < (1,3)` panicked.
fn main() {
    println!("{} {}", [1, 2, 3] == [1, 2, 3], [1, 2, 3] == [1, 2, 4])
    println!("{} {}", (1, 2) < (1, 3), (2, 0) < (1, 9))
    println!("{} {}", ("a", 2) < ("a", 5), ("b", 1) < ("a", 9))
    println!("{}", (1, 2.5) == (1, 2.5))
    println!("{} {}", (3, 4) >= (3, 4), (1, 2) != (1, 2))
    let mut v: Vec<i64> = Vec::from([])
    v.push(10)
    v.push(20)
    let mut w: Vec<i64> = Vec::from([])
    w.push(10)
    w.push(20)
    println!("{} {}", v == w, v == Vec::from([10, 99]))
    println!("{}", ["x", "y"] == ["x", "y"])
}
