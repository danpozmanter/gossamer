// Fundamental String-building surface: String::new, String::with_capacity,
// push(char), push_str(&str), and chars() driving a for-loop. Output is
// deterministic and multibyte-aware (the cedilla 'ç' is two UTF-8
// bytes, the euro 'EUR' sign three), so the tier-parity harness asserts
// the rendered strings are bit-identical on VM, Cranelift, and LLVM.
// The explicit asserts distinguish Unicode scalar lengths from UTF-8 bytes.

// Mirror of the escape-helper shape real code uses: walk a string's
// chars, pushing each (or an escaped form) onto a freshly-built String.
fn escape(text: &String) -> String {
    let mut out = String::new()
    for ch in text.chars() {
        match ch {
            '<' => out.push_str("&lt;")
            '>' => out.push_str("&gt;")
            '&' => out.push_str("&amp;")
            _ => out.push(ch)
        }
    }
    out
}

fn main() {
    // String::new + push(char) + push_str.
    let mut s = String::new()
    s.push('h')
    s.push('i')
    s.push_str(", ")
    s.push_str("world")
    s.push('!')
    println!("s={}", s)
    assert_eq(s.len(), 10)

    // `with_capacity` is a real VM builder reservation; its contents remain
    // ordinary String text on every tier.
    let mut reserved = String::with_capacity(64)
    reserved.push_str("reserved")
    reserved.push('!')
    println!("reserved={}", reserved)
    assert_eq(reserved.len(), 9)

    // chars() over a multibyte string, rebuilt char-by-char - the
    // round-trip must be identity on every tier.
    let original = "abçd€f"
    let mut rebuilt = String::new()
    let mut count = 0
    for ch in original.chars() {
        rebuilt.push(ch)
        count += 1
    }
    println!("rebuilt={} count={}", rebuilt, count)
    assert_eq(count, 6)
    assert_eq(rebuilt.len(), original.len())

    // Escape helper: markup chars expand, others pass through.
    let escaped = escape(&"a<b>&\"cç\"")
    println!("escaped={}", escaped)
    assert_eq(escaped.len(), 19)
    assert_eq(escaped.as_bytes().len(), 20)
}
