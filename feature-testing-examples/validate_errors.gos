// std::validate - FieldError + Errors data handles.
//
// Covers: FieldError::new + path/message/code accessors, Errors::new,
// add, is_empty, len, count, get, collect. Errors are keyed by field
// in sorted order, so stdout is bit-identical across the bytecode VM
// (`gos` / `gos test`), the Cranelift JIT, and the LLVM AOT tier
// (`gos build`). Exercises the runtime-kind tagging path so method
// dispatch on each handle picks the right runtime helper on every tier.

use std::validate

fn main() {
    let fe = validate::FieldError::new("name", "must not be empty", "required")
    println("path: {}", fe.path())
    println("message: {}", fe.message())
    println("code: {}", fe.code())

    let errs = validate::Errors::new()
    println("empty before: {}", errs.is_empty())

    errs.add("name", fe)
    let fe2 = validate::FieldError::new("name", "too short", "length")
    errs.add("name", fe2)
    let fe3 = validate::FieldError::new("age", "must be >= 0", "range")
    errs.add("age", fe3)

    println("empty after: {}", errs.is_empty())
    println("len: {}", errs.len())
    println("count name: {}", errs.count("name"))
    println("count missing: {}", errs.count("missing"))
    println("get name: {}", errs.get("name"))
    println("collect: {}", errs.collect())
}
