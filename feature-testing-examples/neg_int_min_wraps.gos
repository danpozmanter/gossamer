// Optimised release arithmetic wraps like Rust release arithmetic.
// Debug execution intentionally panics while constructing `i64::MIN`, so
// profile-specific coverage lives in `spec_conformance.rs` rather than the
// ordinary VM-versus-release parity walk.
fn main() {
    let mut n = 1
    for _ in 0..63 {
        n = n * 2
    }
    let m = -n
    println!("min={}", n)
    println!("neg_min={}", m)
    println!("eq={}", n == m)
}
