// spawn(f) runs f on a goroutine and hands back a join handle;
// handle.join() blocks for the outcome as Result<T, String> - Ok with
// the returned value, or Err with the panic message if the goroutine
// panicked. Exercises the spawn/join surface byte-identically across
// the bytecode VM, the Cranelift JIT, and the LLVM AOT backend.

fn compute() -> i64 {
    6 * 7
}

fn boom() -> i64 {
    panic!("boom")
}

fn main() {
    // Bare-fn spawn: the function is coerced through the per-shape
    // callable thunk before it runs on the goroutine.
    let h1 = spawn(compute)
    match h1.join() {
        Ok(v) => println!("ok {}", v),
        Err(e) => println!("err {}", e),
    }

    // Capturing-closure spawn: the lifted body reads `base` from the
    // closure environment on the spawned goroutine.
    let base = 100
    let h2 = spawn(|| base + 11)
    match h2.join() {
        Ok(v) => println!("ok {}", v),
        Err(e) => println!("err {}", e),
    }

    // A panic on the spawned goroutine surfaces as Err(message); the
    // unwind crosses the thunk frame back into the runtime's catch.
    let h3 = spawn(boom)
    match h3.join() {
        Ok(v) => println!("ok {}", v),
        Err(e) => println!("err {}", e),
    }
}

#[cfg(test)]
mod tests {
    use std::testing

    fn doubler(n: i64) -> i64 {
        n * 2
    }

    #[test]
    fn join_returns_ok_with_value() {
        let h = spawn(|| doubler(21))
        match h.join() {
            Ok(v) => testing::check_eq(&v, &42, "ok value"),
            Err(_) => testing::check(false, "expected Ok"),
        }
    }

    #[test]
    fn join_captures_panic_as_err() {
        let h = spawn(|| super::boom())
        match h.join() {
            Ok(_) => testing::check(false, "expected Err"),
            Err(e) => testing::check_eq(&e, &"boom", "panic message"),
        }
    }

    #[test]
    fn join_propagates_captured_environment() {
        let base = 1000
        let h = spawn(|| base + 7)
        match h.join() {
            Ok(v) => testing::check_eq(&v, &1007, "captured env"),
            Err(_) => testing::check(false, "expected Ok"),
        }
    }
}
