// An explicitly constructed empty Vec grown inside a `while` loop must
// infer its element type from `push`. This fixture builds and drops many
// such vecs and reads them back, and must stay bit-identical across the VM,
// Cranelift, and LLVM tiers.

fn build(n: i64) -> i64 {
    let mut xs = Vec::new()
    let mut i = 0
    while i < n {
        xs.push(i * 3)
        i += 1
    }
    let mut sum = 0
    for x in xs {
        sum += x
    }
    sum
}

fn main() {
    let mut total = 0
    let mut r = 0
    while r < 200 {
        total += build(30)
        r += 1
    }
    println("total: {}", total)
}
