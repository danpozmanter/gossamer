// `.clone()` is a universal builtin - no derive needed (`#[derive(Clone)]`
// is rejected, GT0025). A `String` / `Vec` receiver resolves to the builtin
// clone by type key (or by bare-name fallback to the prelude); a struct or
// enum receiver round-trips through the same builtin by value. Bit-identical
// on the bytecode VM, Cranelift JIT, and LLVM AOT (incl. `--release`).

struct Point { x: i64, y: i64 }

enum Val { I(i64), T(String), N }

fn main() {
    let s = "hello"
    println("str: {}", s.clone())

    let xs: Vec<String> = Vec::from(["a", "b", "c"])
    let ys = xs.clone()
    println("vec: {} {}", ys.len(), ys[2])

    let p = Point { x: 3, y: 4 }
    let q = p.clone()
    println("point: {} {}", q.x, q.y)

    let v = Val::T("vt")
    match v.clone() {
        Val::T(t) => println("val: {}", t)
        _ => println("val: ?")
    }
}
