// Iterating a `&mut` sequence binds each element as a writable place: a
// scalar is incremented through the binding, a heap element is mutated
// through the pointer its slot holds, and an assignment replaces the slot.
// A shared `&[T]` still binds by value. Identical on every tier.

struct P { x: i64 }
fn bump(xs: &mut [i64]) { for x in xs { *x += 1 } }
fn shift(rows: &mut [Vec<i64>]) { for row in rows { row.push(9) } }
fn replace(rows: &mut [Vec<i64>]) { for row in rows { *row = #[7] } }
fn rename(names: &mut [String]) { for n in names { *n += "!" } }
fn nudge(ps: &mut [P]) { for p in ps { p.x += 1 } }
fn total(xs: &[i64]) -> i64 { let mut acc = 0
    for x in xs { acc += x }
    acc }
fn main() {
    let mut a = #[1, 2, 3]
    bump(&mut a)
    println!("scalar   = {:?}", a)
    let mut g = #[#[1], #[2]]
    shift(&mut g)
    println!("nested   = {:?}", g)
    let mut h = #[#[1], #[2]]
    replace(&mut h)
    println!("replace  = {:?}", h)
    let mut n = #["a", "b"]
    rename(&mut n)
    println!("strings  = {:?}", n)
    let mut ps = #[P { x: 1 }, P { x: 2 }]
    nudge(&mut ps)
    println!("structs  = {} {}", ps[0].x, ps[1].x)
    println!("readonly = {}", total(&#[1, 2, 3]))
    let mut inline = #[#[1]]
    for row in &mut inline { row.push(5) }
    println!("inline   = {:?}", inline)
}
