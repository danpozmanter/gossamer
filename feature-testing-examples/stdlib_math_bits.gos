// Cross-tier parity for math::bits previously VM-only — scalar
// primitives plus the carrying add/sub/mul/div tuple returns.
use std::math

fn main() {
    println!("{}", math::bits::count_ones(255))
    println!("{}", math::bits::count_zeros(255))
    println!("{}", math::bits::leading_zeros(1))
    println!("{}", math::bits::trailing_zeros(8))
    println!("{}", math::bits::reverse_bytes(1))
    println!("{}", math::bits::len(255))
    println!("{}", math::bits::rotate_left(1, 4))
    println!("{}", math::bits::rotate_right(16, 4))
    println!("{}", math::bits::reverse_bits(1))
    let (s, c) = math::bits::add(18446744073709551615, 1, 0)
    println!("add {} {}", s, c)
    let (d, bo) = math::bits::sub(0, 1, 0)
    println!("sub {} {}", d, bo)
    let (hi, lo) = math::bits::mul(4294967296, 4294967296)
    println!("mul {} {}", hi, lo)
    let (q, r) = math::bits::div(0, 100, 7)
    println!("div {} {}", q, r)
}
