// Structs and enums compare by value with no `#[derive(...)]`: `==`, `!=`,
// and the ordering operators are synthesized automatically for every
// by-value-comparable type, exactly as they already work on tuples. Output
// must be bit-identical across the bytecode VM, Cranelift, and LLVM.

struct Point { x: i64, y: i64 }

struct Segment { from: Point, to: Point, label: String }

enum Shape {
    Dot
    Line(i64)
    Box(i64, i64)
    Named(i64)
}

fn main() {
    // Struct equality and ordering, no derive.
    println!("{}", Point { x: 1, y: 2 } == Point { x: 1, y: 2 })
    println!("{}", Point { x: 1, y: 2 } != Point { x: 1, y: 9 })
    println!("{}", Point { x: 1, y: 2 } < Point { x: 1, y: 3 })
    println!("{}", Point { x: 2, y: 0 } < Point { x: 1, y: 9 })
    println!("{}", Point { x: 5, y: 5 } <= Point { x: 5, y: 5 })

    // Nested struct + String field: lexicographic by declaration order.
    let a = Segment { from: Point { x: 0, y: 0 }, to: Point { x: 1, y: 1 }, label: "ab" }
    let b = Segment { from: Point { x: 0, y: 0 }, to: Point { x: 1, y: 1 }, label: "ac" }
    println!("{}", a < b)
    println!("{}", a == a)

    // Enum: variant rank first, then payload lexicographically.
    println!("{}", Shape::Dot < Shape::Line(0))
    println!("{}", Shape::Line(1) < Shape::Line(2))
    println!("{}", Shape::Box(1, 2) < Shape::Box(1, 3))
    println!("{}", Shape::Box(5, 0) < Shape::Box(1, 9))
    println!("{}", Shape::Named(1) < Shape::Named(2))
    println!("{}", Shape::Box(1, 2) == Shape::Box(1, 2))
    println!("{}", Shape::Line(1) < Shape::Box(0, 0))

    // `..` rest matches a multi-field tuple variant.
    let kind = match Shape::Box(7, 8) {
        Shape::Dot => 0
        Shape::Line(..) => 1
        Shape::Box(..) => 2
        Shape::Named(..) => 3
    }
    println!("{}", kind)

    // Ordering powers sort with no derive.
    let mut pts: Vec<Point> = Vec::from([
        Point { x: 3, y: 1 },
        Point { x: 1, y: 9 },
        Point { x: 2, y: 5 },
    ])
    pts.sort_by_key(|p| p.x)
    println!("{} {} {}", pts[0].x, pts[1].x, pts[2].x)
}
