// Temporary-resource helpers create collision-resistant paths under the
// system temporary root. The program prints only stable facts so it can run
// identically on VM and native tiers.

use std::{fs, path}

fn main() {
    let dir = match fs::temp_dir("gossamer-temp-resource") {
        Ok(path) => path
        Err(err) => { println("temp dir error: {}", err)
            return }
    }
    let nested = path::join(dir, "roundtrip.txt")
    match fs::write(nested, "temporary contents".as_bytes()) {
        Ok(_) => println("temp dir writable: true")
        Err(err) => { println("temp write error: {}", err)
            return }
    }
    println("temp dir exists: {}", fs::is_dir(dir))
    let _ = fs::remove_dir_all(dir)
    println("temp dir removed: {}", !fs::exists(dir))

    match fs::temp_file("gossamer-temp-resource") {
        Ok((file, file_path)) => {
            let _ = file.write_bytes("temporary file".as_bytes())
            let _ = file.close()
            println("temp file exists: {}", fs::exists(file_path))
            let _ = fs::remove_file(file_path)
            println("temp file removed: {}", !fs::exists(file_path))
        }
        Err(err) => println("temp file error: {}", err)
    }
}
