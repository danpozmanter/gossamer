// Cross-tier parity for the strings::* free-function surface that
// was previously only available in the bytecode VM.
use std::strings

fn main() {
    println("{}", strings::splitn("a,b,c,d", 2, ",").len())
    println("{}", strings::split_whitespace("  a  b   c ").len())
    println("{}", strings::split_whitespace("x y  z").len())
    println("{}", strings::replacen("aaaa", "a", "b", 2))
    println("{}", strings::to_title("hello world foo"))
    println("{}", strings::trim_matches("xxhellxx", "x"))
    println("[{}]", strings::pad_left("7", 4, '0'))
    println("[{}]", strings::pad_right("7", 4, '.'))
    println("{}", strings::contains("hello", "l"))
    println("{}", strings::contains_any("hello", "xyz"))
    println("{}", strings::contains_any("hello", "xyl"))
    println("{}", strings::equal_fold("HeLLo", "hello"))
    match strings::find("hello", "l") { Some(i) => println("ir={}", i), None => println("ir=none") }
    match strings::find_any("hello", "lo") { Some(i) => println("fa={}", i), None => println("fa=none") }
    match strings::rfind_any("hello", "lo") { Some(i) => println("ra={}", i), None => println("ra=none") }
    match strings::strip_prefix("foobar", "foo") { Some(s) => println("sp={}", s), None => println("sp=none") }
    match strings::strip_suffix("foobar", "xyz") { Some(s) => println("ss={}", s), None => println("ss=none") }
}
