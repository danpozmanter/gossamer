// option::default across payload shapes: the Some payload passes
// through, the fallback replaces a None — for i64, f64, and String
// payloads, both direct-call and |>-piped spellings.

use std::option

fn main() {
    let some_i: Option<i64> = Some(42)
    let none_i: Option<i64> = None
    println!("{}", some_i |> option::default(-1))
    println!("{}", none_i |> option::default(-1))

    let some_s: Option<String> = Some("payload")
    let none_s: Option<String> = None
    println!("{}", some_s |> option::default("fallback"))
    println!("{}", none_s |> option::default("fallback"))

    let some_f: Option<f64> = Some(2.5)
    let none_f: Option<f64> = None
    println!("{}", some_f |> option::default(0.5))
    println!("{}", none_f |> option::default(0.5))

    let direct = option::default(7, none_i)
    println!("{}", direct)

    let bound = some_s |> option::default("unused")
    let twice = bound + "!"
    println!("{}", twice)
}
