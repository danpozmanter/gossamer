// option::unwrap_or across payload shapes: the Some payload passes
// through, the fallback replaces a None - for i64, f64, and String
// payloads, both direct-call and |>-piped spellings.

use std::option

fn main() {
    let some_i: Option<i64> = Some(42)
    let none_i: Option<i64> = None
    println("{}", some_i |> |v| option::unwrap_or(v, -1))
    println("{}", none_i |> |v| option::unwrap_or(v, -1))

    let some_s: Option<String> = Some("payload")
    let none_s: Option<String> = None
    println("{}", some_s |> |v| option::unwrap_or(v, "fallback"))
    println("{}", none_s |> |v| option::unwrap_or(v, "fallback"))

    let some_f: Option<f64> = Some(2.5)
    let none_f: Option<f64> = None
    println("{}", some_f |> |v| option::unwrap_or(v, 0.5))
    println("{}", none_f |> |v| option::unwrap_or(v, 0.5))

    let direct = option::unwrap_or(none_i, 7)
    println("{}", direct)

    let bound = some_s |> |v| option::unwrap_or(v, "unused")
    let twice = bound + "!"
    println("{}", twice)
}
