// Tier-parity coverage for the inline Vec element get/set lowering on the
// compiled backends (Cranelift JIT + LLVM AOT). The compiled tiers lower a
// word-stride `v[i]` read/write to a direct load/store off the GosVec header
// instead of an opaque `gos_rt_vec_get_i64` / `gos_rt_vec_set_i64` call. This
// must stay byte-identical to the bytecode VM. Covers: Vec<f64> read + write
// (the spectral-norm matvec shape), Vec<i64> read + write, nested Vec<Vec<f64>>,
// and an aggregate element type (Vec<Point>, which stays on the runtime
// get_ptr path and must be unaffected). Invalid source indexing is covered by
// the dedicated all-tier panic fixture.

struct Point { x: f64, y: f64 }

// Vec<f64> indexed read in a tight loop (matvec inner product).
fn dot(a: &Vec<f64>, b: &Vec<f64>, n: i64) -> f64 {
    let mut s = 0.0
    for i in 0..n { s += a[i] * b[i] }
    s
}

fn main() {
    // Vec<f64> read + write.
    let mut v: Vec<f64> = []
    for k in 0..5 { v.push((k + 1) as f64 * 0.5) }
    v[2] = 9.25
    for x in v { print!("{:.2} ", x) }
    println!("")
    let mut sum = 0.0
    let mut i = 0
    while i < 5 { sum += v[i]; i += 1 }
    println!("sum={:.2}", sum)

    // Vec<i64> read + write.
    let mut w: Vec<i64> = []
    for k in 0..5 { w.push(k * 10) }
    w[0] = 100
    let mut wi = 0
    let mut acc = 0
    while wi < 5 { acc += w[wi]; wi += 1 }
    println!("acc={}", acc)

    // Nested Vec<Vec<f64>> read + write.
    let mut grid: Vec<Vec<f64>> = []
    for r in 0..3 {
        let mut row: Vec<f64> = []
        for c in 0..3 { row.push((r * 3 + c) as f64) }
        grid.push(row)
    }
    grid[1][1] = 42.5
    let mut gsum = 0.0
    let mut gi = 0
    while gi < 3 {
        let mut gj = 0
        while gj < 3 { gsum += grid[gi][gj]; gj += 1 }
        gi += 1
    }
    println!("gsum={:.2}", gsum)

    // Vec<f64> indexed-read kernel through a function boundary.
    let a: Vec<f64> = [1.0, 2.0, 3.0, 4.0]
    let b: Vec<f64> = [4.0, 3.0, 2.0, 1.0]
    println!("dot={:.2}", dot(&a, &b, 4))

    // Aggregate element type: stays on the runtime get_ptr path.
    let mut pts: Vec<Point> = []
    pts.push(Point(1.5, 2.5))
    pts.push(Point(3.5, 4.5))
    println!("pt={:.1},{:.1}", pts[1].x, pts[1].y)
}
