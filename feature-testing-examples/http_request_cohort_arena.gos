// Cross-tier regression for the two shapes a request should be written in.
//
// A request is a cohort: every goroutine the handler spawns is joined or
// cancelled before the response is written, so a request cannot leak the
// work it started. The first child failure cancels its siblings and
// becomes the block's `Err`, which the handler turns into a status.
//
// A request is an arena: everything the handler allocates inside `arena
// { }` is bump-allocated and freed wholesale when the block ends, so the
// per-request garbage never reaches the general allocator. Nothing
// allocated inside may escape - that is checked at compile time (GM0003),
// so the release is unconditional rather than hopeful.
//
// Binds port 0, so it needs no port lock. Self-terminating: the client
// runs in main and the program returns normally.

use std::errors
use std::http
use std::http::router
use std::time

/// A request as a cohort: two children, joined before the response.
///
/// The block's own value is the outcome - it joins every child on every
/// exit path - so the handler reads that rather than each handle. A `?`
/// inside the block propagates from the FUNCTION, not from the cohort, so
/// a handler that wants to answer a status reads the block's result.
fn fanout(_r: http::Request) -> Result<http::Response, errors::Error> {
    let mut parts = ""
    let joined = cohort {
        let a = spawn(|| part("a"))
        let b = spawn(|| part("b"))
        parts = format(
            "{} {}"
            a.join().unwrap_or(Ok("?")).unwrap_or("?")
            b.join().unwrap_or(Ok("?")).unwrap_or("?")
        )
    }
    match joined {
        Ok(_) => Ok(http::Response::text(200, format("fanout ok: {}", parts)))
        Err(e) => Ok(http::Response::text(500, format("fanout failed: {}", e)))
    }
}

/// A child that fails cancels its siblings and becomes the cohort's `Err`,
/// so one failing dependency answers a status rather than a stuck request.
fn fanout_fails(_r: http::Request) -> Result<http::Response, errors::Error> {
    let joined = cohort {
        let _a = spawn(|| part("a"))
        let _b = spawn(|| broken())
    }
    match joined {
        Ok(_) => Ok(http::Response::text(200, "unexpectedly ok"))
        Err(_) => Ok(http::Response::text(503, "dependency failed"))
    }
}

/// A request as an arena: the per-request garbage is freed wholesale.
fn assemble(_r: http::Request) -> Result<http::Response, errors::Error> {
    let mut rows = 0
    arena {
        let mut lines: Vec<String> = #[]
        let mut i = 0
        while i < 2_000 {
            lines.push(format("row {}", i))
            i += 1
        }
        rows = lines.len()
    }
    Ok(http::Response::text(200, format("rows={}", rows)))
}

fn part(name: String) -> Result<String, errors::Error> {
    time::sleep(20)
    Ok(format("{}!", name))
}

fn broken() -> Result<String, errors::Error> {
    Err(errors::new("upstream is down"))
}

fn status_and_body(url: String) -> String {
    match http::get(url, Vec::from([])) {
        Ok(r) => format("{} {}", r.status, r.body)
        Err(e) => format("error {}", e)
    }
}

fn main() -> Result<(), errors::Error> {
    let app = router::Router::new().get("/fanout", fanout).get("/fanout-fails", fanout_fails).get("/assemble", assemble)
    let s = http::Server::new()
    s.listen("127.0.0.1:0")?
    let addr = s.addr()
    spawn(|| run(s, app))
    time::sleep(300)

    println("fanout: {}", status_and_body(format("http://{}/fanout", addr)))
    println("fails: {}", status_and_body(format("http://{}/fanout-fails", addr)))
    // Repeated so a per-request arena that failed to release would show as
    // growth rather than a passing single run.
    let mut i = 0
    while i < 20 {
        let _ = http::get(format("http://{}/assemble", addr), Vec::from([]))
        i += 1
    }
    println("assemble: {}", status_and_body(format("http://{}/assemble", addr)))

    let _ = s.shutdown(2_000)
    Ok(())
}

fn run(s: http::Server, app: router::Router) {
    let _ = s.serve(app)
}
