fn main() {
    let n = 5
    let mut zeros: Vec<i64> = Vec::with_capacity(n)
    let mut flags: Vec<bool> = Vec::with_capacity(n)
    for _ in 0..n {
        zeros.push(0)
        flags.push(false)
    }
    println("{}", zeros.len())
    println("{}", flags.len())
    println("{}", zeros[2])
    println("{}", flags[3])

    // Verify elements via iteration
    let mut sum = 0
    for v in zeros {
        sum += v
    }
    println("{}", sum)

    let mut trues = 0
    for f in flags {
        if f { trues += 1 }
    }
    println("{}", trues)
}
