// Literal Forms
// Exercises hex, binary, octal, underscore-separated, and raw-string
// literals so all three execution tiers handle the same lexed values.

fn main() {
    let hex_ff = 0xFF
    let hex_80 = 0x80
    println("hex 0xFF = {}", hex_ff)
    println("hex 0x80 = {}", hex_80)

    let bin_f0 = 0b1111_0000
    let bin_5a = 0b0101_1010
    println("bin 0b1111_0000 = {}", bin_f0)
    println("bin 0b0101_1010 = {}", bin_5a)
    println("bin AND = {}", bin_f0 & bin_5a)

    let oct_755 = 0o755
    let oct_644 = 0o644
    println("oct 0o755 = {}", oct_755)
    println("oct 0o644 = {}", oct_644)

    let million = 1_000_000
    let sixty_five_k = 65_536
    println("1_000_000 = {}", million)
    println("65_536 = {}", sixty_five_k)

    let n: i32 = 100i32
    println("i32 suffix = {}", n)

    let raw = r"C:\Users\jane"
    println("raw len = {}", raw.len())
    println("raw has backslash = {}", raw.contains("\\"))
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn hex_values() {
        let _ = testing::check_eq(0xFF, 255, "0xFF == 255")
        let _ = testing::check_eq(0x80, 128, "0x80 == 128")
        let _ = testing::check_eq(0x1F, 31, "0x1F == 31")
    }

    #[test]
    fn binary_values() {
        let _ = testing::check_eq(0b1111_0000, 240, "0b1111_0000 == 240")
        let _ = testing::check_eq(0b0101_1010, 90, "0b0101_1010 == 90")
        let _ = testing::check_eq((0b1111_0000 & 0b0101_1010), 80, "AND == 80")
    }

    #[test]
    fn octal_values() {
        let _ = testing::check_eq(0o755, 493, "0o755 == 493")
        let _ = testing::check_eq(0o644, 420, "0o644 == 420")
    }

    #[test]
    fn underscore_separators() {
        let _ = testing::check_eq(1_000_000, 1000000, "1_000_000 == 1000000")
        let _ = testing::check_eq(65_536, 65536, "65_536 == 65536")
    }

    #[test]
    fn raw_string() {
        let s = r"C:\Users\jane"
        let _ = testing::check_eq(s.len(), 13, "raw string len == 13")
        let _ = testing::check(s.contains("\\"), "raw string contains backslash")
    }
}
