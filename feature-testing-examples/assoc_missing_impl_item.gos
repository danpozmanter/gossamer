// An impl that leaves out an associated type the trait requires is
// rejected at check time with GT0059, not accepted silently.
// `assoc_missing_impl_item_is_rejected` in
// `crates/gossamer-cli/tests/bug_regressions` asserts the diagnostic.

trait Holder {
    type Item
    fn get(&self) -> Self::Item
}

struct Label {
    text: String
}

impl Holder for Label {
    fn get(&self) -> Self::Item {
        self.text
    }
}

fn main() {
    println("{}", Label { text: "x" }.get())
}
