// Cross-tier sweep of the data-last std combinator surface: the
// `result::*` / `option::*` / `iter::*` free functions that thread
// through `|>`. Every name with a checker signature row appears at
// least once, grouped one print line per family cluster, so a
// regression in any single row's closure typing, payload packing,
// or dispatch turns exactly one line red. Closure params are typed
// explicitly — the unannotated-inference shapes live in
// closure_payload_typing.gos.

use std::{errors, iter, option, result}

fn result_family() {
    let ok: Result<i64, errors::Error> = Ok(2)
    let bad: Result<i64, errors::Error> = Err(errors::new("boom"))
    let mapped = ok |> result::map(|x: i64| x * 3) |> result::default(0)
    let remapped = bad
        |> result::map_err(|e: errors::Error| errors::wrap(e, "outer"))
        |> result::default_with(|e: errors::Error| {
            println!("result map_err+default_with {e}")
        })
    let _ = remapped
    let chained = ok |> result::and_then(|x: i64| Ok(x + 10)) |> result::default(0)
    let recovered = bad |> result::or_else(|_e: errors::Error| Ok(7)) |> result::default(0)
    println!("result map {mapped} and_then {chained} or_else {recovered}")
    let some_ok = ok |> result::ok
    let some_err = bad |> result::err
    println!(
        "result ok_some {} err_some {} is_ok {} is_err {}",
        some_ok |> option::is_some,
        some_err |> option::is_some,
        ok |> result::is_ok,
        bad |> result::is_err
    )
}

fn option_family() {
    let a: Option<i64> = Some(3)
    let none: Option<i64> = None
    let mapped = a |> option::map(|x: i64| x + 1) |> option::default(0)
    let chained = a |> option::and_then(|x: i64| if x > 1 { Some(x * 10) } else { None })
        |> option::default(0)
    let kept = a |> option::filter(|x: i64| x % 2 == 1) |> option::default(0)
    let ored = none |> option::or(Some(5)) |> option::default(0)
    let lazy = none |> option::or_else(|| Some(6)) |> option::default(0)
    let fallback = none |> option::default_with(|| 9)
    println!("option map {mapped} and_then {chained} filter {kept} or {ored} or_else {lazy} default_with {fallback}")
    let pair = a |> option::zip(Some(4))
    let nested: Option<Option<i64>> = Some(Some(8))
    let flat = nested |> option::flatten |> option::default(0)
    let mut zip_sum = 0
    if let Some((x, y)) = pair {
        zip_sum = x + y
    }
    let mut iter_count = 0
    for _v in a |> option::iter {
        iter_count += 1
    }
    println!(
        "option zip {zip_sum} flatten {flat} iter {iter_count} is_some {} is_none {}",
        a |> option::is_some,
        none |> option::is_none
    )
}

fn iter_transforms() {
    let xs = [1, 2, 3, 4]
    let mapped = xs |> iter::map(|x: i64| x * 2)
    let mut map_sum = 0
    for x in mapped { map_sum += x }
    let kept = xs |> iter::filter(|x: i64| x % 2 == 0)
    let mut filter_sum = 0
    for x in kept { filter_sum += x }
    let fm = xs |> iter::filter_map(|x: i64| if x > 2 { Some(x * 10) } else { None })
    let mut fm_sum = 0
    for x in fm { fm_sum += x }
    let flat = [1, 2] |> iter::flat_map(|x: i64| [x, x * 10])
    let mut flat_sum = 0
    for x in flat { flat_sum += x }
    let scanned = [1, 2, 3] |> iter::scan(0, |acc: i64, x: i64| acc + x)
    let mut scan_last = 0
    for x in scanned { scan_last = x }
    println!("iter map {map_sum} filter {filter_sum} filter_map {fm_sum} flat_map {flat_sum} scan {scan_last}")
}

fn iter_reductions() {
    let xs = [1, 2, 3, 4]
    let folded = xs |> iter::fold(100, |acc: i64, x: i64| acc + x)
    let reduced = xs |> iter::reduce(|a: i64, b: i64| a * b) |> option::default(0)
    let sq = xs |> iter::sum_by(|x: i64| x * x)
    let prod = [2, 3] |> iter::product_by(|x: i64| x + 1)
    let parity_counts = xs |> iter::count_by(|x: i64| x % 2)
    println!(
        "iter fold {folded} reduce {reduced} sum_by {sq} product_by {prod} count_by {}/{}",
        parity_counts.get_or(0, 0),
        parity_counts.get_or(1, 0)
    )
    [10, 20] |> iter::for_each(|x: i64| println!("iter for_each {x}"))
    println!(
        "iter any {} all {}",
        xs |> iter::any(|x: i64| x > 3),
        xs |> iter::all(|x: i64| x > 0)
    )
}

fn iter_searches() {
    let xs = [3, 1, 4, 1, 5]
    let found = xs |> iter::find(|x: i64| x > 3) |> option::default(0)
    let pos = xs |> iter::position(|x: i64| x == 4) |> option::default(0 - 1)
    let fmapped = xs |> iter::find_map(|x: i64| if x > 3 { Some(x * 100) } else { None })
        |> option::default(0)
    println!("iter find {found} position {pos} find_map {fmapped}")
    let prefix = xs |> iter::take_while(|x: i64| x >= 1)
    let mut take_sum = 0
    for x in prefix { take_sum += x }
    let suffix = xs |> iter::skip_while(|x: i64| x >= 3)
    let mut skip_sum = 0
    for x in suffix { skip_sum += x }
    println!("iter take_while {take_sum} skip_while {skip_sum}")
}

fn iter_orderings() {
    let xs = [3, 1, 2]
    let asc = xs |> iter::sort_by(|a: i64, b: i64| a - b)
    let by_key = xs |> iter::sort_by_key(|x: i64| 0 - x)
    println!(
        "iter sort_by {} {} {} sort_by_key {} {} {}",
        asc[0], asc[1], asc[2], by_key[0], by_key[1], by_key[2]
    )
    let lo = xs |> iter::min_by(|a: i64, b: i64| a - b) |> option::default(0)
    let hi = xs |> iter::max_by(|a: i64, b: i64| a - b) |> option::default(0)
    let lo_key = xs |> iter::min_by_key(|x: i64| 0 - x) |> option::default(0)
    let hi_key = xs |> iter::max_by_key(|x: i64| 0 - x) |> option::default(0)
    println!("iter min_by {lo} max_by {hi} min_by_key {lo_key} max_by_key {hi_key}")
}

fn iter_groupings() {
    let (evens, odds) = [1, 2, 3, 4] |> iter::partition(|x: i64| x % 2 == 0)
    let mut even_sum = 0
    for x in evens { even_sum += x }
    let mut odd_sum = 0
    for x in odds { odd_sum += x }
    let groups = [1, 2, 3, 4] |> iter::group_by(|x: i64| x % 2)
    let zero_bucket = groups.get_or(0, [])
    let mut bucket_sum = 0
    for x in zero_bucket { bucket_sum += x }
    println!("iter partition {even_sum}/{odd_sum} group_by {bucket_sum} groups {}", groups.len())
}

fn main() {
    result_family()
    option_family()
    iter_transforms()
    iter_reductions()
    iter_searches()
    iter_orderings()
    iter_groupings()
}
