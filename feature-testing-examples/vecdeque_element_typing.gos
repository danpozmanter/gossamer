// A `VecDeque<T>` recovers its element type `T` for `pop_front()` across all
// tiers, whether `T` is annotated or inferred from the first `push_back`.
// Without element tracking the compiled tiers rendered a `VecDeque<String>`
// payload as the i64 pointer bits.

use std::collections::VecDeque

fn main() {
    // Annotated String element.
    let mut q: VecDeque<String> = VecDeque::new()
    q.push_back("alpha")
    q.push_back("beta")
    while let Some(s) = q.pop_front() {
        println!("drain {}", s)
    }

    // Inferred String element (from the first push_back).
    let mut inferred = VecDeque::new()
    inferred.push_back("gamma")
    match inferred.pop_front() {
        Some(s) => println!("inferred {}", s),
        None => println!("inferred none"),
    }

    // Numeric element is preserved.
    let mut nums: VecDeque<i64> = VecDeque::new()
    nums.push_back(10)
    nums.push_back(20)
    println!("len {}", nums.len())
    println!("front {}", nums.pop_front().unwrap_or(-1))
}
