// std::trace across all tiers: the explicit Tracer / Span / EndedSpan
// handle surface plus OTLP JSON export. Trace / span identifiers are
// unguessable per run and span timestamps are zeroed, so the asserted
// output is substring-shaped (span name, attribute value, status code)
// - bit-identical across the VM, Cranelift JIT, and LLVM AOT tiers.
use std::trace
use std::strings

fn main() {
    let tracer = trace::Tracer::new()
    let span = tracer.start_span("checkout")
    span.set_attribute("user", "alice")
    let ended = span.end()
    let json = ended.to_otlp_json()
    println!("has_name={}", strings::contains(&json, "\"name\":\"checkout\""))
    println!("has_attr_val={}", strings::contains(&json, "alice"))
    println!("has_status_ok={}", strings::contains(&json, "\"code\":1"))
}
