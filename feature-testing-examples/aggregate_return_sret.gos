// A JIT-promotable hot loop (`run` returns i64, takes i64) that repeatedly
// calls four functions returning by-value aggregates: a 3-element tuple, a
// two-field struct, a fixed `[i64; 4]` array, and a monomorphised generic
// method returning a struct. Each result is summed, so the output pins the
// exact values across the bytecode VM, the Cranelift JIT (`gos run`), and the
// LLVM AOT tier. Because the caller is JIT-promoted, its calls lower through
// the structural-return (sret) ABI: the caller allocates one correctly-sized
// stack slot per call site (reused across iterations) and the callee writes the
// aggregate through it, so the loop is RSS-flat with no per-iteration leak and
// the returned pointer never dangles.

struct Point {
    x: i64,
    y: i64,
}

struct Trip<T> {
    a: T,
    b: T,
    c: T,
}

impl<T> Trip<T> {
    // A monomorphised method returning its `T` (here `Point`) by value.
    fn head(&self) -> T {
        self.a
    }
}

fn triple(i: i64) -> (i64, i64, i64) {
    (i, i * 2, i * 3)
}

fn make_point(i: i64) -> Point {
    Point { x: i + 1, y: i - 1 }
}

fn quad(i: i64) -> [i64; 4] {
    [i, i + 1, i + 2, i + 3]
}

fn run(rounds: i64) -> i64 {
    let mut total = 0
    let mut i = 0
    while i < rounds {
        let (a, b, c) = triple(i)
        total += a + b + c

        let p = make_point(i)
        total += p.x + p.y

        let arr = quad(i)
        total += arr[0] + arr[1] + arr[2] + arr[3]

        let t = Trip { Point { x: i, y: i * 3 }, Point { x: 0, y: 0 }, Point { x: 0, y: 0 } }
        let h = t.head()
        total += h.x + h.y

        i += 1
    }
    total
}

fn main() {
    println!("{}", run(200000))
}
