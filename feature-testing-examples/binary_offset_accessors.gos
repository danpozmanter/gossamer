// Offset-taking integer accessors read and write through the caller's own
// buffer, the shape a pager needs: a u16 at offset 5 of a page, a u32 at
// offset 8. A window that runs past the end is an Err on every tier, not a
// zero-fill and not a panic.

use std::encoding::binary
use std::errors

fn main() -> Result<(), errors::Error> {
    let mut page: Vec<u8> = #[0; 16]
    binary::put_u16_be_at(&mut page, 0, 4096)?
    binary::put_u64_be_at(&mut page, 6, 18_446_744_073_709_551_615)?
    binary::put_u16_le_at(&mut page, 14, 258)?
    binary::put_u32_be_at(&mut page, 2, 3_735_928_559)?
    binary::put_u32_be_at(&mut page, 6, 3_735_928_558)?
    println!("{:?}", page)

    println!("u16 be {}", binary::get_u16_be_at(&page, 0)?)
    println!("u32 be at 2 {}", binary::get_u32_be_at(&page, 2)?)
    println!("u32 be at 6 {}", binary::get_u32_be_at(&page, 6)?)
    println!("u16 le {}", binary::get_u16_le_at(&page, 14)?)

    let mut little: Vec<u8> = #[0; 8]
    binary::put_u32_le_at(&mut little, 0, 66_051)?
    binary::put_u64_le_at(&mut little, 0, 1)?
    println!("{:?}", little)
    println!("u64 le {}", binary::get_u64_le_at(&little, 0)?)

    match binary::get_u32_be_at(&page, 14) {
        Ok(v) => println!("unexpected read {}", v)
        Err(e) => println!("read err: {}", e)
    }
    match binary::put_u32_be_at(&mut page, 14, 1) {
        Ok(_) => println!("unexpected write")
        Err(e) => println!("write err: {}", e)
    }
    match binary::get_u16_be_at(&page, -1) {
        Ok(v) => println!("unexpected negative {}", v)
        Err(e) => println!("negative err: {}", e)
    }
    Ok(())
}
