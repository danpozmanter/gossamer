// Block-local structs retain lexical type identity across every tier.
// Cover named and tuple forms, duplicate source names, field mutation,
// record update, destructuring, nesting, and local-function parameters.

fn main() {
    let first = {
        struct Pair { left: i64, right: i64 }
        struct Wrapper { pair: Pair, bias: i64 }

        fn sum(pair: Pair) -> i64 { pair.left + pair.right }

        let mut original = Pair { left: 10, right: 20 }
        original.left = 19
        let updated = Pair { right: 23, ..original }
        let Pair { left, right } = updated
        let wrapped = Wrapper { pair: updated, bias: 1 }

        println("{} {}", updated.left, updated.right)
        println("{} {} {}", wrapped.pair.left, wrapped.pair.right, wrapped.bias)
        println("{}", sum(wrapped.pair))
        println("{} {}", left, right)
        sum(wrapped.pair) + wrapped.bias + left + right
    }

    let second = {
        struct Pair { value: i64 }
        struct Cell(i64)

        let pair = Pair { value: 7 }
        let cell = Cell(8)
        pair.value + cell.0
    }

    println("{}", first)
    println("{}", second)
}
