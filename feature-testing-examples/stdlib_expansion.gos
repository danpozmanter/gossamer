// 0.7.0 Quality-of-Life surface - exercises every helper that
// 0.7.0 added across all three tiers (VM, cranelift, LLVM).
//
// Pair this with `tier_parity` so a regression in any one tier
// (MIR dispatch missing, runtime helper mis-routed, JIT thunk
// not registered, …) trips the bit-for-bit-stdout gate.

use std::collections::Map
use std::errors
use std::path
use std::strings

fn main() {
    // ---- String surface ----
    let url = "http://example.com/a/b/c.gos"
    match url.rsplit_once("/") {
        Some((head, tail)) => println("rsplit_once head={} tail={}", head, tail)
        None => println("no slash")
    }
    match "k=v".split_once("=") {
        Some((k, v)) => println("split_once k={} v={}", k, v)
        None => println("no eq")
    }
    println("count slashes = {}", url.count("/"))
    println("trim_matches |{}|", "  hello  ".trim_matches(" "))
    println("ltrim_matches |{}|", "##title".trim_start_matches("#"))
    println("rtrim_matches |{}|", "abc.gos".trim_end_matches(".gos"))
    println("pad_left 000042 = {}", "42".pad_left(6, '0'))
    println("center = {}", "title".center(20, '-'))
    match "hello".slice(1, 4) {
        Ok(s) => println("str.slice ok: {}", s)
        Err(e) => println("str.slice err: {}", e.message())
    }
    match "hello".slice(0, 99) {
        Ok(_) => println("str.slice wide ok??")
        Err(e) => println("str.slice wide: {}", e.message())
    }

    // ---- strings::* free fns ----
    let parts: Vec<String> = Vec::from(["a", "b", "c"])
    println("join = {}", strings::join(parts, "-"))
    match strings::rfind("foo/bar/baz", "/") {
        Some(i) => println("rfind = {}", i)
        None => println("rfind = none")
    }

    // ---- path::* free fns ----
    println("path::file_name = {}", path::file_name("a/b/c.gos").unwrap_or(""))
    println("path::parent = {}", path::parent("a/b/c.gos").unwrap_or(""))
    match path::extension("a/b/c.gos") {
        Some(e) => println("path::extension = {}", e)
        None => println("path::extension = none")
    }

    // ---- Vec method surface ----
    let mut nums: Vec<i64> = Vec::from([10, 20, 30, 20])
    match nums.first() {
        Some(v) => println("first = {}", v)
        None => println("first = none")
    }
    match nums.last() {
        Some(v) => println("last = {}", v)
        None => println("last = none")
    }
    let rev = nums.iter().rev().collect()
    println("rev[0] = {}", rev[0])
    println("contains 30 = {}", nums.contains(30))
    println("contains 99 = {}", nums.contains(99))
    match nums.index_of(20) {
        Some(i) => println("index_of 20 = {}", i)
        None => println("index_of 20 = none")
    }
    println("count_of 20 = {}", nums.count_of(20))
    match nums.slice(1, 3) {
        Ok(s) => println("vec.slice len = {}", s.len())
        Err(e) => println("vec.slice err: {}", e.message())
    }
    match nums.slice(0, 999) {
        Ok(_) => println("vec.slice wide ok??")
        Err(e) => println("vec.slice wide: {}", e.message())
    }

    // ---- Qualified in-place Vec::insert / Vec::remove forms ----
    let _ = Vec::insert(&mut nums, 1, 99)
    println("after insert: len={} [0]={} [1]={}", nums.len(), nums[0], nums[1])
    match Vec::remove(&mut nums, 0) {
        Ok(removed) => println("removed = {}", removed)
        Err(e) => println("remove err: {}", e.message())
    }

    // ---- Vec<String>.contains ----
    let langs: Vec<String> = Vec::from(["text", "json"])
    if langs.contains("json") {
        println("langs has json")
    }
    if !langs.contains("yaml") {
        println("langs no yaml")
    }

    // ---- Map surface ----
    let mut m: Map<String, i64> = Map::new()
    m.insert("apple", 1)
    m.insert("banana", 2)
    m.insert("cherry", 3)
    println("map keys len = {}", m.keys().len())
    println("map vals len = {}", m.values().len())
    match Map::pop(m, "banana") {
        Some(v) => println("popped banana = {}", v)
        None => println("no banana")
    }
    match Map::pop(m, "durian") {
        Some(_) => println("durian ??")
        None => println("no durian")
    }

    // ---- Scalar min / max / clamp prelude ----
    println("min = {}", min(3, 7))
    println("max = {}", max(3, 7))
    println("clamp = {}", clamp(15, 0, 10))
    println("clamp neg = {}", clamp(-5, 0, 10))

    // ---- errors::newf format-shaped constructor ----
    let e = errors::newf("status {} from {}", 503, "example.com")
    println("err msg = {}", e.message())
}
