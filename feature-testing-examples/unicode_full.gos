// Full Unicode surface - exercises every helper added in the
// std::unicode + std::utf8 rewrite across all three tiers
// (VM, cranelift, LLVM). Pair this with `tier_parity` so a
// regression in any one tier (MIR dispatch missing, runtime
// helper mis-routed, JIT thunk not registered, …) trips the
// bit-for-bit-stdout gate.

use std::unicode
use std::utf8

fn main() {
    // ---- General-category predicates ----
    // Real category tests (not ASCII-only shortcuts).
    println!("is_letter(é) = {}", unicode::is_letter('é'))
    println!("is_letter(名) = {}", unicode::is_letter('名'))
    println!("is_letter(1) = {}", unicode::is_letter('1'))
    println!("is_digit(5) = {}", unicode::is_digit('5'))
    println!("is_digit(arabic-7) = {}", unicode::is_digit('\u{0667}'))
    println!("is_digit(devanagari-0) = {}", unicode::is_digit('\u{0966}'))
    println!("is_number(roman-V) = {}", unicode::is_number('\u{2164}'))
    println!("is_number(half) = {}", unicode::is_number('\u{00BD}'))
    println!("is_punct(em-dash) = {}", unicode::is_punct('\u{2014}'))
    println!("is_punct(fullwidth-comma) = {}", unicode::is_punct('\u{FF0C}'))
    println!("is_symbol(yen) = {}", unicode::is_symbol('¥'))
    println!("is_symbol(for-all) = {}", unicode::is_symbol('\u{2200}'))
    println!("is_mark(combining-acute) = {}", unicode::is_mark('\u{0301}'))
    println!("is_upper(É) = {}", unicode::is_upper('É'))
    println!("is_lower(é) = {}", unicode::is_lower('é'))
    println!("is_title(Dz-digraph) = {}", unicode::is_title('\u{01C5}'))
    println!("is_space(NEL) = {}", unicode::is_space('\u{0085}'))
    println!("is_control(ESC) = {}", unicode::is_control('\u{001B}'))
    println!("is_print(é) = {}", unicode::is_print('é'))
    println!("is_print(NUL) = {}", unicode::is_print('\u{0000}'))
    println!("is_graphic(space) = {}", unicode::is_graphic(' '))
    println!("is_graphic(é) = {}", unicode::is_graphic('é'))
    println!("is_assigned(non-char) = {}", unicode::is_assigned('\u{FDD0}'))
    println!("combining_class(acute) = {}", unicode::combining_class('\u{0301}'))

    // ---- Casing (single rune + full string) ----
    println!("to_upper(é) = {}", unicode::to_upper('é'))
    println!("to_lower(É) = {}", unicode::to_lower('É'))
    println!("to_upper_str(ß) = {}", unicode::to_upper_str(&"ß"))
    println!("to_lower_str(CAFÉ) = {}", unicode::to_lower_str(&"CAFÉ"))
    println!("simple_fold(a) = {}", unicode::simple_fold('a'))
    println!("simple_fold(A) = {}", unicode::simple_fold('A'))

    // ---- Normalization ----
    let composed = "\u{00C1}"
    let decomposed = "A\u{0301}"
    println!("nfd(composed) == decomposed: {}", unicode::nfd(&composed) == decomposed)
    println!("nfc(decomposed) == composed: {}", unicode::nfc(&decomposed) == composed)
    println!("is_nfc(composed): {}", unicode::is_nfc(&composed))
    println!("is_nfc(decomposed): {}", unicode::is_nfc(&decomposed))
    println!("is_nfd(decomposed): {}", unicode::is_nfd(&decomposed))
    println!("nfkc(halfwidth-ka) = {}", unicode::nfkc(&"\u{FF76}"))
    println!("nfkd(roman-IV) = {}", unicode::nfkd(&"\u{2163}"))

    // ---- Segmentation ----
    let cafe_decomposed = "cafe\u{0301}"
    println!("grapheme_count(cafe + acute) = {}", unicode::grapheme_count(&cafe_decomposed))
    let family = "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}"
    println!("grapheme_count(family-zwj) = {}", unicode::grapheme_count(&family))
    println!("word_count(\"The quick brown fox.\") = {}", unicode::word_count(&"The quick brown fox."))
    println!("sentence_count = {}", unicode::sentence_count(&"Hello world. This is a test! And one more?"))
    let parts: Vec<String> = unicode::words(&"alpha beta gamma")
    println!("words[0..2] = {}, {}", parts[0], parts[1])
    let graph: Vec<String> = unicode::graphemes(&cafe_decomposed)
    println!("graphemes[3] (combined e+acute) = {}", graph[3])

    // ---- UTF-8 helpers ----
    println!("rune_count_in_string(héllo) = {}", utf8::rune_count_in_string(&"héllo"))
    println!("rune_len(BMP) = {}", utf8::rune_len('é'))
    println!("rune_len(supplementary) = {}", utf8::rune_len('𝄞'))
    println!("valid_rune(0x61) = {}", utf8::valid_rune(97))
    println!("valid_string(héllo) = {}", utf8::valid_string(&"héllo"))
    println!("rune_start(0x61) = {}", utf8::rune_start(97))
    println!("full_rune_in_string(hi) = {}", utf8::full_rune_in_string(&"hi"))

    // ---- Unicode identifiers (XID) ----
    let café = 7
    let π = 3
    let 名前 = "ada"
    println!("ident café = {}, π = {}, 名前 = {}", café, π, 名前)
}
