// Arithmetic operator overloading: `+ - * /` on a user struct dispatch to
// its `add`/`sub`/`mul`/`div` impl method on every tier. The result type is
// the method's return type, so a dot product (`Mul -> f64`) types correctly.
struct V2 { x: f64, y: f64 }
impl Add for V2 { fn add(self, o: V2) -> V2 { V2(self.x + o.x, self.y + o.y) } }
impl Sub for V2 { fn sub(self, o: V2) -> V2 { V2(self.x - o.x, self.y - o.y) } }
impl Mul for V2 { fn mul(self, o: V2) -> f64 { self.x * o.x + self.y * o.y } }

struct Money { cents: i64 }
impl Add for Money { fn add(self, o: Money) -> Money { Money(self.cents + o.cents) } }
impl Div for Money { fn div(self, o: Money) -> Money { Money(self.cents / o.cents) } }

fn main() {
    let a = V2(1.0, 2.0)
    let b = V2(3.0, 4.0)
    let s = a + b
    let d = b - a
    let dot = a * b
    println!("{} {} {} {} {}", s.x, s.y, d.x, d.y, dot)
    let m = Money(150) + Money(75)
    let q = Money(200) / Money(4)
    println!("{} {}", m.cents, q.cents)
}
