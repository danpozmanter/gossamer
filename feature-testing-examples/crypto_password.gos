// Cross-tier regression for crypto::password (previously a phantom
// module - manifest-advertised, unbound on every tier). Argon2id
// hash / verify / needs_rehash must behave identically on `gos`
// and `gos build`. The PHC string carries a random salt so the hash
// bytes differ per call and per tier; the fixture asserts the
// deterministic outcomes (verify true/false, rehash false on a fresh
// default-params hash) rather than the raw hash, which is the correct
// way to test a salted password hash across tiers.

use std::crypto

fn main() {
    match crypto::password::hash("hunter2") {
        Ok(phc) => {
            let starts = phc.starts_with("$argon2id$")
            let v = match crypto::password::verify("hunter2", phc) {
                Ok(b) => b,
                Err(_) => false,
            }
            let w = match crypto::password::verify("wrong", phc) {
                Ok(b) => b,
                Err(_) => false,
            }
            let rh = crypto::password::needs_rehash(phc)
            println!("phc_ok={} verify={} wrong={} rehash={}", starts, v, w, rh)
        }
        Err(e) => println!("hash err {}", e),
    }
}
