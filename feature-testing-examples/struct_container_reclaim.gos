use std::collections::HashMap

struct Node { val: i64, next: Option<Box<Node>> }

fn vec_case() -> i64 {
    let mut total = 0
    let mut i = 0
    while i < 500 {
        let mut xs: Vec<Node> = Vec::from([])
        let inner = Node { val: i + 5, next: None }
        xs.push(Node { val: i, next: Some(inner) })
        xs.push(Node { val: i + 1, next: None })
        let first = xs[0]
        if let Some(n) = &first.next {
            total += n.val
        }
        i += 1
    }
    total
}

fn map_case() -> i64 {
    let mut total = 0
    let mut i = 0
    while i < 500 {
        let mut m: HashMap<i64, Node> = HashMap::new()
        let inner = Node { val: i + 5, next: None }
        m.insert(1, Node { val: i, next: Some(inner) })
        m.insert(1, Node { val: i, next: None })
        if let Some(n) = m.get(&1) {
            total += n.val
        }
        i += 1
    }
    total
}

fn main() {
    println!("{} {}", vec_case(), map_case())
}
