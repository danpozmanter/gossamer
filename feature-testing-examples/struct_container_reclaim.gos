use std::collections::HashMap

struct Node { val: i64, next: Option<Box<Node>> }

fn vec_case() -> i64 {
    let mut total = 0
    let mut i = 0
    while i < 500 {
        let mut xs: Vec<Node> = []
        let inner = Node(i + 5, None)
        xs.push(Node(i, Some(inner)))
        xs.push(Node(i + 1, None))
        let first = xs[0]
        if let Some(n) = &first.next {
            total += n.val
        }
        i += 1
    }
    total
}

fn map_case() -> i64 {
    let mut total = 0
    let mut i = 0
    while i < 500 {
        let mut m: HashMap<i64, Node> = HashMap::new()
        let inner = Node(i + 5, None)
        m.insert(1, Node(i, Some(inner)))
        m.insert(1, Node(i, None))
        if let Some(n) = m.get(&1) {
            total += n.val
        }
        i += 1
    }
    total
}

fn main() {
    println!("{} {}", vec_case(), map_case())
}
