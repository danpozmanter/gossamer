// Vec insert is checked in method and qualified form. Invalid indices return
// Err without mutating the receiver on every tier. `swap` is an indexed
// write rather than a resize, so an in-range pair mutates and yields unit;
// an out-of-range index panics, which `oob_index_scalar_panic` covers.

fn main() {
    let mut xs = Vec::from([1, 2, 3])
    let _ = xs.insert(3, 4)
    println!("before {}", xs.len())
    match xs.insert(5, 99) {
        Ok(_) => println!("unexpected ok")
        Err(_) => println!("insert oob err len={}", xs.len())
    }
    xs.swap(0, 3)
    println!("swapped {:?}", xs)
}
