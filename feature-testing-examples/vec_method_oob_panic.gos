// Vec insert is checked in method and qualified form. Invalid indices return
// Err without mutating the receiver on every tier.

fn main() {
    let mut xs = Vec::from([1, 2, 3])
    let _ = xs.insert(3, 4)
    println!("before {}", xs.len())
    match xs.insert(5, 99) {
        Ok(_) => println!("unexpected ok")
        Err(_) => println!("insert oob err len={}", xs.len())
    }
}
