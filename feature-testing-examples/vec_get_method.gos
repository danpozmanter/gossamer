fn show_i64(label: String, value: Option<i64>) {
    match value {
        Some(v) => println!("{}={}", label, v),
        None => println!("{}=none", label),
    }
}

fn show_string(label: String, value: Option<String>) {
    match value {
        Some(v) => println!("{}={}", label, v),
        None => println!("{}=none", label),
    }
}

fn main() {
    let xs = Vec::from([10, 20, 30])
    show_i64("vec0", xs.get(0))
    show_i64("vec2", xs.get(2))
    show_i64("vec3", xs.get(3))
    show_i64("vecneg", xs.get(-1))

    let arr = #[4, 5, 6]
    show_i64("arr1", arr.get(1))

    let words = Vec::from(["red", "blue"])
    show_string("word1", words.get(1))
    show_string("word2", words.get(2))
}
