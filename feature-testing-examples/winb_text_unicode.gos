use std::unicode

fn pred(label: String, b: bool) {
    println("{} = {}", label, b)
}

fn main() {
    // category predicates across scripts
    pred("is_letter-a", unicode::is_letter('a'))
    pred("is_letter-cjk", unicode::is_letter('你'))
    pred("is_letter-digit", unicode::is_letter('7'))
    pred("is_digit-ascii", unicode::is_digit('7'))
    pred("is_digit-arabic", unicode::is_digit('٧'))
    pred("is_digit-roman", unicode::is_digit('Ⅷ'))
    pred("is_number-roman", unicode::is_number('Ⅷ'))
    pred("is_space-tab", unicode::is_space('\t'))
    pred("is_space-nbsp", unicode::is_space('\u{00A0}'))
    pred("is_space-a", unicode::is_space('a'))
    pred("is_upper-A", unicode::is_upper('A'))
    pred("is_lower-a", unicode::is_lower('a'))
    pred("is_title-dz", unicode::is_title('ǅ'))
    pred("is_punct-dash", unicode::is_punct('—'))
    pred("is_punct-comma", unicode::is_punct(','))
    pred("is_symbol-plus", unicode::is_symbol('+'))
    pred("is_symbol-dollar", unicode::is_symbol('$'))
    pred("is_mark-combining", unicode::is_mark('\u{0301}'))
    pred("is_print-a", unicode::is_print('a'))
    pred("is_print-nul", unicode::is_print('\u{0000}'))
    pred("is_graphic-a", unicode::is_graphic('a'))
    pred("is_graphic-space", unicode::is_graphic(' '))
    pred("is_control-nul", unicode::is_control('\u{0000}'))
    pred("is_control-a", unicode::is_control('a'))
    pred("is_assigned-a", unicode::is_assigned('a'))

    println("combining_class-acute = {}", unicode::combining_class('\u{0301}'))
    println("combining_class-a = {}", unicode::combining_class('a'))

    // single-rune casing (printed as codepoint)
    println("to_upper-a = U+{:04X}", unicode::to_upper('a') as i64)
    println("to_lower-A = U+{:04X}", unicode::to_lower('A') as i64)
    println("to_title-a = U+{:04X}", unicode::to_title('a') as i64)
    println("simple_fold-a = U+{:04X}", unicode::simple_fold('a') as i64)
    println("simple_fold-A = U+{:04X}", unicode::simple_fold('A') as i64)
    println("to_upper-eszett = U+{:04X}", unicode::to_upper('ß') as i64)

    // whole-string casing (full mappings)
    println("to_upper_str = {:?}", unicode::to_upper_str("straße"))
    println("to_lower_str = {:?}", unicode::to_lower_str("HÉLLO"))
    println("fold_case = {:?}", unicode::fold_case("GROSSE"))

    // normalization
    let composed = "é"
    let decomposed = "e\u{0301}"
    println("nfc-decomposed = {:?}", unicode::nfc(decomposed))
    println("nfd-composed = {:?}", unicode::nfd(composed))
    println("nfkc-fi = {:?}", unicode::nfkc("ﬁ"))
    println("nfkd-fi = {:?}", unicode::nfkd("ﬁ"))
    pred("is_nfc-composed", unicode::is_nfc(composed))
    pred("is_nfc-decomposed", unicode::is_nfc(decomposed))
    pred("is_nfd-decomposed", unicode::is_nfd(decomposed))

    // segmentation
    let para = "The quick, brown fox. It runs!"
    println("graphemes = {:?}", unicode::graphemes("a\u{0301}b"))
    println("grapheme_count = {}", unicode::grapheme_count("a\u{0301}b"))
    println("words = {:?}", unicode::words(para))
    println("word_count = {}", unicode::word_count(para))
    println("word_bounds = {:?}", unicode::word_bounds("a b"))
    println("sentences = {:?}", unicode::sentences(para))
    println("sentence_count = {}", unicode::sentence_count(para))
}
