use crate::model

// Aggregates declared in a module, and the three places their slots are
// handled by address rather than by value: a derived `fmt` reached across
// the module boundary, an `Option<Struct>` field beside other fields, and
// `Vec::insert` of a slot-block element.

mod model {
    pub struct Part {
        pub name: String
        pub size: i64
    }

    pub struct One {
        pub a: i64
    }

    pub struct Inner {
        pub items: Vec<String>
    }

    // The option field sits between two others, so its two words start at a
    // non-zero slot offset.
    pub struct Outer {
        pub rows: Vec<String>
        pub source: Option<Inner>
        pub tag: String
    }

    pub enum Shape {
        Dot
        Line(i64)
        Box { w: i64, h: i64 }
    }

    pub struct Holder {
        pub shapes: Vec<Shape>
        pub parts: Vec<Part>
    }

    pub fn build(with_source: bool) -> Outer {
        let mut rows: Vec<String> = #[]
        let mut source: Option<Inner> = None
        if with_source {
            source = Some(Inner { items: #["a", "b"] })
        } else {
            rows.push("x")
        }
        Outer { rows: rows, source: source, tag: "t" }
    }
}

fn main() {
    // A `Vec` of a module's struct renders through that struct's derived
    // `fmt`, which is registered under the module's own path.
    let holder = model::Holder {
        shapes: #[model::Shape::Dot, model::Shape::Line(3), model::Shape::Box { w: 1, h: 2 }]
        parts: #[model::Part { name: "a", size: 1 }, model::Part { name: "b", size: 2 }]
    }
    println("{:?}", holder)
    println("{:?}", holder.parts)

    // An option field whose payload is a one-slot struct is a heap copy the
    // owner keeps a share of, so the value survives its builder's return.
    let mut i: i64 = 0
    while i < 50 {
        let with = model::build(true)
        let without = model::build(i % 2 == 0)
        if with.tag != "t" || without.tag != "t" {
            println("tag lost")
        }
        i += 1
    }
    println("{:?}", model::build(true))
    println("{:?}", model::build(false))

    // `insert` places a slot-block element the caller addresses in place.
    let mut parts: Vec<model::Part> = #[]
    parts.push(model::Part { name: "one", size: 1 })
    parts.push(model::Part { name: "two", size: 2 })
    let _ = parts.insert(0, model::Part { name: "zero", size: 0 })
    let _ = parts.insert(2, model::Part { name: "mid", size: 9 })
    println("{:?}", parts)

    let mut ones: Vec<model::One> = #[]
    ones.push(model::One { a: 1 })
    let _ = ones.insert(0, model::One { a: 7 })
    println("{:?}", ones)

    let mut pairs: Vec<(i64, model::One)> = #[]
    pairs.push((1, model::One { a: 1 }))
    let _ = pairs.insert(0, (2, model::One { a: 2 }))
    println("{:?}", pairs)

    let mut words: Vec<String> = #["a", "c"]
    let _ = words.insert(1, "b")
    println("{:?}", words)

    let mut nums: Vec<i64> = #[1, 3]
    let _ = nums.insert(1, 2)
    println("{:?}", nums)
}
