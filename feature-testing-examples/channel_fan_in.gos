// Channel Fan-In
// Spawn several goroutines sending values into one channel and drain
// with while let Some to expose scheduler and recv differences.

use std::sync::channel
use std::time

fn worker(id: i64, tx: channel::Sender<i64>, val: i64) {
    tx.send(val)
}

fn main() {
    let (tx, rx) = channel::unbounded()

    go worker(1, tx, 10)
    go worker(2, tx, 20)
    go worker(3, tx, 30)
    go worker(4, tx, 40)
    go worker(5, tx, 50)

    // Give the scheduler a beat. Multiple senders share the
    // channel so drain via `try_recv` rather than `recv` -
    // close+drain requires a single owner of the close step.
    time::sleep(50)

    let mut received: [i64] = []
    while let Some(v) = rx.try_recv() {
        received.push(v)
    }

    received.sort()
    for v in received {
        println!("received {}", v)
    }

    let mut total = 0
    for v in [10, 20, 30, 40, 50] {
        total += v
    }
    println!("fan-in total = {}", total)
}

#[cfg(test)]
mod tests {
    use std::sync::channel
    use std::time
    use std::testing

    #[test]
    fn fan_in_total() {
        let (tx, rx) = channel::unbounded()
        go super::worker(1, tx, 10)
        go super::worker(2, tx, 20)
        go super::worker(3, tx, 30)
        time::sleep(50)
        let mut total = 0
        while let Some(v) = rx.try_recv() {
            total += v
        }
        let _ = testing::check_eq(&total, &60, "10+20+30=60")
    }
}
