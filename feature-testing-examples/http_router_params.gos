// Cross-tier regression for router path-parameter read-back.
// `router::Router` matches `{id}` and `{rest...}` patterns Rust-side
// on every tier, but the captured values only reach a Gossamer
// handler through `r.path_value(name)`. Before this was wired the
// VM returned the capture while the compiled tiers had no accessor
// at all. This fixture asserts a single-segment capture and a
// trailing rest-capture round-trip identically under `gos run`
// (bytecode VM) and `gos build` (LLVM AOT).
//
// Self-terminating: the client runs in main and exits explicitly, so
// the run is a plain stdout-parity comparison. Binds a fixed loopback
// port, serialized under SERVER_PORT_LOCK by
// `http_router_params_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::http::router
use std::process
use std::time

fn show_user(r: http::Request) -> http::Response {
    http::Response::text(200, "user=" + &r.path_value("id"))
}

fn show_file(r: http::Request) -> http::Response {
    http::Response::text(200, "file=" + &r.path_value("path"))
}

fn missing(r: http::Request) -> http::Response {
    // A capture name that the matched pattern does not declare yields
    // the empty string on every tier.
    http::Response::text(200, "missing=[" + &r.path_value("nope") + "]")
}

fn serve_router() {
    let rt = router::Router::new()
    rt.get("/users/{id}", show_user)
    rt.get("/files/{path...}", show_file)
    rt.get("/plain", missing)
    if let Err(e) = http::serve("127.0.0.1:23881", rt) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, []) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go serve_router()
    await_ready(&"http://127.0.0.1:23881/plain")
    match http::get("http://127.0.0.1:23881/users/42", []) {
        Ok(r) => println!("A status={} body={}", r.status, r.body),
        Err(e) => println!("A error: {}", e),
    }
    match http::get("http://127.0.0.1:23881/files/docs/readme.md", []) {
        Ok(r) => println!("B status={} body={}", r.status, r.body),
        Err(e) => println!("B error: {}", e),
    }
    match http::get("http://127.0.0.1:23881/plain", []) {
        Ok(r) => println!("C status={} body={}", r.status, r.body),
        Err(e) => println!("C error: {}", e),
    }
    process::exit(0)
}
