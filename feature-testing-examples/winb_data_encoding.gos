// Win B DATA: cross-tier parity for encoding (base64, hex, binary,
// json, yaml, toml). Round-trips, empty inputs, padding boundaries,
// number precision and special characters must be bit-identical on
// the VM and the LLVM AOT tier.

use std::encoding
use std::encoding::json
use std::encoding::yaml
use std::encoding::toml

fn show_b64(label: String, bytes: Vec<u8>) {
    let enc = encoding::base64::encode(bytes)
    let n = match encoding::base64::decode(&enc) {
        Ok(b) => b.len(),
        Err(_) => -1,
    }
    println!("b64 {} = {} (rt len {})", label, enc, n)
}

fn show_hex(label: String, bytes: Vec<u8>) {
    let enc = encoding::hex::encode(bytes)
    let n = match encoding::hex::decode(&enc) {
        Ok(b) => b.len(),
        Err(_) => -1,
    }
    println!("hex {} = {} (rt len {})", label, enc, n)
}

fn main() {
    let empty: Vec<u8> = Vec::from([])

    // --- base64 padding boundaries (0,1,2,3,4 bytes) ---
    show_b64("empty", empty)
    show_b64("1", Vec::from([102]))
    show_b64("2", Vec::from([102, 111]))
    show_b64("3", Vec::from([102, 111, 111]))
    show_b64("4", Vec::from([102, 111, 111, 98]))
    show_b64("hi255", Vec::from([0, 1, 127, 128, 200, 255]))
    // String input also routes through the byte-coercion path.
    println!("b64 str = {}", encoding::base64::encode("Hello, Gossamer!".to_string().as_bytes()))

    // --- hex round-trips incl high bytes ---
    show_hex("empty", empty)
    show_hex("bytes", Vec::from([0, 15, 16, 127, 128, 255]))
    // decode error path
    match encoding::hex::decode("zz") {
        Ok(_) => println!("hex bad: ok?!"),
        Err(_) => println!("hex bad: err"),
    }
    match encoding::base64::decode("!!!!") {
        Ok(_) => println!("b64 bad: ok?!"),
        Err(_) => println!("b64 bad: err"),
    }

    // --- encoding::binary fixed-width + varint ---
    let u16b = encoding::binary::put_u16_be(empty, 4660)
    let u16l = encoding::binary::put_u16_le(empty, 4660)
    println!("u16be = {}", encoding::hex::encode(u16b))
    println!("u16le = {}", encoding::hex::encode(u16l))
    match encoding::binary::get_u16_be(u16b) {
        Ok(v) => println!("get u16be = {}", v),
        Err(e) => println!("get u16be err {}", e),
    }
    let u32b = encoding::binary::put_u32_be(empty, 305419896)
    println!("u32be = {}", encoding::hex::encode(u32b))
    match encoding::binary::get_u32_le(encoding::binary::put_u32_le(empty, 305419896)) {
        Ok(v) => println!("get u32le = {}", v),
        Err(e) => println!("get u32le err {}", e),
    }
    let u64b = encoding::binary::put_u64_be(empty, 72623859790382856)
    println!("u64be = {}", encoding::hex::encode(u64b))
    match encoding::binary::get_u64_be(u64b) {
        Ok(v) => println!("get u64be = {}", v),
        Err(e) => println!("get u64be err {}", e),
    }
    // varint decode (150 -> 0x96 0x01) and short-buffer error.
    match encoding::binary::uvarint(Vec::from([150, 1])) {
        Ok((v, n)) => println!("uvarint = {} consumed {}", v, n),
        Err(e) => println!("uvarint err {}", e),
    }
    match encoding::binary::varint(Vec::from([1])) {
        Ok((v, n)) => println!("varint = {} consumed {}", v, n),
        Err(e) => println!("varint err {}", e),
    }
    match encoding::binary::uvarint(empty) {
        Ok((v, _)) => println!("uvarint empty = {}", v),
        Err(_) => println!("uvarint empty err"),
    }

    // --- JSON dynamic parse / render / precision / specials ---
    match json::parse(&"{\"a\":1,\"b\":[true,null,3.5],\"s\":\"x\\ty\"}") {
        Ok(v) => {
            println!("json render = {}", json::render(&v))
            println!("json len = {}", json::len(&v))
        }
        Err(e) => println!("json parse err {}", e),
    }
    println!("json encode int = {}", json::encode(42))
    println!("json encode arr = {}", json::encode([1, 2, 3]))
    println!("json encode neg = {}", json::encode(-12345))
    // number precision: large-but-exact int (2^53-1) + float.
    // Integers above 2^53 are a known VM/AOT divergence (see report).
    match json::parse(&"{\"big\":9007199254740991,\"f\":0.1}") {
        Ok(v) => println!("json big/f render = {}", json::render(&v)),
        Err(e) => println!("json err {}", e),
    }

    // --- YAML text converters (canonical short-path form) ---
    match yaml::to_json(&"a: 1\nb: two\nc: [1, 2, 3]\n") {
        Ok(j) => println!("yaml->json = {}", j),
        Err(e) => println!("yaml->json err {}", e),
    }
    println!("yaml valid = {}", yaml::is_valid(&"k: v\n"))
    println!("yaml invalid = {}", yaml::is_valid(&"a: b: c: ::"))
    // dynamic parse rendered via the documented renderer (json::encode).
    match encoding::yaml::parse(&"x: 7\n") {
        Ok(v) => println!("yaml parse->json = {}", json::encode(&v)),
        Err(e) => println!("yaml parse err {}", e),
    }

    // --- TOML text converters (canonical short-path form) ---
    let toml_src = "port = 8080\nhost = \"localhost\"\nflag = true\n"
    println!("toml valid = {}", toml::is_valid(&toml_src))
    println!("toml invalid = {}", toml::is_valid("x == 1"))
    match toml::to_json(&toml_src) {
        Ok(j) => {
            println!("toml->json has port = {}", j.contains("\"port\":8080"))
            match toml::from_json(&j) {
                Ok(t) => println!("json->toml has host = {}", t.contains("host")),
                Err(e) => println!("json->toml err {}", e),
            }
        }
        Err(e) => println!("toml->json err {}", e),
    }
}
