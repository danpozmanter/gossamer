// Cross-tier regression for handlers that declare a bare
// `http::Response` return instead of `Result<Response, Error>`.
// The compiled tiers invoke every registered handler through the
// packed-Result i128 C-ABI, so MIR synthesizes a `::__ok_wrap`
// thunk for bare-Response shapes; without it the native server
// misreads the returned Response pointer as a Result discriminant
// and answers 500. Covers both registration paths: an
// `impl http::Handler` serve method (env handler) and a free fn
// registered on a Router (bare handler).
//
// Self-terminating: the client runs in main and exits explicitly,
// so the fixture can be compared across tiers as a plain
// stdout-parity run. Binds fixed loopback ports - serialized under
// SERVER_PORT_LOCK by `http_bare_handler_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::http::router
use std::process
use std::time

struct App { }

impl http::Handler for App {
    fn serve(&self, _r: http::Request) -> http::Response {
        http::Response::text(200, "bare struct ok")
    }
}

fn bare_route(_r: http::Request) -> http::Response {
    http::Response::text(200, "bare route ok")
}

fn serve_struct() {
    if let Err(e) = http::serve("127.0.0.1:23872", App { }) {
        eprintln!("serve failed: {e}")
    }
}

fn serve_router() {
    let r = router::Router::new()
    r.get("/hello", bare_route)
    if let Err(e) = http::serve("127.0.0.1:23873", r) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, []) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go serve_struct()
    go serve_router()
    await_ready(&"http://127.0.0.1:23872/x")
    await_ready(&"http://127.0.0.1:23873/hello")
    match http::get("http://127.0.0.1:23872/x", []) {
        Ok(r) => println!("struct status={} body={}", r.status, r.body),
        Err(e) => println!("struct error: {}", e),
    }
    match http::get("http://127.0.0.1:23873/hello", []) {
        Ok(r) => println!("route status={} body={}", r.status, r.body),
        Err(e) => println!("route error: {}", e),
    }
    process::exit(0)
}
