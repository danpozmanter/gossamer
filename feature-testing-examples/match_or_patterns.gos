// Match Or-Patterns and Struct Rest
// Exercises `A | B` or-patterns on integers and enum variants,
// and `..` struct-rest patterns, so all three tiers agree.

enum Rank {
    Ace
    Number(i64)
    Jack
    Queen
    King
}

fn card_value(r: Rank) -> i64 {
    match r {
        Rank::Ace => 11
        Rank::Number(n) => *n
        Rank::Jack | Rank::Queen | Rank::King => 10
    }
}

fn classify_int(n: i64) -> String {
    match n {
        0 | 1 => "tiny"
        2 | 3 | 5 | 7 => "small-prime"
        _ if n < 0 => "negative"
        _ => "other"
    }
}

struct Point3 {
    x: i64
    y: i64
    z: i64
}

fn on_axis(p: Point3) -> String {
    match p {
        Point3 { x, y: 0, z: 0 } => format("x-axis at {}", x)
        Point3 { x: 0, y, z: 0 } => format("y-axis at {}", y)
        Point3 { x: 0, y: 0, z } => format("z-axis at {}", z)
        Point3 { x, .. } => format("off-axis x={}", x)
    }
}

enum Signal {
    Red(i64)
    Yellow(i64)
    Green(i64)
}

// Or-pattern alternatives binding the same name into one shared slot.
fn intensity(s: Signal) -> i64 {
    match s {
        Signal::Red(n) | Signal::Green(n) => *n
        Signal::Yellow(n) => *n + 1000
    }
}

// A binding or-pattern fronted by a guard that reads the shared binding.
fn describe(s: Signal) -> String {
    match s {
        Signal::Red(n) | Signal::Green(n) if *n > 0 => format("lit {}", n)
        Signal::Red(n) | Signal::Green(n) => format("dark {}", n)
        Signal::Yellow(n) => format("warn {}", n)
    }
}

enum Cell {
    Filled(Signal)
    Blank
}

// Binding or-pattern nested under an enclosing variant pattern.
fn cell_intensity(c: Cell) -> i64 {
    match c {
        Cell::Filled(Signal::Red(n)) | Cell::Filled(Signal::Green(n)) => *n
        Cell::Filled(Signal::Yellow(n)) => *n + 1000
        Cell::Blank => -1
    }
}

enum Wrap {
    A(i64)
    B(i64)
}

// Result-nested binding or-pattern: both wrappers bind the shared name.
fn collapse_result(r: Result<i64, i64>) -> i64 {
    match r {
        Ok(x) | Err(x) => x
    }
}

// Option-nested binding or-pattern over a user enum.
fn option_wrap(v: Option<Wrap>) -> i64 {
    match v {
        Some(Wrap::A(x)) | Some(Wrap::B(x)) => x
        None => -1
    }
}

// Option-of-Result binding or-pattern (the inner Ok/Err share the slot).
fn option_result(v: Option<Result<i64, i64>>) -> i64 {
    match v {
        Some(Ok(x)) | Some(Err(x)) => x
        None => -1
    }
}

fn main() {
    let ranks = #[Rank::Ace, Rank::Number(7), Rank::Jack, Rank::Queen, Rank::King]
    for r in ranks {
        println("value = {}", card_value(r))
    }

    let nums = #[0, 1, 2, 3, 5, 7, 4, -1]
    for n in nums {
        println("{} -> {}", n, classify_int(n))
    }

    let pts = #[
        Point3 { x: 3, y: 0, z: 0 }
        Point3 { x: 0, y: 5, z: 0 }
        Point3 { x: 0, y: 0, z: 7 }
        Point3 { x: 1, y: 2, z: 3 }
    ]
    for p in pts {
        println("{}", on_axis(p))
    }

    let sigs = #[Signal::Red(3), Signal::Yellow(4), Signal::Green(0), Signal::Red(-2)]
    for s in sigs {
        println("int={} {}", intensity(s), describe(s))
    }

    let cells = #[
        Cell::Filled(Signal::Red(7))
        Cell::Filled(Signal::Yellow(2))
        Cell::Filled(Signal::Green(9))
        Cell::Blank
    ]
    for c in cells {
        println("cell={}", cell_intensity(c))
    }

    println("collapse_ok={}", collapse_result(Ok(5)))
    println("collapse_err={}", collapse_result(Err(9)))
    println("option_wrap_a={}", option_wrap(Some(Wrap::A(11))))
    println("option_wrap_b={}", option_wrap(Some(Wrap::B(22))))
    println("option_wrap_none={}", option_wrap(None))
    println("option_result_ok={}", option_result(Some(Ok(33))))
    println("option_result_err={}", option_result(Some(Err(44))))
    println("option_result_none={}", option_result(None))
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn face_cards_worth_ten() {
        let _ = testing::check_eq(super::card_value(super::Rank::Jack), 10, "jack=10")
        let _ = testing::check_eq(super::card_value(super::Rank::Queen), 10, "queen=10")
        let _ = testing::check_eq(super::card_value(super::Rank::King), 10, "king=10")
    }

    #[test]
    fn or_pattern_classify() {
        let _ = testing::check_eq(super::classify_int(0), "tiny", "0 is tiny")
        let _ = testing::check_eq(super::classify_int(1), "tiny", "1 is tiny")
        let _ = testing::check_eq(super::classify_int(3), "small-prime", "3 is small-prime")
        let _ = testing::check_eq(super::classify_int(4), "other", "4 is other")
        let _ = testing::check_eq(super::classify_int(-5), "negative", "-5 is negative")
    }

    #[test]
    fn struct_rest_on_axis() {
        let p = super::Point3 { x: 9, y: 0, z: 0 }
        let desc = super::on_axis(p)
        let _ = testing::check(desc.contains("x-axis"), "x-axis detected")
        let _ = testing::check(desc.contains("9"), "x=9 in description")
    }

    #[test]
    fn struct_rest_off_axis() {
        let p = super::Point3 { x: 1, y: 2, z: 3 }
        let desc = super::on_axis(p)
        let _ = testing::check(desc.contains("off-axis"), "off-axis detected")
    }

    #[test]
    fn binding_or_pattern_shares_slot() {
        let _ = testing::check_eq(super::intensity(super::Signal::Red(3)), 3, "red binds n")
        let _ = testing::check_eq(super::intensity(super::Signal::Green(8)), 8, "green binds n")
        let _ = testing::check_eq(super::intensity(super::Signal::Yellow(4)), 1004, "yellow arm")
    }

    #[test]
    fn binding_or_pattern_with_guard() {
        let _ = testing::check_eq(super::describe(super::Signal::Red(5)), "lit 5", "lit guard")
        let _ = testing::check_eq(super::describe(super::Signal::Green(0)), "dark 0", "dark fallthrough")
        let _ = testing::check_eq(super::describe(super::Signal::Yellow(1)), "warn 1", "warn arm")
    }

    #[test]
    fn nested_binding_or_pattern() {
        let _ = testing::check_eq(
            super::cell_intensity(super::Cell::Filled(super::Signal::Green(9)))
            9
            "nested green binds n"
        )
        let _ = testing::check_eq(
            super::cell_intensity(super::Cell::Blank)
            -1
            "blank arm"
        )
    }

    #[test]
    fn result_nested_binding_or_pattern() {
        let _ = testing::check_eq(super::collapse_result(super::Ok(5)), 5, "ok binds x")
        let _ = testing::check_eq(super::collapse_result(super::Err(9)), 9, "err binds x")
    }

    #[test]
    fn option_nested_binding_or_pattern() {
        let _ = testing::check_eq(super::option_wrap(super::Some(super::Wrap::A(11))), 11, "wrap a")
        let _ = testing::check_eq(super::option_wrap(super::Some(super::Wrap::B(22))), 22, "wrap b")
        let _ = testing::check_eq(super::option_wrap(super::None), -1, "wrap none")
    }

    #[test]
    fn option_result_nested_binding_or_pattern() {
        let _ = testing::check_eq(super::option_result(super::Some(super::Ok(33))), 33, "opt ok")
        let _ = testing::check_eq(super::option_result(super::Some(super::Err(44))), 44, "opt err")
        let _ = testing::check_eq(super::option_result(super::None), -1, "opt none")
    }
}
