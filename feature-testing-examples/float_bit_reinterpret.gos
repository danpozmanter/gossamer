// IEEE-754 reinterpretation in both directions. The round trip must be
// bit-identical for every input, so the cases cover negative zero, both
// infinities, and a NaN with a payload - a tier that normalised NaN
// would show up here and nowhere else.

fn roundtrips(bits: u64) -> bool {
    f64::to_bits(f64::from_bits(bits)) == bits
}

fn main() {
    let cases: Vec<u64> = #[
        0
        9_223_372_036_854_775_808
        4_607_182_418_800_017_408
        9_218_868_437_227_405_312
        18_442_240_474_082_181_120
        9_221_120_237_041_090_560
        9_221_120_237_041_090_561
        18_444_492_273_895_866_368
        4_614_256_656_552_045_848
    ]
    for bits in cases {
        println("{} roundtrip {}", bits, roundtrips(bits))
    }

    println("pi bits {}", f64::to_bits(3.141592653589793))
    println("neg zero {}", f64::to_bits(-0.0))
    println("pos zero {}", f64::to_bits(0.0))
    println("method {}", 1.5.to_bits())

    println("f32 one and a half {}", f32::to_bits(1.5))
    println("f32 back {}", f32::from_bits(1_069_547_520))
    println("f32 neg zero {}", f32::to_bits(-0.0))
}
