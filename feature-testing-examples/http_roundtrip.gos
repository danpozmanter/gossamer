// Integration fixture chaining every client/server gap closed this
// cycle the way a real proxy session uses them, end to end on one
// process: binary `request_bytes` POST observed via the server's
// `r.raw_body` (NUL byte included, both halves of gap 5); a
// NUL-embedded byte-array response body served in full (the
// compiled h1 writer must prefer `body_bytes` over its c-string
// mirror); server `with_header` honored on the wire (gap 3) and
// read back through the client's `resp.headers` sequence (gap 1),
// then forwarded by a proxy hop; a 302 held raw by
// `max_redirects(0)` (gap 4); and a `next_chunk` drain of a
// `Response::stream` proxy passthrough (gap 6, client + server).
//
// Self-terminating: the client runs in main and exits explicitly.
// Binds fixed loopback ports 23908/23909 - serialized under
// SERVER_PORT_LOCK by `http_roundtrip_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::encoding
use std::http
use std::process
use std::time

fn header_of(headers: &[(String, String)], want: String) -> String {
    let mut found = ""
    for (name, value) in headers {
        if name.to_lowercase() == want {
            found = *value
        }
    }
    found
}

struct Upstream { }

impl http::Handler for Upstream {
    fn serve(&self, r: http::Request) -> Result<http::Response, http::Error> {
        let path = r.path()
        if path == "/echo-len" {
            let bytes = r.raw_body
            let mut sum = 0
            for b in bytes { sum += b as i64 }
            return Ok(http::Response::text(
                200,
                format!("len={} first={} last={} sum={}",
                    bytes.len(), bytes[0], bytes[bytes.len() - 1], sum),
            ))
        }
        if path == "/nul" {
            return Ok(http::Response {
                status: 200,
                body: [65, 0, 66, 0, 67],
                content_type: "application/octet-stream",
            })
        }
        if path == "/hop" {
            return Ok(http::Response::text(302, "redirecting").with_header("Location", "/data"))
        }
        if path == "/data" {
            return Ok(http::Response::text(200, "landed-data").with_header("x-up", "u1"))
        }
        Ok(http::Response::text(200, "streamed payload from upstream!"))
    }
}

struct Proxy { }

impl http::Handler for Proxy {
    fn serve(&self, r: http::Request) -> Result<http::Response, http::Error> {
        if r.path() == "/fwd" {
            return match http::get("http://127.0.0.1:23908/data", []) {
                Ok(up) => {
                    let tag = header_of(&up.headers, "x-up")
                    Ok(http::Response::text(up.status, "fwd:" + &up.body)
                        .with_header("x-up", tag))
                }
                Err(_) => Ok(http::Response::text(502, "bad upstream")),
            }
        }
        match http::stream(&r.method, "http://127.0.0.1:23908/stream", &r.body, []) {
            Ok(up) => Ok(http::Response::stream(up.status, up.content_type, up)),
            Err(_) => Ok(http::Response::text(502, "bad upstream")),
        }
    }
}

fn run_upstream() {
    if let Err(e) = http::serve("127.0.0.1:23908", Upstream { }) {
        eprintln!("serve failed: {e}")
    }
}

fn run_proxy() {
    if let Err(e) = http::serve("127.0.0.1:23909", Proxy { }) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
// Upstream is probed before the proxy: the proxy answers 502
// (an Ok response) while the upstream is still down.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        // A TCP/HTTP response alone is not readiness for the proxy: while
        // its upstream is still coming online it deliberately returns a
        // well-formed 502. Waiting for a successful response prevents the
        // next assertion from racing that transient application state.
        if let Ok(response) = http::get(url, []) {
            if response.status == 200 {
                return
            }
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go run_upstream()
    go run_proxy()
    await_ready(&"http://127.0.0.1:23908/data")
    await_ready(&"http://127.0.0.1:23909/fwd")

    match http::request_bytes("POST", "http://127.0.0.1:23908/echo-len", [1, 0, 2, 255], []) {
        Ok(r) => println!("echo status={} body={}", r.status, r.body),
        Err(e) => println!("echo error: {}", e),
    }

    match http::get("http://127.0.0.1:23908/nul", []) {
        Ok(r) => println!(
            "nul status={} len={} hex={}",
            r.status,
            r.raw_bytes.len(),
            encoding::hex::encode(r.raw_bytes)
        ),
        Err(e) => println!("nul error: {}", e),
    }

    let strict = http::Client::builder().max_redirects(0).timeout_ms(5000).build()
    match strict.request("GET", "http://127.0.0.1:23908/hop", "", []) {
        Ok(r) => println!("hop status={} location={}", r.status, r.location),
        Err(e) => println!("hop error: {}", e),
    }

    match http::get("http://127.0.0.1:23909/fwd", []) {
        Ok(r) => println!(
            "fwd status={} body={} x-up={}",
            r.status,
            r.body,
            header_of(&r.headers, "x-up")
        ),
        Err(e) => println!("fwd error: {}", e),
    }

    match http::stream("GET", "http://127.0.0.1:23909/stream", "", []) {
        Ok(s) => {
            let mut total = 0
            let mut chunks = 0
            let mut first_hex = ""
            while let Some(chunk) = s.next_chunk(8) {
                if chunks == 0 {
                    first_hex = encoding::hex::encode(chunk)
                }
                total += chunk.len()
                chunks += 1
            }
            println!("stream total={} chunks={} first_hex={}", total, chunks, first_hex)
        }
        Err(e) => println!("stream error: {}", e),
    }

    process::exit(0)
}
