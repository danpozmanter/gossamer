// os::arch() / os::family() are flagship introspection functions
// that had no compiled-tier shim. The native build's runtime archive
// is compiled for the same target as the host running `gos run`, so
// all three tiers report the identical arch/family string.

use std::os

fn main() {
    let fam = os::family()
    let arch = os::arch()
    println!("family={}", fam)
    println!("arch={}", arch)
    println!("family_nonempty={}", fam.len() > 0)
    println!("arch_nonempty={}", arch.len() > 0)
}
