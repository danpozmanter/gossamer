// Recursive Enum Walk
// Implement a small linked list/tree using enum + Box and recursively
// traverse it to test heap layout and recursive dispatch.

enum Tree {
    Leaf(i64),
    Node(i64, Box<Tree>, Box<Tree>),
}

fn sum(tree: &Tree) -> i64 {
    match tree {
        Tree::Leaf(v) => *v,
        Tree::Node(v, left, right) => *v + sum(left) + sum(right),
    }
}

fn count(tree: &Tree) -> i64 {
    match tree {
        Tree::Leaf(_) => 1,
        Tree::Node(_, left, right) => 1 + count(left) + count(right),
    }
}

fn max_depth(tree: &Tree) -> i64 {
    match tree {
        Tree::Leaf(_) => 1,
        Tree::Node(_, left, right) => {
            let dl = max_depth(left)
            let dr = max_depth(right)
            if dl > dr { 1 + dl } else { 1 + dr }
        }
    }
}

fn main() {
    let tree = Tree::Node(
        10,
        Box::new(Tree::Node(
            5,
            Box::new(Tree::Leaf(2)),
            Box::new(Tree::Leaf(7)),
        )),
        Box::new(Tree::Node(
            15,
            Box::new(Tree::Leaf(12)),
            Box::new(Tree::Leaf(20)),
        )),
    )

    println!("sum = {}", sum(&tree))
    println!("count = {}", count(&tree))
    println!("max_depth = {}", max_depth(&tree))

    // Walk with while let on a list built from the same enum shape
    let list = cons(1, cons(2, cons(3, cons(4, Nil))))
    println!("list_sum = {}", list_sum(&list))
    println!("list_len = {}", list_len(&list))
}

enum List {
    Nil,
    Cons(i64, Box<List>),
}

fn cons(v: i64, rest: List) -> List {
    List::Cons(v, Box::new(rest))
}

fn list_sum(list: &List) -> i64 {
    match list {
        List::Nil => 0,
        List::Cons(v, rest) => *v + list_sum(rest),
    }
}

fn list_len(list: &List) -> i64 {
    match list {
        List::Nil => 0,
        List::Cons(_, rest) => 1 + list_len(rest),
    }
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn leaf_sum() {
        let t = super::Tree::Leaf(42)
        let _ = testing::check_eq(&super::sum(&t), &42, "leaf sum=42")
    }

    #[test]
    fn tree_sum_count_depth() {
        let t = super::Tree::Node(
            10,
            Box::new(super::Tree::Leaf(5)),
            Box::new(super::Tree::Leaf(7)),
        )
        let _ = testing::check_eq(&super::sum(&t), &22, "10+5+7=22")
        let _ = testing::check_eq(&super::count(&t), &3, "3 nodes")
        let _ = testing::check_eq(&super::max_depth(&t), &2, "depth 2")
    }

    #[test]
    fn list_sum_len() {
        let l = super::cons(1, super::cons(2, super::cons(3, super::List::Nil)))
        let _ = testing::check_eq(&super::list_sum(&l), &6, "1+2+3=6")
        let _ = testing::check_eq(&super::list_len(&l), &3, "len=3")
    }

    #[test]
    fn empty_list() {
        let l = super::List::Nil
        let _ = testing::check_eq(&super::list_sum(&l), &0, "nil sum=0")
        let _ = testing::check_eq(&super::list_len(&l), &0, "nil len=0")
    }
}
