// Cross-tier coverage for `resp.raw_bytes`: the HTTP client's
// binary body accessor returns a PACKED `elem_bytes=1` GosVec
// (one byte per element, not the canonical i64-per-element
// model), so every consumer surface must be stride-aware. This
// fixture round-trips a body with multi-byte UTF-8 (bytes above
// 0x7F catch sign-extension and word-stride bugs) through the
// full op set: len, indexing, for-loop sum, first/last/contains/
// count_of/index_of, a real std byte consumer (hex::encode), and
// in-place `v[i] = x` mutation.
//
// Body "Aÿ™z" = 41 C3 BF E2 84 A2 7A (7 bytes).
//
// Self-terminating: the client runs in main and exits explicitly.
// Binds a fixed loopback port - serialized under SERVER_PORT_LOCK
// by `http_raw_bytes_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::encoding
use std::http
use std::process
use std::time

struct App { }

impl http::Handler for App {
    fn serve(&self, _r: http::Request) -> Result<http::Response, http::Error> {
        Ok(http::Response::text(200, "Aÿ™z"))
    }
}

fn run_server() {
    if let Err(e) = http::serve("127.0.0.1:23871", App { }) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from(#[])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go run_server()
    await_ready(&"http://127.0.0.1:23871/bytes")
    match http::get("http://127.0.0.1:23871/bytes", Vec::from(#[])) {
        Ok(r) => {
            let mut v = r.raw_bytes
            println!("len={}", v.len())
            println!("v0={} vlast={}", v[0], v[v.len() - 1])
            let mut sum = 0
            for b in v { sum += b as i64 }
            println!("sum={}", sum)
            match v.first() {
                Some(b) => println!("first={}", b),
                None => println!("first=none"),
            }
            match v.last() {
                Some(b) => println!("last={}", b),
                None => println!("last=none"),
            }
            println!("contains_195={}", v.contains(&195))
            println!("contains_255={}", v.contains(&255))
            println!("count_132={}", v.count_of(&132))
            match v.index_of(&226) {
                Some(i) => println!("idx_226={}", i),
                None => println!("idx_226=none"),
            }
            println!("hex={}", encoding::hex::encode(v))
            v[0] = 66
            println!("mutated_v0={} hex2={}", v[0], encoding::hex::encode(v))
        }
        Err(e) => println!("error: {}", e),
    }
    process::exit(0)
}
