// `Set::from(values)` over a sequence whose elements are only known at run
// time. The literal form is unrolled into individual inserts at lowering
// time; a value has to be walked by the runtime, which the compiled tiers
// could not do at all - the call reached an undefined `Set` symbol.

use std::collections::BTreeSet

fn main() {
    let words = Vec::from(["b", "a", "b", "c"])
    let s = Set::from(words)
    println("len      = {}", s.len())
    println("contains = {} {}", s.contains("a"), s.contains("z"))
    println("elements = {:?}", s.to_vec())

    let nums = Vec::from([3, 1, 3, 2])
    let n = Set::from(nums)
    println("num len  = {}", n.len())
    println("num elems= {:?}", n.to_vec())

    let ordered: BTreeSet<String> = BTreeSet::from(words)
    println("btree    = {:?}", ordered.to_vec())

    let empty: Vec<i64> = Vec::from([])
    println("empty    = {}", Set::from(empty).len())
}
