// Cross-tier parity for archive::{tar,zip} write+read roundtrip.
// `write` takes [(String, [u8])] tuples (including let-bound literals,
// which the checker re-types so nested byte arrays become heap Vecs);
// `read` returns real TarEntry / ZipEntry structs (injected
// real-struct wrappers over a [(String, [u8], bool)] tuple-vec leaf).
use std::archive

fn main() {
    let files = Vec::from([("hello.txt", Vec::from([104, 105])), ("dir/x.txt", Vec::from([120]))])
    match archive::tar::write(files) {
        Ok(bytes) => match archive::tar::read(bytes) {
            Ok(es) => println!("tar n={} e0={} d0={} e1={}", es.len(), es[0].name, es[0].data.len(), es[1].name)
            Err(_e) => println!("tar read err")
        }
        Err(_e) => println!("tar write err")
    }
    match archive::zip::write(Vec::from([("hello.txt", Vec::from([104, 105, 106]))])) {
        Ok(bytes) => match archive::zip::read(bytes) {
            Ok(es) => println!("zip n={} e0={} d0={}", es.len(), es[0].name, es[0].data.len())
            Err(_e) => println!("zip read err")
        }
        Err(_e) => println!("zip write err")
    }
}
