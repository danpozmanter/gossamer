// `policy.env_allow_all(names)` - one edit for a whole list.
//
// Every policy builder answers the policy as it now stands, which means
// each call copies the policy it edits. Allow-listing an inherited
// environment one name at a time therefore copies a growing policy once
// per variable; this hands the list over whole.
//
// The fixture sets its own names and reads back only those, so the
// transcript is the same on every host whatever else the environment
// carries.

use std::{env, sandbox}

fn main() {
    env::set_var("GOS_ALLOW_ONE", "1")
    env::set_var("GOS_ALLOW_TWO", "2")
    env::set_var("GOS_ALLOW_THREE", "3")

    let policy = sandbox::Policy::new()
        .env_allow_all(#["GOS_ALLOW_ONE", "GOS_ALLOW_TWO", "GOS_ALLOW_THREE"])

    let mut mine = #[]
    for name in policy.environment_names() {
        if name.starts_with("GOS_ALLOW_") {
            mine.push(format("{}={}", name, policy.environment_value(name)))
        }
    }
    mine.sort()
    println("allowed={}", mine.join(","))

    // An empty list is a policy unchanged, not a policy emptied.
    let untouched = policy.env_allow_all(#[])
    let mut still = 0
    for name in untouched.environment_names() {
        if name.starts_with("GOS_ALLOW_") { still += 1 }
    }
    println("after-empty={}", still)

    // One name at a time reaches the same place.
    let single = sandbox::Policy::new()
        .env_allow("GOS_ALLOW_ONE")
        .env_allow("GOS_ALLOW_TWO")
        .env_allow("GOS_ALLOW_THREE")
    println("same={}", single.environment_names() == policy.environment_names())
}
