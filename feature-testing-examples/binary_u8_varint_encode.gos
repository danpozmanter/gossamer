// Cross-tier parity for the encoding::binary completions: single-byte
// get_u8 / put_u8 and the varint encoders put_uvarint / put_varint
// (the decode side, uvarint / varint, already shipped). Round-trips and
// boundary values must be bit-identical on the VM and the LLVM AOT tier.

use std::encoding

fn main() {
    let empty: [u8] = []

    // --- single byte put/get round-trip across the u8 range ---
    for v in [0, 1, 127, 128, 200, 255] {
        let b = encoding::binary::put_u8(empty, v)
        match encoding::binary::get_u8(b) {
            Ok(got) => println!("u8 {} -> len {} -> {}", v, b.len(), got),
            Err(e) => println!("u8 {} err {}", v, e),
        }
    }
    match encoding::binary::get_u8(empty) {
        Ok(_) => println!("get_u8 empty: ok?!"),
        Err(_) => println!("get_u8 empty: err"),
    }

    // --- unsigned varint encode -> decode round-trip ---
    for x in [0, 1, 127, 128, 300, 16384, 9007199254740991] {
        let enc = encoding::binary::put_uvarint(empty, x)
        let hex = encoding::hex::encode(enc)
        match encoding::binary::uvarint(enc) {
            Ok((v, n)) => println!("uvarint {} = {} (len {}, rt {} consumed {})", x, hex, enc.len(), v, n),
            Err(e) => println!("uvarint {} err {}", x, e),
        }
    }

    // --- signed (zigzag) varint encode -> decode round-trip ---
    for x in [0, -1, 1, -64, 63, -1000000, 2147483647] {
        let enc = encoding::binary::put_varint(empty, x)
        match encoding::binary::varint(enc) {
            Ok((v, n)) => println!("varint {} = {} (len {}, consumed {})", x, v, enc.len(), n),
            Err(e) => println!("varint {} err {}", x, e),
        }
    }
}
