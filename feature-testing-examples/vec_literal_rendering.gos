// A `Vec` renders in its own literal spelling, at every depth.
//
// `#[..]` is what a program writes to build a `Vec`, so it is what a
// `Vec` shows as - top level or nested, `{}` or `{:?}`, on the bytecode
// VM and both compiled tiers, and in the REPL. A fixed array and a
// slice are written in bare brackets and render that way, which is the
// one thing that tells them apart: the two share a runtime
// representation, so the static type is what answers.

struct Coords { path: Vec<i64>, corner: [i64; 2] }

struct Tag { name: String }

impl Display for Tag {
    fn fmt(&self) -> String {
        format("<{}>", self.name)
    }
}

fn main() {
    let owned = #[1, 2]
    let fixed = [1, 2]
    println("display: {} {}", owned, fixed)
    println("debug: {:?} {:?}", owned, fixed)

    println("nested vec: {:?}", #[#[1, 2]])
    println("nested array: {:?}", #[[1, 2]])
    println("array of vec: {:?}", [#[1, 2]])
    println("deep: {:?}", #[#[#[1]]])

    println("in map: {:?}", { "k": #[1, 2] })
    println("in tuple: {:?}", (#[1], [2]))
    println("in option: {:?}", Some(#[1, 2]))
    println("in result: {:?}", Ok(#[3]))

    let coords = Coords { path: #[1, 2], corner: [3, 4] }
    println("struct display: {}", coords)
    println("struct debug: {:?}", coords)

    // A value whose own type supplies the rendering walks a separate
    // path; the spelling of the sequence around it is the same one.
    let tagged = #[Tag { name: "a" }, Tag { name: "b" }]
    println("of rendered: {}", tagged)
    println("array of rendered: {}", [Tag { name: "c" }])
    println("nested rendered: {}", #[#[Tag { name: "d" }]])

    println("empty: {:?}", Vec::from([]))

    // The same text a format site builds, built by the method that
    // answers it, and by the join that renders the elements alone.
    println("to_string: {} {}", owned.to_string(), fixed.to_string())
    println("nested to_string: {}", #[#[1, 2]].to_string())
    println("join: {}", #[#[1, 2], #[3]].join(" | "))
    println("join arrays: {}", #[[1, 2], [3, 4]].join(" | "))
}
