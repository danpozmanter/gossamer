// Vector-math operator overloading: a `Vec3` with `impl Add / Sub / Mul /
// Neg / Index` drives nbody-style arithmetic (`a + b`, `v * s`, `-v`,
// `v[i]`), and compound assignment (`+=`, `*=`) routes through the same
// impls. The hot loop lives in a helper so the JIT tier compiles it.
// Output must be bit-identical across the VM, Cranelift, and LLVM.
struct Vec3 { x: f64, y: f64, z: f64 }

impl Add for Vec3 {
    fn add(self, o: Vec3) -> Vec3 { Vec3(self.x + o.x, self.y + o.y, self.z + o.z) }
}
impl Sub for Vec3 {
    fn sub(self, o: Vec3) -> Vec3 { Vec3(self.x - o.x, self.y - o.y, self.z - o.z) }
}
impl Mul for Vec3 {
    fn mul(self, s: f64) -> Vec3 { Vec3(self.x * s, self.y * s, self.z * s) }
}
impl Neg for Vec3 {
    fn neg(self) -> Vec3 { Vec3(-self.x, -self.y, -self.z) }
}
impl Index for Vec3 {
    fn index(self, i: i64) -> f64 {
        if i == 0 { self.x } else if i == 1 { self.y } else { self.z }
    }
}

fn orbit(steps: i64) -> Vec3 {
    let mut pos = Vec3(1.0, 2.0, 3.0)
    let mut vel = Vec3(0.5, -0.25, 0.125)
    let mut i = 0
    while i < steps {
        let pull = -pos * 0.001
        vel += pull
        pos = pos + vel * 0.5
        i += 1
    }
    pos - vel
}

fn main() {
    let p = orbit(1000)
    println!("orbit: {} {} {}", p.x, p.y, p.z)
    println!("index: {} {} {}", p[0], p[1], p[2])
    let mut acc = Vec3(0.0, 0.0, 0.0)
    acc += Vec3(1.5, 2.0, -0.5)
    acc += Vec3(0.25, -1.0, 4.0)
    acc *= 2.0
    println!("acc: {} {} {}", acc.x, acc.y, acc.z)
}
