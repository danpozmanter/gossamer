// Fixed-size arrays passed to `&mut [T]` / exact `&mut [T; N]` parameters
// write through to the caller's source place, matching local `&mut` aliases.

fn set_first(v: &mut [i64]) {
    v[0] = 99
}

fn push_one(v: &mut Vec<i64>) {
    v.push(4)
}

fn mutate_exact_copy(v: &mut [i64; 3]) -> &mut [i64; 3] {
    v[0] = 77
    v
}

fn main() {
    let mut fixed: [i64; 3] = [1, 2, 3]
    set_first(&mut fixed)
    println!("fixed_after_set: {} {} {}", fixed[0], fixed[1], fixed[2])

    let mut fixed_exact = [1, 2, 3]
    let fixed_alias = &mut fixed_exact
    let exact_result = mutate_exact_copy(fixed_alias)
    println!("fixed_exact_source: {}", fixed_exact[0])
    println!("fixed_exact_result: {}", exact_result[0])

    let mut grow: Vec<i64> = Vec::from([1, 2, 3])
    set_first(&mut grow)
    push_one(&mut grow)
    println!("vec_after: len={} first={} last={}", grow.len(), grow[0], grow[3])
}
