// Serde for named structs round-trips through to_json / from_json on every
// tier. Parenthesized construction assigns values in declaration order.

struct Rec { id: i64, name: String, enabled: bool }
struct Id { value: i64 }

fn main() {
    let s = to_json::<Rec>(Rec(7, "hi", true)) |> _.unwrap_or("")
    let r: Rec = from_json::<Rec>(&s) |> _.unwrap_or(Rec(0, "", false))
    let id_s = to_json::<Id>(Id(42)) |> _.unwrap_or("")
    println!("{} {} {} {} {}", s, r.id, r.name, r.enabled, id_s)
}
