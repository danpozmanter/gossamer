/*
 * A map value that stands for a whole value - a sequence, an aggregate, a
 * float - compares by its content, so two maps holding equal values at
 * distinct allocations are equal and one holding a NaN is unequal to itself.
 * The comparisons run through helpers called more than once so every tier
 * answers from its own compiled form.
 */

struct Point { x: i64, y: i64 }

fn sequence_values() -> String {
    let mut a: Map<String, Vec<i64>> = Map::new()
    a.insert("k", #[1, 2])
    let mut b: Map<String, Vec<i64>> = Map::new()
    b.insert("k", #[1, 2])
    let mut c: Map<String, Vec<i64>> = Map::new()
    c.insert("k", #[1, 3])
    format("{} {}", a == b, a == c)
}

fn struct_values() -> String {
    let mut a: Map<String, Point> = Map::new()
    a.insert("k", Point { x: 1, y: 2 })
    let mut b: Map<String, Point> = Map::new()
    b.insert("k", Point { x: 1, y: 2 })
    let mut c: Map<String, Point> = Map::new()
    c.insert("k", Point { x: 1, y: 9 })
    format("{} {}", a == b, a == c)
}

fn nan_values() -> String {
    let nan = 0.0 / 0.0
    let mut a: Map<String, f64> = Map::new()
    a.insert("k", nan)
    let mut b: Map<String, f64> = Map::new()
    b.insert("k", nan)
    format("{}", a == b)
}

fn main() {
    let mut lines: Vec<String> = #[]
    for _ in 0..3 {
        lines.push(sequence_values())
        lines.push(struct_values())
        lines.push(nan_values())
    }
    println("{}", lines[0])
    println("{}", lines[1])
    println("{}", lines[2])
    println("stable: {}", lines[0] == lines[6] && lines[1] == lines[7] && lines[2] == lines[8])
}
