// Error ? Propagation
// Thread errors through multiple Result-returning frames using `?`
// to verify automatic unwrapping and early-return semantics.

fn parse_positive(s: String) -> Result<i64, String> {
    let n = s.parse::<i64>().map_err(|_| "not a number")?
    if n <= 0 {
        Err(format!("{} is not positive", n))
    } else {
        Ok(n)
    }
}

fn double_positive(s: String) -> Result<i64, String> {
    let n = parse_positive(s)?
    Ok(n * 2)
}

fn sum_positives(inputs: Vec<String>) -> Result<i64, String> {
    let mut total = 0
    for s in inputs {
        let n = parse_positive(s)?
        total += n
    }
    Ok(total)
}

fn main() {
    // Happy path
    match double_positive("21") {
        Ok(v) => println!("double(21) = {}", v),
        Err(e) => println!("error: {}", e),
    }

    // Not a number
    match double_positive("abc") {
        Ok(v) => println!("unexpected {}", v),
        Err(e) => println!("not a number: {}", e),
    }

    // Non-positive
    match double_positive("-5") {
        Ok(v) => println!("unexpected {}", v),
        Err(e) => println!("non-positive: {}", e),
    }

    // Zero
    match parse_positive("0") {
        Ok(v) => println!("unexpected {}", v),
        Err(e) => println!("zero rejected: {}", e),
    }

    // Sum success
    let words: Vec<String> = Vec::from(#["1", "2", "3"])
    match sum_positives(words) {
        Ok(s) => println!("sum = {}", s),
        Err(e) => println!("sum error: {}", e),
    }

    // Sum with bad element
    let bad: Vec<String> = Vec::from(#["1", "bad", "3"])
    match sum_positives(bad) {
        Ok(s) => println!("unexpected sum {}", s),
        Err(e) => println!("sum stopped at: {}", e),
    }
}

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn parse_positive_ok() {
        let r = super::parse_positive("42")
        match r {
            Ok(v) => { let _ = testing::check_eq(&v, &42, "parse_positive 42")
            },
            Err(e) => { let _ = testing::check(false, e)
            },
        }
    }

    #[test]
    fn parse_positive_rejects_zero() {
        let r = super::parse_positive("0")
        match r {
            Ok(_) => { let _ = testing::check(false, "expected error for 0")
            },
            Err(_) => { let _ = testing::check(true, "zero rejected")
            },
        }
    }

    #[test]
    fn question_mark_short_circuits() {
        let r = super::sum_positives(#["1", "-1", "2"])
        match r {
            Ok(_) => { let _ = testing::check(false, "expected early exit")
            },
            Err(_) => { let _ = testing::check(true, "short-circuited on -1")
            },
        }
    }
}
