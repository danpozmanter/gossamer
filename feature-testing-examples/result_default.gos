// result::unwrap_or across payload shapes: the Ok payload passes
// through, the fallback replaces an Err - for i64, f64, and String
// payloads, both direct-call and |>-piped spellings.

use std::result

fn ok_int() -> Result<i64, String> { Ok(42) }
fn err_int() -> Result<i64, String> { Err("nope") }
fn ok_str() -> Result<String, String> { Ok("payload") }
fn err_str() -> Result<String, String> { Err("nope") }
fn ok_float() -> Result<f64, String> { Ok(2.5) }
fn err_float() -> Result<f64, String> { Err("nope") }

fn main() {
    println("{}", ok_int() |> |v| result::unwrap_or(v, -1))
    println("{}", err_int() |> |v| result::unwrap_or(v, -1))
    println("{}", ok_str() |> |v| result::unwrap_or(v, "fallback"))
    println("{}", err_str() |> |v| result::unwrap_or(v, "fallback"))
    println("{}", ok_float() |> |v| result::unwrap_or(v, 0.5))
    println("{}", err_float() |> |v| result::unwrap_or(v, 0.5))

    let direct = result::unwrap_or(err_int(), 7)
    println("{}", direct)

    let bound = ok_str() |> |v| result::unwrap_or(v, "unused")
    let twice = bound + "!"
    println("{}", twice)
}
