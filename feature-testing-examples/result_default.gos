// result::unwrap_or across payload shapes: the Ok payload passes
// through, the fallback replaces an Err - for i64, f64, and String
// payloads, both direct-call and |>-piped spellings.

use std::result

fn ok_int() -> Result<i64, String> { Ok(42) }
fn err_int() -> Result<i64, String> { Err("nope") }
fn ok_str() -> Result<String, String> { Ok("payload") }
fn err_str() -> Result<String, String> { Err("nope") }
fn ok_float() -> Result<f64, String> { Ok(2.5) }
fn err_float() -> Result<f64, String> { Err("nope") }

fn main() {
    println!("{}", ok_int() |> |v| result::unwrap_or(-1, v))
    println!("{}", err_int() |> |v| result::unwrap_or(-1, v))
    println!("{}", ok_str() |> |v| result::unwrap_or("fallback", v))
    println!("{}", err_str() |> |v| result::unwrap_or("fallback", v))
    println!("{}", ok_float() |> |v| result::unwrap_or(0.5, v))
    println!("{}", err_float() |> |v| result::unwrap_or(0.5, v))

    let direct = result::unwrap_or(7, err_int())
    println!("{}", direct)

    let bound = ok_str() |> |v| result::unwrap_or("unused", v)
    let twice = bound + "!"
    println!("{}", twice)
}
