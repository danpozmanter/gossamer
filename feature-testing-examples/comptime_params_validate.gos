// Comptime parameters (P3) and compile-time validation macros (P4).

// P3: a `comptime` parameter's argument is evaluated at build time and
// replaced with its result literal. `scale` runs at runtime with a
// folded constant factor and a runtime input.
const BASE: i64 = 100

fn scale(comptime factor: i64, x: i64) -> i64 {
    factor * x
}

comptime fn squares_sum(n: i64) -> i64 {
    let mut acc = 0
    for i in 1..=n {
        acc += i * i
    }
    acc
}

fn main() {
    let x = 7
    // `BASE * 2 + 5` is folded to 205 at the call site.
    println!("{}", scale(BASE * 2 + 5, x))
    // A comptime-fn result used as the comptime argument also folds.
    println!("{}", scale(squares_sum(10), x))

    // P4: `regex!` / `sql!` validate at build time and fold to the
    // original string on success. Malformed input would fail the build.
    let pattern = regex!("^\\d{4}-\\d{2}-\\d{2}$")
    let query = sql!("SELECT id, name FROM users WHERE active = 1")
    println!("{}", pattern)
    println!("{}", query)
}
