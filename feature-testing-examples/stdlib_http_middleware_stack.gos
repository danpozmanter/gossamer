// Cross-tier parity for the composable `http::middleware` stack. One
// request is served through cors + security_headers + etag + rate_limit
// wrapped around a plain handler, and the middleware-set headers are
// printed in a fixed order (looked up case-insensitively, since the two
// tiers' header stores differ in case and emission order). A second and
// third request exercise the token bucket: capacity 2 means the third
// answer is a 429.
//
// The shed answer carries only what the limiter owes the client. A control
// that sheds load does not run the work below it, so the decorations of
// every layer INSIDE it are absent by construction - which is the whole
// point of shedding rather than accounting. An application that wants CORS
// on a shed response wraps `cors` OUTSIDE `rate_limit`, and the layers
// above the limiter still decorate what it answers.
use std::http
use std::http::middleware
use std::process
use std::strings
use std::time

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> http::Response {
        http::Response::text(200, "ok")
    }
}

fn serve_app() {
    let secured = middleware::security_headers(
        middleware::cors(App { }, middleware::CorsConfig::permissive())
        middleware::SecurityHeaders::strict())
    let cached = middleware::cache_control(
        middleware::hsts(secured, middleware::HstsConfig::safe_default())
        middleware::CacheControl::no_store())
    let stack = middleware::rate_limit(
        middleware::timeout(
            middleware::compress_gzip(middleware::etag(cached))
            2500)
        middleware::RateLimit::per_ip(2, 1))
    if let Err(e) = http::serve("127.0.0.1:23947", stack) {
        eprintln("serve failed: {e}")
    }
}

fn header_of(response: http::Response, wanted: String) -> String {
    for (name, value) in response.headers {
        if strings::to_lowercase(name) == wanted {
            return value
        }
    }
    "<absent>"
}

fn report(label: String, response: http::Response) {
    println("{} status={} body={}", label, response.status, response.body)
    let wanted = #[
        "access-control-allow-origin"
        "access-control-allow-methods"
        "access-control-max-age"
        "x-content-type-options"
        "x-frame-options"
        "referrer-policy"
        "content-security-policy"
        "etag"
        "strict-transport-security"
        "cache-control"
        "vary"
        "x-timeout-ms"
        "retry-after"
    ]
    for name in wanted {
        println("  {}: {}", name, header_of(response, name))
    }
}

fn await_ready(url: String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) { return }
        time::sleep(25)
        tries += 1
    }
}

fn print_configs() {
    println("cors={}", middleware::CorsConfig::new("https://app.test", "GET, PUT", "X-Api-Key", 600))
    println("hsts={}", middleware::HstsConfig::strict())
    println("security={}", middleware::SecurityHeaders::off())
    println("cache={}", middleware::CacheControl::immutable_for(31536000))
    println("rate={}", middleware::RateLimit::per_ip(100, 10))
}

fn main() {
    print_configs()
    spawn(|| serve_app())
    let url = "http://127.0.0.1:23947/probe"
    await_ready(url)

    // The readiness probe already consumed one token.
    match http::get(url, Vec::from([])) {
        Ok(r) => report("allowed", r)
        Err(e) => println("error: {}", e)
    }
    match http::get(url, Vec::from([])) {
        Ok(r) => report("limited", r)
        Err(e) => println("error: {}", e)
    }

    process::exit(0)
}
