// Gossamer-native SQL driver dispatch (sql::register_native).
//
// A trivial in-memory `.gos` driver registers itself as a
// std::database::sql driver, then is driven through the full
// Conn/Stmt/Rows facade. The driver is a stateless struct with one
// method, `dispatch(&self, op, h) -> i64`; all complex data flows
// through the sql::native_* side-channel helpers keyed by the token
// `h`. This must produce byte-identical output on the bytecode VM
// (gos run), the Cranelift JIT, and the LLVM AOT tier (gos build /
// gos build --release).

use std::database::sql
use std::errors

// Op codes shared with the runtime (gossamer-runtime c_abi::sql).
const OP_OPEN: i64 = 0
const OP_CLOSE: i64 = 1
const OP_PREPARE: i64 = 2
const OP_STMT_QUERY: i64 = 4
const OP_STMT_CLOSE: i64 = 5
const OP_ROWS_NEXT: i64 = 6
const OP_ROWS_CLOSE: i64 = 7

// The cursor is one-shot: STMT_QUERY arms it, the first ROWS_NEXT
// yields a row, the next marks end-of-set. A scalar static mut is a
// real shared global on every tier.
static mut ROW_PENDING: bool = false

struct FakeDriver { }

impl FakeDriver {
    fn dispatch(&self, op: i64, h: i64) -> i64 {
        if op == OP_OPEN {
            return 0
        }
        if op == OP_PREPARE {
            return 0
        }
        if op == OP_STMT_QUERY {
            let rows = sql::native_out_handle(h)
            sql::native_push_column(rows, "greeting")
            ROW_PENDING = true
            return 0
        }
        if op == OP_ROWS_NEXT {
            if ROW_PENDING {
                sql::native_push_value(h, sql::value_text("hello, native driver"))
                sql::native_row_ready(h)
                ROW_PENDING = false
            }
            return 0
        }
        if op == OP_CLOSE {
            return 0
        }
        if op == OP_STMT_CLOSE {
            return 0
        }
        if op == OP_ROWS_CLOSE {
            return 0
        }
        sql::native_set_error(h, "fake driver: unsupported op")
        -1
    }
}

fn run() -> Result<(), errors::Error> {
    sql::register_native("fake", FakeDriver { })
    let mut db = sql::open("fake", "memory://x")?
    let mut rows = db.query("SELECT greeting", &[])?
    while let Some(row) = rows.next_row()? {
        println!("greeting = {}", row.get_text("greeting")?)
    }
    rows.close()?
    db.close()?
    Ok(())
}

fn main() {
    match run() {
        Ok(()) => println!("done"),
        Err(e) => println!("error: {}", e),
    }
}
