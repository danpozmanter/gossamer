// Reassigning an owning container binding inside a loop (`v = make()`)
// must free each prior buffer instead of leaking it (RAM A1). The
// move-transfer hands the fresh vec's ownership to `v` and frees `v`'s
// previous value before the overwrite. Output is a scalar so it is
// bit-identical across tiers while the RSS stays bounded.

fn make(n: i64) -> Vec<i64> {
    let mut v: Vec<i64> = Vec::from([])
    let mut i = 0
    while i < n {
        v.push(i * 2)
        i += 1
    }
    v
}

fn main() {
    let mut v: Vec<i64> = Vec::from([])
    let mut r = 0
    while r < 2000 {
        v = make(64)
        r += 1
    }
    let mut sum = 0
    for x in v {
        sum += x
    }
    println!("len: {}", v.len())
    println!("sum: {}", sum)
}
