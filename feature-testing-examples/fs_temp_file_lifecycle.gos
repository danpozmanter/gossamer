// Filesystem Temp-File Lifecycle
// Write a file, verify it exists, read it back, append to it,
// check sizes, and delete it - covering the common create/read/
// delete lifecycle across fs:: operations.

use std::{env, errors}
use std::fs
use std::path

fn temp_path(name: String) -> String {
    path::join(&env::temp_dir(), &format!("gossamer_test_{}", name))
}

fn write_and_read(path: String, content: String) -> Result<String, errors::Error> {
    fs::write(path, content)?
    fs::read_to_string(path)
}

fn main() {
    let path = temp_path("lifecycle.txt")

    // Create
    match fs::write(path, "line one\nline two\nline three\n") {
        Ok(_) => println!("write ok"),
        Err(e) => { println!("write error: {}", e); return }
    }

    // Exists
    println!("exists after write: {}", fs::exists(path))

    // Read back
    match fs::read_to_string(path) {
        Ok(content) => {
            let lines = content.split("\n")
            println!("line count = {}", lines.len() - 1)
            println!("line[0] = {}", lines[0])
        }
        Err(e) => println!("read error: {}", e)
    }

    // Overwrite
    match fs::write(path, "replaced content") {
        Ok(_) => println!("overwrite ok"),
        Err(e) => println!("overwrite error: {}", e)
    }
    match fs::read_to_string(path) {
        Ok(s) => println!("overwritten: {}", s.trim()),
        Err(e) => println!("read error: {}", e)
    }

    // Remove
    match fs::remove_file(path) {
        Ok(_) => println!("remove ok"),
        Err(e) => println!("remove error: {}", e)
    }
    println!("exists after remove: {}", fs::exists(path))

    // Directory creation and removal
    let dir = temp_path("lifecycle_dir")
    match fs::create_dir_all(dir) {
        Ok(_) => println!("dir created"),
        Err(e) => println!("mkdir error: {}", e)
    }
    println!("dir exists: {}", fs::exists(dir))
    match fs::remove_all(dir) {
        Ok(_) => println!("dir removed"),
        Err(e) => println!("rmdir error: {}", e)
    }
    println!("dir gone: {}", !fs::exists(dir))
}

#[cfg(test)]
mod tests {
    use std::fs
    use std::testing

    #[test]
    fn write_read_roundtrip() {
        let path = "/tmp/gossamer_test_rw.txt"
        let content = "hello from test"
        match fs::write(path, content) {
            Ok(_) => {}
            Err(e) => { testing::check(false, e); return }
        }
        match fs::read_to_string(path) {
            Ok(s) => testing::check_eq(&s.trim().to_string(), &content.to_string(), "roundtrip"),
            Err(e) => testing::check(false, e),
        }
        let _ = fs::remove_file(path)
    }

    #[test]
    fn exists_reflects_file_presence() {
        let path = "/tmp/gossamer_test_exists.txt"
        let _ = fs::remove_file(path)
        testing::check(!fs::exists(path), "not present initially")
        let _ = fs::write(path, "x")
        testing::check(fs::exists(path), "present after write")
        let _ = fs::remove_file(path)
        testing::check(!fs::exists(path), "gone after remove")
    }

    #[test]
    fn overwrite_replaces_content() {
        let path = "/tmp/gossamer_test_overwrite.txt"
        let _ = fs::write(path, "first")
        let _ = fs::write(path, "second")
        match fs::read_to_string(path) {
            Ok(s) => testing::check_eq(&s, &"second", "overwritten"),
            Err(e) => testing::check(false, e),
        }
        let _ = fs::remove_file(path)
    }
}
