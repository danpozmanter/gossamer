// HashMap Counter Race
// Use HashMap.inc and or_insert patterns with repeated updates to
// confirm map mutation semantics and ordering assumptions.

use std::collections::HashMap

fn main() {
    let mut tally: HashMap<String, i64> = HashMap::new()

    // Counter idiom via inc
    tally.inc("apple")
    tally.inc("banana")
    tally.inc("apple")
    tally.inc("apple", 3)

    println!("apple = {}", tally.get_or("apple", 0))
    println!("banana = {}", tally.get_or("banana", 0))
    println!("cherry = {}", tally.get_or("cherry", 0))

    // or_insert pattern
    tally.or_insert("cherry", 10)
    tally.or_insert("cherry", 99)
    println!("cherry after or_insert = {}", tally.get_or("cherry", 0))

    // Manual update loop
    let words = ["one", "two", "two", "three", "three", "three"]
    let mut counts: HashMap<String, i64> = HashMap::new()
    for w in words {
        counts.inc(w)
    }

    for (k, v) in counts.iter() {
        println!("{} -> {}", k, v)
    }

    // Repeated mutation stress
    let mut stress: HashMap<i64, i64> = HashMap::new()
    for i in 0..1000 {
        stress.inc(i % 7)
    }
    for i in 0..7 {
        println!("bucket {} = {}", i, stress.get_or(i, 0))
    }
}

#[cfg(test)]
mod tests {
    use std::testing
    use std::collections::HashMap

    #[test]
    fn inc_accumulates() {
        let mut m: HashMap<String, i64> = HashMap::new()
        m.inc("x")
        m.inc("x")
        m.inc("x")
        testing::check_eq(&m.get_or("x", 0), &3, "inc x 3 times = 3")
    }

    #[test]
    fn or_insert_no_overwrite() {
        let mut m: HashMap<String, i64> = HashMap::new()
        m.or_insert("k", 42)
        m.or_insert("k", 99)
        testing::check_eq(&m.get_or("k", 0), &42, "or_insert keeps first value")
    }

    #[test]
    fn missing_key_returns_default() {
        let m: HashMap<String, i64> = HashMap::new()
        testing::check_eq(&m.get_or("missing", -1), &-1, "missing key → default")
    }

    #[test]
    fn word_count_stress() {
        let words = ["a", "b", "a", "c", "a", "b"]
        let mut counts: HashMap<String, i64> = HashMap::new()
        for w in words {
            counts.inc(w)
        }
        testing::check_eq(&counts.get_or("a", 0), &3, "a appears 3 times")
        testing::check_eq(&counts.get_or("b", 0), &2, "b appears 2 times")
        testing::check_eq(&counts.get_or("c", 0), &1, "c appears 1 time")
    }
}
