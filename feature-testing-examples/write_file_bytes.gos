// `fs::write(path, &Vec<u8>)` - the bytes-shaped variant
// chosen by the dispatcher when the contents argument types as
// `Vec<u8>` / `&[u8]`. The c-string-shaped helper would truncate
// at the first NUL byte and silently corrupt binary writes
// (image downloads, gzip bodies, etc.); routing through
// `gos_rt_os_write_file_bytes_result` preserves every byte.
//
// Reads the written bytes back via `fs::read` and checks
// the prefix to confirm the embedded NUL survived the round
// trip. Used by tier_parity to guarantee VM + cranelift + LLVM
// behaviour matches.

use std::errors
use std::env
use std::fs
use std::path

fn main() -> Result<(), errors::Error> {
    // Build a Vec<u8> containing an embedded NUL - the failure
    // mode is "saved file is 3 bytes" when the dispatcher picks
    // the c-string helper. NUL at index 5 truncates everything
    // after it; the length check below catches both shapes.
    let payload: [u8] = [72, 105, 33, 10, 0, 65, 66, 67, 10]
    let tmp = path::join(&env::temp_dir(), &"gos_write_bytes_probe.bin")
    fs::write(&tmp, &payload)?
    let bytes = fs::read(&tmp)?
    println!("wrote {} bytes", bytes.len())
    println!("byte[4] = {}", bytes[4])
    println!("byte[5] = {}", bytes[5])
    fs::remove_file(&tmp)?
    Ok(())
}
