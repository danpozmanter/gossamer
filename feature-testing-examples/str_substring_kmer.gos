// Tier-parity coverage for the byte-range `String.substring` primitive (the
// shared `gos_rt_str_substring` runtime shim the compiled tiers call). The
// length is read from the string's O(1) header instead of an O(len) strlen,
// so a sliding-window substring scan stays linear; output must be byte-
// identical across the VM, Cranelift, and LLVM tiers. Covers substring on a
// rodata literal and on a runtime-built (headered) string, out-of-range and
// inverted bounds (clamp / empty), and the k-mer + Map<String,i64>
// counting pattern (substring keys, owned-map inc / iter / get_or) that
// drives k-nucleotide.

use std::collections::Map

fn count_kmers(s: String, k: i64) -> Map<String, i64> {
    let mut m: Map<String, i64> = Map::new()
    let n = s.len() as i64
    if n < k { return m }
    for i in 0..(n - k + 1) {
        m.inc(s.substring(i, i + k), 1)
    }
    m
}

fn freq_line(s: String, k: i64) {
    let m = count_kmers(s, k)
    let mut e: Vec<(String, i64)> = m.iter().collect()
    e.sort_by(|a, b| if a.0 < b.0 { -1 } else if a.0 > b.0 { 1 } else { 0 })
    print("k{}:", k)
    for (kk, v) in e { print(" {}={}", kk, v) }
    println("")
}

fn main() {
    // Literal source: in-range, end-clamp, start-clamp, inverted, both-out.
    let s = "GGTACCGGTAGGTACC"
    println("[{}]", s.substring(0, 4))
    println("[{}]", s.substring(6, 10))
    println("[{}]", s.substring(12, 16))
    println("[{}]", s.substring(10, 100))
    let lo = 0 - 3
    println("[{}]", s.substring(lo, 4))
    println("[{}]", s.substring(8, 4))
    println("[{}]", s.substring(20, 25))

    // Runtime-built (headered) source - exercises the O(1)-length fast path.
    let built = "ACGT".repeat(8)
    println("built=[{}] len={}", built.substring(3, 11), built.len())

    // Sliding-window k-mer counting over an owned Map (substring keys).
    freq_line(s, 1)
    freq_line(s, 2)
    let m4 = count_kmers(s, 4)
    println("GGTA={} TACC={} ZZZZ={}", m4.get_or("GGTA", 0), m4.get_or("TACC", 0), m4.get_or("ZZZZ", 0))
}
