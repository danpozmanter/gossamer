// Cross-tier regression for Go-style middleware composition
// `http::middleware::tag(inner) -> Handler` (a `fn(inner: Handler) ->
// Handler` wrap-and-return chain). `tag` wraps a handler and prepends
// `mw:` to each response body. A double-wrap `tag(tag(App{}))` proves
// the chained path: the inner middleware's serve is itself
// `gos_rt_middleware_serve`, so the body picks up `mw:` twice.
//
// Compiled: each `tag(inner)` lowers to `gos_rt_middleware_new` binding
// the inner handler env + its serve fn-address (resolved via
// `gos_fn_addr`); `http::serve` serves the handle through
// `gos_rt_middleware_serve`. Interp: `tag` builds a `Middleware` value
// whose `Middleware::serve` native runs the inner serve + body
// transform. Bit-identical on the bytecode VM (`gos`) and LLVM AOT
// (`gos build`).
//
// Self-terminating: the client runs in main and exits explicitly, so
// the run is a plain stdout-parity comparison. Binds a fixed loopback
// port, serialized under SERVER_PORT_LOCK by
// `http_middleware_compose_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::http::middleware
use std::process
use std::time

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> http::Response {
        http::Response::text(200, "ok")
    }
}

fn serve_app() {
    let wrapped = middleware::tag(middleware::tag(App { }))
    if let Err(e) = http::serve("127.0.0.1:23913", wrapped) {
        eprintln!("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: &String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, []) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    go serve_app()
    let url = "http://127.0.0.1:23913/x"
    await_ready(&url)

    match http::get(&url, []) {
        Ok(r) => println!("status={} body={}", r.status, r.body),
        Err(e) => println!("error: {}", e),
    }

    process::exit(0)
}
