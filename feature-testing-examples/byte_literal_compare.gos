// Byte literals compare against an explicit byte view without casts.
fn main() {
    let s = "Hello, World>123"
    let bytes = s.as_bytes()
    let mut upper = 0
    let mut digits = 0
    let mut gt = 0
    for i in 0..bytes.len() {
        let b = bytes[i]
        if b >= b'A' && b <= b'Z' { upper += 1 }
        if b >= b'0' && b <= b'9' { digits += 1 }
        if b == b'>' { gt += 1 }
    }
    println("{} {} {}", upper, digits, gt)
}
