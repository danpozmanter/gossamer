// Regression lock for the scalar math surface (trig / log / pow /
// roots / rounding / hyperbolic / remainder). These were verified
// only by a one-time manual probe; this pins them across all tiers.

use std::math

fn main() {
    println!("sqrt={:.4}", math::sqrt(2.0))
    println!("cbrt={:.4}", math::cbrt(27.0))
    println!("pow={:.4}", math::pow(2.0, 10.0))
    println!("exp={:.4}", math::exp(1.0))
    println!("ln={:.4}", math::ln(math::exp(1.0)))
    println!("log2={:.4}", math::log2(8.0))
    println!("log10={:.4}", math::log10(1000.0))
    println!("sin={:.4}", math::sin(0.0))
    println!("cos={:.4}", math::cos(0.0))
    println!("tan={:.4}", math::tan(0.0))
    println!("sinh={:.4}", math::sinh(0.0))
    println!("cosh={:.4}", math::cosh(0.0))
    println!("tanh={:.4}", math::tanh(0.0))
    println!("floor={:.4}", math::floor(2.7))
    println!("ceil={:.4}", math::ceil(2.1))
    println!("round={:.4}", math::round(2.5))
    println!("abs={:.4}", math::abs(-3.5))
    println!("hypot={:.4}", math::hypot(3.0, 4.0))
    println!("copysign={:.4}", math::copysign(3.0, -1.0))
    println!("dim={:.4}", math::dim(5.0, 2.0))
    println!("fmod={:.4}", math::fmod(7.5, 2.0))
    println!("exp2={:.4}", math::exp2(3.0))
}
