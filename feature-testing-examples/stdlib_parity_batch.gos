// Cross-tier regression batch for stdlib functions that previously
// diverged or build-failed on the compiled tiers (parity_audit.md):
//   - encoding::ascii85::encode(String): compiled SIGSEGV (String was
//     missing from the byte-coercion whitelist).
//   - utf8::rune_len(<int codepoint>): VM returned 0 (only handled char).
//   - math::min / max / clamp qualified form: compiled BUILD-FAIL
//     (only the bare prelude names routed to the shim).
//   - encoding::json::valid: compiled BUILD-FAIL (no shim).
// All must now agree bit-for-bit on `gos` and `gos build`.

use std::encoding
use std::utf8
use std::math

fn main() {
    println("a85 {}", encoding::ascii85::encode("hello".as_bytes()))
    println("runelen {} {} {}", utf8::rune_len('A'), utf8::rune_len('é'), utf8::rune_len('日'))
    println("mm {} {} {}", math::min(3.0, 7.0), math::max(3.0, 7.0), math::clamp(15.0, 0.0, 10.0))
    println("mmf {} {}", math::min(2.5, 1.5), math::max(2.5, 1.5))
    println("jsonvalid {} {}", encoding::json::valid("{\"a\":1}"), encoding::json::valid("{bad"))
}
