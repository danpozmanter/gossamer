// Positional field copying from an existing struct across all three tiers.

struct Config {
    host: String,
    port: i64,
    verbose: bool,
    retries: i64,
}

fn default_config() -> Config {
    Config("localhost", 8080, false, 3)
}

fn main() {
    let base = default_config()
    let custom = Config(base.host, 9090, true, base.retries)
    println!("host = {}", custom.host)
    println!("port = {}", custom.port)
    println!("verbose = {}", custom.verbose)
    println!("retries = {}", custom.retries)
    let extra = Config("example.com", custom.port, custom.verbose, custom.retries)
    println!("host2 = {}", extra.host)
    println!("port2 = {}", extra.port)
    println!("verbose2 = {}", extra.verbose)
    println!("retries2 = {}", extra.retries)
}
