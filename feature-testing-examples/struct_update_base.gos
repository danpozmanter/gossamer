// Struct update syntax (`..base`) — exercises functional record
// update so all three tiers see the same values.

struct Config {
    host: String,
    port: i64,
    verbose: bool,
    retries: i64,
}

fn default_config() -> Config {
    Config {
        host: "localhost".to_string(),
        port: 8080,
        verbose: false,
        retries: 3,
    }
}

fn main() {
    let base = default_config()
    let custom = Config { port: 9090, verbose: true, ..base }
    println!("host = {}", custom.host)
    println!("port = {}", custom.port)
    println!("verbose = {}", custom.verbose)
    println!("retries = {}", custom.retries)
    let extra = Config { host: "example.com".to_string(), ..custom }
    println!("host2 = {}", extra.host)
    println!("port2 = {}", extra.port)
    println!("verbose2 = {}", extra.verbose)
    println!("retries2 = {}", extra.retries)
}
