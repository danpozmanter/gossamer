// Closed-channel select readiness.
//
// A `select` recv arm is READY when its channel is closed, yielding the
// element-type zero value (Go's `v, ok := <-ch` for a closed channel).
// An open-but-empty channel's recv arm stays not-ready, so the default
// arm fires. Every selection point here is decided synchronously - no
// goroutines, no sleeps - so stdout is bit-identical across the bytecode
// VM (`gos run` / `gos test`), the Cranelift JIT, and the LLVM AOT tier
// (`gos build`).

use std::sync::channel

fn main() {
    // 1. Open + empty channel: the recv arm is not ready, default fires.
    let (tx, rx) = channel()
    let open = select {
        v = rx.recv() => v,
        default => -1,
    }
    println!("open empty = {}", open)

    // 2. After close, the same channel's recv arm is ready with the
    //    zero value, chosen over the default.
    tx.close()
    let closed = select {
        v = rx.recv() => v,
        default => -1,
    }
    println!("closed = {}", closed)

    // 3. A closed channel still drains its buffered values in order,
    //    then yields the zero value once empty.
    let (tx2, rx2) = channel::unbounded()
    tx2.send(7)
    tx2.send(8)
    tx2.close()
    let first = select {
        v = rx2.recv() => v,
        default => -1,
    }
    let second = select {
        v = rx2.recv() => v,
        default => -1,
    }
    let third = select {
        v = rx2.recv() => v,
        default => -1,
    }
    println!("buffered first = {}", first)
    println!("buffered second = {}", second)
    println!("buffered third = {}", third)
}

#[cfg(test)]
mod select_closed_tests {
    use std::sync::channel
    use std::testing

    #[test]
    fn open_empty_recv_arm_falls_to_default() {
        let (_tx, rx) = channel()
        let chosen = select {
            v = rx.recv() => v,
            default => -1,
        }
        testing::check(chosen == -1, "open+empty recv arm is not ready")
    }

    #[test]
    fn closed_recv_arm_is_ready_with_zero() {
        let (tx, rx) = channel::unbounded()
        tx.close()
        let chosen = select {
            v = rx.recv() => v,
            default => -1,
        }
        testing::check(chosen == 0, "closed recv arm yields the zero value")
    }

    #[test]
    fn closed_channel_drains_before_zero() {
        let (tx, rx) = channel()
        tx.send(42)
        tx.close()
        let a = select {
            v = rx.recv() => v,
            default => -1,
        }
        let b = select {
            v = rx.recv() => v,
            default => -1,
        }
        testing::check_eq(&a, &42, "buffered value drains first")
        testing::check_eq(&b, &0, "zero value once drained")
    }
}
