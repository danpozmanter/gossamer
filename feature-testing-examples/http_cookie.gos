// Cross-tier parity for std::http::cookie - RFC 6265 cookie header
// parsing and bare name=value serialization. These were previously
// interp-tier only (rich Rust impl, no compiled-tier shim). Each call
// now routes through a gos_rt_http_cookie_* shim so the output matches
// `gos` bit-identically on Cranelift and LLVM.
//
// parse_cookie_header is lenient: malformed pairs are skipped, quoted
// values are unquoted, order is preserved. serialize renders a bare
// name=value with RFC 6265 sanitization (special-char values quoted).

use std::http

fn main() {
    let pairs = http::cookie::parse_cookie_header("sid=abc123; theme=dark; lang=\"en US\"; ; =skip; ok=1")
    for (name, value) in pairs {
        println("{} = {}", name, value)
    }
    println("serialize: {}", http::cookie::serialize("session", "tok42"))
    println("serialize-special: {}", http::cookie::serialize("k", "a b,c"))
}
