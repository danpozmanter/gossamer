// A String carries two index spaces. `len`, `[]`, and bare iteration count
// Unicode scalars, so `s[i]` is the `char` at character index `i`.
// `byte_len`, `substring`, `byte_at`, and `as_bytes` take byte offsets, and
// `byte_at` yields the byte as an `i64` that compares against byte literals.
// `byte_at(i)` is the allocation-free reader for a `substring(i, i + 1)` scan
// because both address the same byte offset.
fn count_digit_chars(s: &String) -> i64 {
    let mut n = 0
    let mut i = 0
    while i < s.len() {
        if s[i] >= '0' && s[i] <= '9' { n += 1 }
        i += 1
    }
    n
}

fn digit_sum_bytes(s: &String) -> i64 {
    let mut total = 0
    let mut i = 0
    while i < s.byte_len() {
        if s.byte_at(i) >= b'0' && s.byte_at(i) <= b'9' {
            total += s.byte_at(i) - b'0'
        }
        i += 1
    }
    total
}

fn main() {
    let s = "aé9b7"
    println!("{} {}", s.len(), s.byte_len())
    println!("{} {} {}", s[0], s[1], s[2])
    println!("{} {}", s[2] as i64, s.substring(1, 3))
    println!("{} {} {}", s.byte_at(1), s.byte_at(2), s.byte_at(99))
    println!("{} {}", s.byte_at(3) as char, s.as_bytes()[3] == b'9')
    println!("{} {}", count_digit_chars(&s), digit_sum_bytes(&s))
}
