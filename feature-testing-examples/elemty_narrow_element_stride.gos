// A combinator's output vec declares the width its element type really has.
// `bool` and `u8` occupy one byte per slot, so an element-preserving adapter
// keeps the source's stride and a `map` declares the mapped element's own.
// Indexing, iteration, and rendering all read at that width.

fn is_odd(n: i64) -> bool { n % 2 == 1 }

fn main() {
    let ns: Vec<i64> = #[0, 1, 2, 3, 4]
    let flags: Vec<bool> = ns.map(is_odd).collect()
    println!("flags {}", flags)
    println!("flags-len {}", flags.len())
    for i in 0..flags.len() { println!("flag {} {}", i, flags[i] as i64) }
    let kept: Vec<bool> = flags.filter(|f| f).collect()
    println!("kept {} {}", kept.len(), kept)

    let bytes: Vec<u8> = #[1u8, 2u8, 3u8, 4u8]
    println!("bytes {}", bytes)
    let doubled: Vec<u8> = bytes.map(|b: u8| -> u8 { b * 2 }).collect()
    println!("doubled {} {}", doubled.len(), doubled)
    for i in 0..doubled.len() { println!("byte {} {}", i, doubled[i] as i64) }
    let big: Vec<u8> = bytes.filter(|b| b > 2u8).collect()
    println!("big {} {} {}", big.len(), big, big[0] as i64)
    let widened: Vec<i64> = bytes.map(|b: u8| -> i64 { (b as i64) * 10 }).collect()
    println!("widened {}", widened)
    let narrowed: Vec<u8> = ns.map(|n: i64| -> u8 { (n + 1) as u8 }).collect()
    println!("narrowed {} {}", narrowed.len(), narrowed)
    println!("rev {}", doubled.rev())
    println!("take {}", doubled.take(2))
    println!("skip {}", doubled.skip(2))
}
