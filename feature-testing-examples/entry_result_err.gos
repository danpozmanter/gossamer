use std::errors

// An explicit `fn main() -> Result<..>` that returns `Err` must, on every
// tier, print the error's Display (colon-joined cause chain) to stderr and
// exit nonzero - never silently succeed. Regression guard for the entry-point
// Err drop + the gos-run-vs-gos-build exit-code divergence.
fn main() -> Result<(), errors::Error> {
    println!("before err")
    Err(errors::wrap(errors::new("root"), "boom"))
}
