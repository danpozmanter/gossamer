// A tagged-pointer enum handed to a closure at a direct call site. The
// closure body receives the handle word, the same shape the runtime
// combinator shims pass, so a recursive enum keeps its identity instead of
// arriving as the address of the caller's slot. Bit-identical on the VM,
// Cranelift, and LLVM tiers.

enum Expr {
    Lit(i64)
    Add(Expr, Expr)
}

fn eval(e: Expr) -> i64 {
    match e {
        Lit(n) => *n
        Add(a, b) => eval(a) + eval(b)
    }
}

enum Colour {
    Red
    Green
    Blue
}

fn code(c: Colour) -> i64 {
    match c {
        Red => 1
        Green => 2
        Blue => 3
    }
}

fn main() {
    let e = Add(Lit(2), Add(Lit(3), Lit(4)))
    println("{}", e |> |x| eval(x))

    let by_ref = |x: Expr| eval(x)
    println("{}", by_ref(e))

    let doubled = |x: Expr| eval(x) * 2
    println("{}", doubled(e))

    // A payload-free enum lowers to a bare discriminant word.
    let c = Green
    println("{}", c |> |x| code(x))
}
