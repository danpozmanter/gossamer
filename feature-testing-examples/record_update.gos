// Positional construction copies selected fields from an existing value and
// supplies the changed field explicitly in declaration order.
//
// Fields filled from `base` share its heap children (strings, vecs, nested
// nodes); the base keeps its own share and reclaims it at its drop, so the
// new struct retains its copy. Output must be bit-identical across the VM,
// Cranelift, and LLVM tiers and free of double-frees.

struct User { name: String, role: String, age: i64 }
struct Bag { tags: Vec<String>, label: String, n: i64 }
struct Team { lead: User, members: Vec<String>, size: i64 }

fn main() {
    let base = User { name: format!("ada"), role: format!("admin"), age: 30 }

    // Override one scalar field. `base` is read again after,
    // so its strings must still be live.
    let older = User { name: base.name, role: base.role, age: 31 }
    println!("{} {} {}", older.name, older.role, older.age)

    // Override a String field with a fresh value.
    let renamed = User { name: format!("ada2"), role: base.role, age: base.age }
    println!("{} {} {}", renamed.name, renamed.role, renamed.age)

    println!("base intact: {} {} {}", base.name, base.role, base.age)

    // A Vec<String> field rides through the spread untouched while a scalar
    // is overridden; the base's vec and strings stay live for it.
    let mut tags: Vec<String> = Vec::from(#[])
    tags.push(format!("x"))
    tags.push(format!("y"))
    let bag = Bag { tags: tags, label: format!("first"), n: 1 }
    let bag2 = Bag { tags: bag.tags, label: bag.label, n: 2 }
    println!("{} {} {} {}", bag2.tags[0], bag2.tags[1], bag2.label, bag2.n)
    println!("bag intact: {} {}", bag.tags[0], bag.label)

    // A struct with a String field stored as another struct's field: the
    // nested heap children are shared into the new aggregate's slot and must
    // be retained there, so the source and the new owner each free once.
    let lead = User { name: format!("lin"), role: format!("eng"), age: 40 }
    let mut roster: Vec<String> = Vec::from(#[])
    roster.push(format!("ben"))
    roster.push(format!("cleo"))
    let team = Team { lead: lead, members: roster, size: 3 }
    let grown = Team { lead: team.lead, members: team.members, size: 4 }
    println!("{} {} {} {}", grown.lead.name, grown.members[0], grown.members[1], grown.size)
    println!("lead intact: {} {}", lead.name, lead.role)
}
