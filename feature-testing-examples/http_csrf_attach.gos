// Cross-tier parity for the request/response-integrated CSRF surface:
// `csrf::config`, `csrf::attach_cookie`, `csrf::extract_token`,
// `csrf::check`, and the `csrf::RouteAuth` policy enum. The double-
// submit round-trip is exercised entirely in-process (no server bind):
// a Response carries the issued cookie, a client-built Request echoes
// it in the cookie + header, and `check` gates the unsafe POST.
//
// `issue_token` draws a random nonce, so the token string is not
// deterministic - the fixture asserts the round-trip OUTCOMES (the
// attach cookie name prefix, the extract match, the check verdicts),
// which are bit-identical across the bytecode VM, Cranelift, and LLVM.

use std::http

fn header_of(headers: &[(String, String)], want: String) -> String {
    let mut found = ""
    for (name, value) in headers {
        if name.to_lowercase() == want { found = value }
    }
    found
}

fn main() {
    let key: [u8] = [1, 2, 3, 4, 5, 6, 7, 8]
    let mut cfg = http::csrf::config(key)
    cfg.trusted_origins = ["https://app.example.com"]

    let token = match http::csrf::issue_token(cfg.key) {
        Ok(t) => t,
        Err(_) => {
            println!("issue: err")
            return
        }
    }

    // Attach the CSRF cookie to a response, then read the Set-Cookie back.
    let resp = http::Response::text(200, "ok")
    let resp = http::csrf::attach_cookie(resp, &token, &cfg)
    let set_cookie = header_of(&resp.headers, "set-cookie")
    println!("attach_prefix={}", set_cookie.starts_with("gos_csrf="))
    println!("attach_attrs={}", set_cookie.contains("SameSite=Lax"))

    // A client-built request echoes the token in the cookie + header.
    let req = http::Client::new().post("http://app.example.com/do")
        .header("origin", "https://app.example.com")
        .header("cookie", "gos_csrf=" + &token)
        .header("X-CSRF-Token", &token)

    let supplied = match http::csrf::extract_token(req, &cfg) {
        Some(t) => t,
        None => "",
    }
    println!("extract_match={}", supplied == token)

    match http::csrf::check(req, http::csrf::RouteAuth::CookieSession, &cfg) {
        Ok(_) => println!("check_valid=ok"),
        Err(_) => println!("check_valid=err"),
    }

    // Bearer-only routes bypass the check entirely.
    match http::csrf::check(req, http::csrf::RouteAuth::BearerOnly, &cfg) {
        Ok(_) => println!("check_bearer=ok"),
        Err(_) => println!("check_bearer=err"),
    }

    // A request from an untrusted origin is rejected.
    let evil = http::Client::new().post("http://evil/")
        .header("origin", "https://evil.example.org")
        .header("cookie", "gos_csrf=" + &token)
        .header("X-CSRF-Token", &token)
    match http::csrf::check(evil, http::csrf::RouteAuth::CookieSession, &cfg) {
        Ok(_) => println!("check_evil=ok"),
        Err(_) => println!("check_evil=err"),
    }
}
